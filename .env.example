APP_ENV=development
APP_URL=http://localhost:4321
#
# APP_URL is REQUIRED and is not cosmetic: it builds the OIDC/SSO callback URL
# (src/lib/auth/sso-config.ts). A wrong host breaks login with
# redirect_uri_mismatch rather than merely producing an ugly link. Register that
# one redirect URI with the IdP before anyone signs in.
#
# There is exactly ONE deployed environment (ADR-0083,
# docs/awcms/environments.md):
#   production  APP_ENV=production  APP_URL=https://awcms.ahlikoding.com
#
# `staging` IS GONE — removed from the profile vocabulary itself, not merely
# unused here. ADR-0083 originally kept it as a template capability; the repo
# owner overrode that and the ADR was amended, on the reasoning that a
# deployment profile nobody ever exercises is a claim rather than a capability.
# Surviving deployment profiles: development / production / offline-lan
# (`test` remains an accepted APP_ENV value for automated test runs, which is
# not a deployment). Copying this file and setting `APP_ENV=staging` names an
# environment that no longer exists anywhere in this repo.
LOG_LEVEL=info
AUDIT_LOG_RETENTION_DAYS=730

# ---------------------------------------------------------------------------
# HTTP listener (Issue #464)
# ---------------------------------------------------------------------------
#
# Read by `src/lib/server/standalone-entry.ts`, the entrypoint production runs
# (`bun ./dist/standalone-entry.mjs`). These four have always steered the
# server; until #464 they were read inside `@astrojs/node` where no gate could
# see them, so `config:env:coverage:check` had nothing to report and they went
# undocumented. They are listed here now because the wrapper reads them in this
# repo's own source.
#
# Defaults below match the adapter's, so leaving all four unset changes nothing.
# PORT=4321
# HOST=localhost           # 0.0.0.0 to listen on every interface
#
# In-process TLS. BOTH must be set, or neither — one alone is ignored and the
# server listens over plain HTTP. Most deployments terminate TLS at a reverse
# proxy instead and leave these unset.
# SERVER_CERT_PATH=/etc/ssl/certs/awcms.crt
# SERVER_KEY_PATH=/etc/ssl/private/awcms.key

# Koneksi runtime aplikasi. Di produksi arahkan ke role `awcms_app` yang dibuat
# `sql/019_awcms_db_role_separation.sql` — role itu BUKAN superuser, BUKAN
# BYPASSRLS, dan BUKAN pemilik tabel, sehingga RLS benar-benar berlaku sebagai
# lapisan kedua isolasi tenant (lihat doc 18 §Model role database). Migration
# 019 membuatnya NOLOGIN tanpa password (password itu secret, tidak boleh ada
# di repo); operator mengaktifkannya sekali:
#   ALTER ROLE awcms_app LOGIN PASSWORD '<secret>';
# `bun run db:migrate` membaca DATABASE_URL yang SAMA, jadi jalankan migrasi
# dengan var ini ditimpa ke connection string owner/superuser — bukan awcms_app
# (awcms_app sengaja tidak bisa CREATE/ALTER/DROP apa pun). Grant awcms_app pada
# tabel global tanpa RLS sudah dipersempit oleh
# `sql/021_awcms_db_role_grants_narrow.sql` (Issue #160): read-only di
# awcms_permissions/awcms_schema_migrations, tanpa DELETE di
# awcms_tenants/awcms_setup_state — lihat doc 18 §Model role database.
#
# BARIS DI BAWAH ADALAH ROLE OWNER, DAN ITU BUKAN YANG SEHARUSNYA DIPAKAI
# RUNTIME — bahkan di lokal. Di image Postgres resmi `POSTGRES_USER` adalah
# SUPERUSER, dan superuser menembus RLS meski tabelnya `FORCE`. Dev yang
# terhubung sebagai role ini tidak akan pernah mereproduksi bug kebocoran
# tenant: query yang bocor di produksi tampak benar di laptop. Arahkan ke
# `awcms_app` seperti produksi, dan pakai role owner ini HANYA untuk
# `db:migrate`. Langkah lengkapnya: `docs/awcms/environments.md`
# §Development lokal disamakan dengan produksi.
DATABASE_URL=postgres://awcms:awcms_password@localhost:5432/awcms
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_PGBOUNCER=false
# Koneksi + pool TERPISAH untuk background job dan wizard setup, DAN opsi
# opt-in role least-privilege sungguhan. `sql/022_awcms_db_worker_setup_roles.sql`
# (Issue #163) membuat role `awcms_worker` (tujuh cron worker) dan `awcms_setup`
# (bootstrap `POST /api/v1/setup/initialize`), masing-masing hanya dengan GRANT
# per-jalur-tulis yang benar-benar dipakai kodenya — nol akses ke katalog global
# yang tidak disentuhnya (permissions/schema_migrations/setup_state/module
# registry). Keduanya NOLOGIN tanpa password; aktifkan sekali sama seperti
# awcms_app:
#   ALTER ROLE awcms_worker LOGIN PASSWORD '<secret>';
#   ALTER ROLE awcms_setup  LOGIN PASSWORD '<secret>';
# lalu arahkan var di bawah ke role itu. OPT-IN, BUKAN breaking: biarkan kosong
# -> keduanya fallback ke DATABASE_URL (koneksi `awcms_app`) — default yang
# didukung dan diuji, deployment yang mengelola satu connection string tetap
# jalan tanpa perubahan. Manfaat mengisinya: isolasi pool (job lambat tidak
# menghabiskan koneksi yang melayani HTTP, lihat DATABASE_POOL_MAX_*) PLUS
# isolasi role least-privilege nyata. Lihat doc 18 §Model role database.
WORKER_DATABASE_URL=
SETUP_DATABASE_URL=

AUTH_SESSION_TTL_MIN=120
AUTH_COOKIE_SECURE=true
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_MAX=20
AUTH_LOGIN_RATE_LIMIT_WINDOW_SEC=60
# Plafon per-SUMBER untuk SELURUH permukaan auth publik (login, register, MFA,
# lupa/reset password), dijumlahkan lintas tenant. Kuncinya hanya `clientIp`,
# jadi ia satu-satunya plafon yang tak bisa dilewati dengan mengganti header
# `x-awcms-tenant-id` (#447). Wajib >= AUTH_LOGIN_RATE_LIMIT_MAX — di bawah itu
# `config:validate` menolak, karena plafon ini akan mengikat lebih dulu bahkan
# pada deployment satu tenant. Pada satu tenant ia memang tak pernah tercapai.
AUTH_SOURCE_RATE_LIMIT_MAX=60
AUTH_SOURCE_RATE_LIMIT_WINDOW_SEC=60
# Percaya X-Forwarded-For sebagai sumber IP rate limit HANYA bila app berada di
# belakang proxy tepercaya. Menyetel true pada app yang terekspos langsung
# membuat rate limit login bisa dilucuti: penyerang cukup merotasi header itu
# agar tiap request masuk bucket baru.
TRUSTED_PROXY_ENABLED=false
# Berapa hop tepercaya yang ADA DI DEPAN proses ini. Entri klien dihitung dari
# KANAN sejauh angka ini — entri di kirinya bisa ditulis penyerang, jadi tak
# pernah dibaca (#438). 1 = satu proxy (nginx/Caddy/Cloudflare); naikkan hanya
# kalau Anda benar-benar punya rantai proxy sendiri sepanjang itu. Menaikkannya
# melebihi rantai nyata melebarkan yang bisa dipalsukan.
#
# SENGAJA DIKOMENTARI. `config:validate` MENOLAK variabel ini bila
# `TRUSTED_PROXY_ENABLED` bukan `true` — menyetelnya sambil header tak dipercaya
# adalah operator yang mengira sudah menyetel sesuatu. Karena template ini
# mengirim `TRUSTED_PROXY_ENABLED=false`, mengirimnya ter-set membuat template
# ini gagal validatornya sendiri. Aktifkan BERSAMA `TRUSTED_PROXY_ENABLED=true`,
# bukan sendirian. Default kodenya tetap 1 saat tak di-set.
# TRUSTED_PROXY_HOP_COUNT=1
# Meng-key HMAC `ipHash` pada audit login. Kosong/placeholder -> kunci acak per
# proses: hash tetap non-reversible, tapi tidak sebanding antar restart/instance
# sehingga korelasi insiden lintas waktu hilang. Set nilai tetap di produksi.
AUTH_IP_HASH_SECRET=change-me

# MFA TOTP (Issue #184). AUTH_MFA_ENABLED gates the enrollment surface only —
# an existing factor is always honored at login/step-up regardless. When
# enabled, AUTH_MFA_SECRET_ENCRYPTION_KEY is REQUIRED and must be 32 bytes
# base64 (`openssl rand -base64 32`). There is NO default key: a database
# backup alone must never yield a usable TOTP secret.
AUTH_MFA_ENABLED=false
AUTH_MFA_SECRET_ENCRYPTION_KEY=
AUTH_MFA_TOTP_ISSUER=AWCMS
AUTH_MFA_TOTP_PERIOD_SEC=30
AUTH_MFA_TOTP_DIGITS=6
AUTH_MFA_TOTP_WINDOW_STEPS=1
AUTH_MFA_CHALLENGE_TTL_SEC=300
# Step-up freshness for high-risk actions — short and server-controlled.
AUTH_MFA_STEPUP_TTL_SEC=300
# Per-factor cumulative failed-verify lockout (independent of source IP and
# challenge rotation): lock a factor after N failed verifies for M minutes.
AUTH_MFA_MAX_VERIFY_ATTEMPTS=5
AUTH_MFA_LOCKOUT_MINUTES=15
AUTH_MFA_RATE_LIMIT_MAX=5
AUTH_MFA_RATE_LIMIT_WINDOW_SEC=300

# Business-scope hierarchy resolver guard (Issue #180). Base-side fail-closed
# bounds on the UNTRUSTED derived-app hierarchy adapter (defaults are safe;
# override only to tune). Timeout: an adapter that does not resolve within this
# wall-clock budget (ms) is treated as unresolved (deny). Max related scopes:
# if an adapter returns more than this many ancestor+descendant entries
# combined, the scope is treated as unresolved (deny). See ADR-0030.
AUTH_BUSINESS_SCOPE_HIERARCHY_TIMEOUT_MS=500
AUTH_BUSINESS_SCOPE_HIERARCHY_MAX_RELATED_SCOPES=5000

# OIDC/SSO tenant-aware federated login (Issue #185). AUTH_SSO_ENABLED gates the
# login/callback/link/unlink flow (admin provider/policy CRUD is always
# reachable so a provider can be provisioned ahead of the flip). When enabled,
# AUTH_SSO_CREDENTIAL_ENCRYPTION_KEY is REQUIRED and must be 32 bytes base64
# (`openssl rand -base64 32`) — a SEPARATE key from MFA's. There is NO default
# key: a database backup alone must never yield a usable client secret. Provider
# issuer/client id/secret/scopes/allowed domains are tenant-configured DATA, not
# env vars.
AUTH_SSO_ENABLED=false
AUTH_SSO_CREDENTIAL_ENCRYPTION_KEY=
# Bounded timeout + response-size cap for discovery/JWKS/token fetches (the SSRF
# guard enforces both), and the per-tenant provider cap.
AUTH_SSO_DISCOVERY_TIMEOUT_MS=5000
AUTH_SSO_MAX_RESPONSE_BYTES=262144
AUTH_SSO_MAX_PROVIDERS_PER_TENANT=20
AUTH_SSO_OAUTH_REQUEST_TTL_SEC=600
# SSRF escape hatch — comma-separated host[:port] entries allowed to use http/
# loopback. ONLY for a local fake IdP in tests; MUST be empty in production
# (config:validate rejects a non-empty value when APP_ENV=production).
AUTH_SSO_ALLOW_INSECURE_HOSTS=

# Password recovery (Wave 2 delta auth). Ships ON with these defaults — a
# recovery path that has to be switched on is one that is off when it is needed.
# The link is emailed through the `email` module's `auth.password_reset`
# template, so a tenant that never ran `bun run email:templates:seed-defaults`
# has a flow that reaches nobody (logged as a warning, invisible in the
# response). Token TTL is in minutes; the rate limit is per client IP + tenant
# and applies to BOTH /forgot and /reset.
AUTH_PASSWORD_RESET_TOKEN_TTL_MIN=30
AUTH_PASSWORD_RESET_RATE_LIMIT_MAX=5
AUTH_PASSWORD_RESET_RATE_LIMIT_WINDOW_SEC=900
# Public self-registration (Wave 2 delta auth). OFF by default — an always-on
# public endpoint that writes a row is a spam surface every deployment would
# otherwise inherit. When off, POST /api/v1/auth/register answers 404 (the same
# answer a nonexistent route gives, so the switch is not discoverable) and
# /register renders a neutral "not available" card.
#
# DEPLOYMENT-level, like AUTH_MFA_ENABLED/AUTH_SSO_ENABLED: turning it on opens
# registration for EVERY tenant in this deployment. Per-tenant granularity is a
# recorded follow-up (identity-access/README.md), not something this switch
# pretends to offer. Approval never sets a password — it creates the account
# with an unusable credential and emails a reset link, so the applicant proves
# mailbox control before they can sign in.
AUTH_SELF_REGISTRATION_ENABLED=false
AUTH_SELF_REGISTRATION_RATE_LIMIT_MAX=5
AUTH_SELF_REGISTRATION_RATE_LIMIT_WINDOW_SEC=900
# Invitations (ADR-0082). Deliberately WITHOUT a feature switch, unlike
# self-registration above: an invitation can only be issued by someone already
# holding `identity_access.invitations.create`, so there is no public surface
# for a deployment-level switch to protect. Adding one would be a new decision,
# not a copy of that one.
# TTL is in HOURS, not minutes — nobody is standing at the screen waiting for an
# invitation the way they wait for a password reset, and a link that dies over a
# weekend produces a resend rather than a signup. Resend rotates the token, so
# the TTL restarts from the resend; the database caps resends at 5 per row.
# The link is emailed through the `email` module's `auth.invitation` template, so
# a tenant that never ran `bun run email:templates:seed-defaults` gets
# `delivery: "unavailable"` on the API response rather than silence.
# These three are read through `resolveInvitationConfig(env)`, which threads
# `env` as a parameter — `config:env:coverage:check` matches `process.env.X`
# only and therefore CANNOT see them (its own header records that limit). They
# are listed here by hand for that reason.
AUTH_INVITATION_TOKEN_TTL_HOURS=168
AUTH_INVITATION_RATE_LIMIT_MAX=5
AUTH_INVITATION_RATE_LIMIT_WINDOW_SEC=900

# OPTIONAL hardening for token-bearing links. Unset (the default), the emailed
# link is `/reset-password?token=…&tenantId=…`. Set to 32 bytes base64
# (`openssl rand -base64 32`, a SEPARATE key from MFA's and SSO's), both params
# are sealed into one opaque, tamper-evident `?p=` value instead. The token is
# already a 256-bit CSPRNG value either way, so an unset or invalid key degrades
# to plain params rather than breaking the flow.
AUTH_URL_PARAM_ENCRYPTION_KEY=

# Full-online deployment-profile gate + Cloudflare Turnstile (Issue #186).
# LAN/offline (the default below) runs with NO widget, NO CSP origin, and NO
# outbound Turnstile call — leave every var here as shipped.
#
# AUTH_ONLINE_SECURITY_* is the deployment profile. Turnstile activates at
# runtime ONLY when AUTH_ONLINE_SECURITY_ENABLED=true AND
# AUTH_ONLINE_SECURITY_PROFILE=full_online AND TURNSTILE_ENABLED=true. Setting
# the gate on with any other profile value is a MISCONFIGURATION
# (config:validate/security:readiness flag it), distinct from "disabled".
AUTH_ONLINE_SECURITY_ENABLED=false
AUTH_ONLINE_SECURITY_PROFILE=disabled
# When TURNSTILE_ENABLED=true, ALL THREE below are REQUIRED (fail-closed):
#  - TURNSTILE_SITE_KEY: public, embedded in the widget HTML (NOT a secret).
#  - TURNSTILE_SECRET_KEY: server-side siteverify only, NEVER sent to the client,
#    NEVER logged/audited. Rotate via the Cloudflare dashboard (see docs).
#  - TURNSTILE_EXPECTED_HOSTNAME: the public hostname the widget is served from;
#    a token solved on any other hostname is rejected (hostname-confusion guard).
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
# Bounded siteverify timeout, challenge-timestamp freshness window, and the
# response-size cap the verifier enforces (all optional; safe defaults shown).
TURNSTILE_VERIFY_TIMEOUT_MS=5000
TURNSTILE_MAX_TOKEN_AGE_SEC=300
TURNSTILE_MAX_RESPONSE_BYTES=16384
# Source-scoped rate limit for POST /setup/initialize (Issue #186) — the public
# bootstrap endpoint has no tenant to key on, so it is bounded per source. Loose
# by design (setup is once-only); bounds outbound siteverify round-trips.
SETUP_RATE_LIMIT_MAX=10
SETUP_RATE_LIMIT_WINDOW_SEC=60

AWCMS_SYNC_ENABLED=false
AWCMS_SYNC_HMAC_SECRET=change-me
AWCMS_SYNC_MAX_SKEW_SEC=300
# Terima signature sync legacy v1 (`<timestamp>.<body>`, TIDAK mengikat tenant/node).
# Default true selama transisi agar node lama tetap jalan. v1 masih rentan
# forgery lintas-tenant (GHSA-c972); setel `false` setelah SEMUA node kirim v2
# (`X-AWCMS-Signature-Version: 2`) untuk menutup celah sepenuhnya.
SYNC_HMAC_ALLOW_LEGACY=true

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
R2_ENABLED=false
# Required as a set when R2_ENABLED=true — the object-storage uploader reads
# all four and refuses to upload if any is missing. Placeholders only; a real
# secret must never be committed.
# R2_ACCOUNT_ID=replace-me
# R2_BUCKET=replace-me
# R2_ACCESS_KEY_ID=replace-me
# R2_SECRET_ACCESS_KEY=replace-me
#
# Per-object upload timeout for `bun run sync:objects:dispatch` (default 10000).
# OBJECT_SYNC_UPLOAD_TIMEOUT_MS=10000

EMAIL_ENABLED=false
# EMAIL_PROVIDER: "mailketing" (real adapter) or "log" (safe local/dev, no network).
# EMAIL_PROVIDER=log
# EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=AWCMS
EMAIL_SEND_TIMEOUT_MS=10000
EMAIL_SEND_MAX_RETRIES=5
# Mailketing adapter (placeholders only — never commit real credentials):
# EMAIL_MAILKETING_ACCOUNT_ID=operator-label
# EMAIL_MAILKETING_API_TOKEN=replace-me
# EMAIL_MAILKETING_API_BASE_URL=https://api.mailketing.co.id

# ── Visitor Analytics (ported from awcms-micro epic #617-#624) ──────────────
# Privacy-first human visitor statistics. OFF by default: a fresh install
# collects nothing until VISITOR_ANALYTICS_ENABLED=true (a technical switch,
# never itself the lawful-basis/consent decision required by UU PDP).
VISITOR_ANALYTICS_ENABLED=false
# When enabled, a REAL salt is REQUIRED (validate-env enforces it, min 16 chars):
# visitor identifiers (visitor-key cookie, IP, user-agent) are stored only as
# per-tenant salted HMAC-SHA256, never raw. Generate e.g. `openssl rand -base64 32`.
# VISITOR_ANALYTICS_HASH_SALT=replace-me
# aggregate-only "basic" (default) vs richer "detailed"
VISITOR_ANALYTICS_MODE=basic
VISITOR_ANALYTICS_COLLECT_ADMIN=true
VISITOR_ANALYTICS_COLLECT_PUBLIC=true
VISITOR_ANALYTICS_COLLECT_API=false
VISITOR_ANALYTICS_DETAILED_ENABLED=false
# Raw IP / raw user-agent collection are each an explicit, independent opt-in
# (default off — privacy-first; the hashes above are used instead).
VISITOR_ANALYTICS_RAW_IP_ENABLED=false
VISITOR_ANALYTICS_RAW_USER_AGENT_ENABLED=false
# Country-only geo enrichment from Cloudflare's CF-IPCountry header — needs
# BOTH of the next two true, and never makes an external network call.
VISITOR_ANALYTICS_GEO_ENABLED=false
VISITOR_ANALYTICS_TRUST_PROXY=false
VISITOR_ANALYTICS_TRUST_CLOUDFLARE=false
VISITOR_ANALYTICS_ONLINE_WINDOW_SECONDS=300
VISITOR_ANALYTICS_EVENT_RETENTION_DAYS=90
VISITOR_ANALYTICS_RAW_DETAIL_RETENTION_DAYS=30
VISITOR_ANALYTICS_ROLLUP_RETENTION_DAYS=730
VISITOR_ANALYTICS_VISITOR_KEY_COOKIE_TTL_DAYS=30
# Per-IP rate-limit backstop on the PUBLIC ingest beacon
# (POST /api/v1/analytics/collect). Defaults 120 req / 60 s per client IP when
# unset. Keyed on IP only (never the tenant), so it leaks no tenant existence.
# VISITOR_ANALYTICS_COLLECT_RATE_LIMIT_MAX=120
# VISITOR_ANALYTICS_COLLECT_RATE_LIMIT_WINDOW_SEC=60

# ---------------------------------------------------------------------------
# Push delivery (ADR-0074, epic #463)
# ---------------------------------------------------------------------------
#
# OFF by default, and off means OFF: `bun run push:dispatch` claims nothing at
# all rather than claiming rows and failing to send them, so a deployment that
# never enables push can schedule the job forever without accumulating a single
# stranded row.
#
# Credentials for the real transports are per-DEPLOYMENT, never per-tenant —
# both FCM and VAPID authenticate the SERVER, not the customer. There is no
# per-tenant override and there is not meant to be one.
# PUSH_ENABLED=false
#
# Adapter:
#   log       — writes a structured line and always succeeds (local dev/tests).
#   fcm       — FCM HTTP v1, server -> Google, for NATIVE Android/iOS clients.
#   web_push  — VAPID (RFC 8030/8291/8292) for BROWSERS.
# PUSH_PROVIDER=log
#
# --- web_push (VAPID) ---
#
# Chosen over the FCM Web SDK by ADR-0074, and the reason is measurable: the SDK
# is 45,041 B against a 21,000 B per-file ceiling AND needs three third-party
# origins in a CSP that has none. `PushManager.subscribe()` is a browser API,
# not a fetch from page script, so this path costs ZERO client bytes and ZERO
# CSP origins.
#
# Generate one key pair per DEPLOYMENT and keep it: rotating it invalidates
# every existing browser subscription, because the public key is baked into each
# subscription at `subscribe()` time.
#
#   bun run push:vapid:generate
#
# PUSH_VAPID_PUBLIC_KEY=      # base64url, 65 bytes — NOT a secret; the browser receives it
# PUSH_VAPID_PRIVATE_KEY=     # base64url, 32 bytes — secret
#
# RFC 8292 §2.1 contact: how a push service reaches you about your own traffic
# BEFORE blocking it. `mailto:` or an https URL.
# PUSH_VAPID_SUBJECT=mailto:ops@example.com
#
# Google service-account credential for PUSH_PROVIDER=fcm, as BASE64 of the
# whole JSON file:
#
#   base64 -w0 service-account.json
#
# Base64 and not the raw JSON, because `config:validate` parses `.env` line by
# line and the credential's `private_key` is a multi-line PEM block — pasted
# raw, it is silently truncated at the first newline and the failure surfaces at
# the first send instead of at boot.
#
# Per-DEPLOYMENT, never per-tenant: the credential authenticates this SERVER to
# one Firebase project. There is no per-tenant override and there is not meant
# to be one.
# PUSH_FCM_CREDENTIALS_BASE64=
#
# Retry ceiling. `0` is a legitimate value meaning "never retry" and is honoured
# as such; an EMPTY value is treated as unset, not as zero.
# PUSH_SEND_MAX_RETRIES=3
#
# TOTAL wall-clock budget for one outbound call, including reading the body. A
# send can spend it twice in one attempt (mint an access token, then call FCM):
# two hops that can each hang independently.
# PUSH_SEND_TIMEOUT_MS=10000

# --- Data lifecycle (ADR-0037) ---
# Filesystem root for the offline/local archive adapter (JSONL/CSV + SHA-256)
# used by `bun run data-lifecycle:archive-purge`. Has a safe default when unset,
# so no configuration is required to run.
# DATA_LIFECYCLE_ARCHIVE_ROOT_PATH=./var/data-lifecycle-archive

# --- Public tenant resolution for host-based public routes (tenant_domain #219 /
#     seo_distribution ADR-0038) ---
# The public discovery routes (/robots.txt, /sitemap.xml, /sitemap-{n}.xml,
# /feed.xml, /atom.xml, /feed.json) and any other host-resolved public route
# resolve the tenant via src/lib/tenant/public-host-tenant-resolver.ts. Unset =
# today's offline/LAN default (no host lookup; env/setup fallback only).
#
# PUBLIC_TENANT_RESOLUTION_MODE: "host_default" enables the Host/domain -> tenant
# lookup against awcms_tenant_domains (online/host-based routing). Any other value
# (incl. unset) skips the host lookup and uses only the safe env/setup fallback
# chain; "tenant_code_legacy" means "no default-tenant guess" (every route must
# carry its own tenantCode) and never resolves a host-based route.
# PUBLIC_TENANT_RESOLUTION_MODE=host_default
#
# PUBLIC_TRUST_PROXY: default false. Only when "true" is X-Forwarded-Host read at
# all — set it ONLY behind a single trusted edge proxy that fully OVERWRITES that
# header on every request (never trust a client-supplied value). Otherwise the
# plain Host header is used.
# PUBLIC_TRUST_PROXY=false
#
# Safe fallback tenant for host-resolved public routes when the host does not map
# (or host lookup is off): tried in order ID -> CODE -> awcms_setup_state.tenant_id.
#
# PIN THESE PER ENVIRONMENT. Leaving them unset still works — the chain ends at
# `awcms_setup_state.tenant_id`, which the setup wizard populated — but that
# makes "which tenant does an unmatched host get?" an implicit answer buried in
# a table rather than a stated one. Pinning them is also the only way a second
# tenant can be added later without silently changing what the first host
# resolves to.
#
# Each environment sets its OWN tenant here, and the value is deliberately not
# copied between a laptop and the deployment:
#   development  -> the tenant your local setup wizard created
#   production   -> tenant_code `ahliweb`
# PUBLIC_DEFAULT_TENANT_ID=
# PUBLIC_DEFAULT_TENANT_CODE=

# --- platform authority (ADR-0053) ---
# Which tenant may perform PLATFORM-scoped actions — the ones whose effect
# crosses tenant boundaries (today: activating/rolling back the Indonesia
# region dataset, which every tenant is served from). Authority still requires
# the permission itself; this names the only tenant allowed to hold it.
#
# UNSET (the default) inherits the public default-tenant chain above:
# PUBLIC_DEFAULT_TENANT_ID -> PUBLIC_DEFAULT_TENANT_CODE ->
# awcms_setup_state.tenant_id. In a single-tenant deployment that is the same
# tenant, so there is nothing to keep in step.
#
# CONSEQUENCE WHILE UNSET: `PUBLIC_DEFAULT_TENANT_ID` is a security control.
# Repointing it to change which site renders on an unmatched host ALSO repoints
# platform authority. `bun run security:readiness` reports which tenant holds
# it and warns when that is not the tenant the setup wizard bootstrapped.
#
# SET IT once the two answers diverge — in SaaS the landing page usually
# belongs to a marketing tenant while platform authority must stay with the
# operator tenant. A value that is not a UUID, or that names a tenant which is
# absent or inactive, resolves to NOTHING and denies every platform action; it
# never falls back (falling back would hand authority to a tenant nobody named).
# PLATFORM_TENANT_ID=

# --- owner account convention (all phases) ---
# The first account created by `POST /api/v1/setup/initialize` is the tenant
# `owner`: a system role holding the ENTIRE permission catalog. In both
# development and production the owner login identifier is
# `admin@ahlikoding.com`.
#
# The identifier is shared; the PASSWORD IS NOT, and must never be. Identities
# are tenant-scoped (`awcms_identities` is unique on `(tenant_id,
# login_identifier)`), so the same address on a laptop and in production is two
# unrelated accounts with two different password hashes. Sessions do not
# cross either: a session token is an opaque random value stored as a sha256
# hash in `awcms_sessions`, which is itself tenant-scoped, so a token only
# authenticates against the database that issued it. Copying a password between
# environments would undo exactly the isolation that separation buys — and it
# is the ONLY thing that would, because nothing else here is shared.
#
# One trap that is invisible until someone hits a 403: a permission-seed
# migration only reaches tenants created AFTER it runs. Landing a module that
# seeds new permissions does NOT grant them to an existing owner. Backfill as a
# deployment step:
#
#   INSERT INTO awcms_role_permissions (tenant_id, role_id, permission_id)
#   SELECT r.tenant_id, r.id, p.id
#   FROM awcms_roles r CROSS JOIN awcms_permissions p
#   LEFT JOIN awcms_role_permissions rp
#     ON rp.role_id = r.id AND rp.permission_id = p.id
#   WHERE r.role_code = 'owner' AND r.deleted_at IS NULL
#     AND rp.permission_id IS NULL;

# --- comments (ADR-0041) ---
# Both secrets are OPTIONAL and both degrade to a strictly SAFE state, which is
# why `bun run security:readiness` reports them as warnings rather than critical
# findings. Set them for a real deployment anyway — each degradation is silent
# from the outside and costs real functionality.
#
# COMMENTS_SUBSCRIBER_ENCRYPTION_KEY: 32 bytes base64 (`openssl rand -base64 32`),
# AES-256-GCM, and a SEPARATE key from MFA's and SSO's so one compromised key
# does not expose three unrelated datasets. It encrypts reply-notification
# recipient addresses at rest. Unset (or the wrong length) means subscriptions
# store an unresolvable sentinel: no plaintext address is ever written, and
# reply notifications simply cannot be sent.
COMMENTS_SUBSCRIBER_ENCRYPTION_KEY=
#
# COMMENTS_TIMING_SECRET: signs the short-lived token embedded in the public
# comment form, which is how the server measures submit latency without trusting
# a client-supplied number (the anti-abuse timing floor). This is NOT an
# authorization artifact — forging one only skips the "submitted implausibly
# fast" heuristic. Unset means a per-process random key: tokens do not survive a
# restart and are not valid across instances, so a form rendered earlier fails
# the timing check and the visitor must resubmit.
COMMENTS_TIMING_SECRET=
#
# Retention window for the anonymization sweep (`bun run comments:retention`).
# Default 365 days. Overridden per-run by `--retention-days=<n>`.
# COMMENTS_RETENTION_DAYS=365

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Newsletter (ADR-0103) — public endpoint rate limits
# ---------------------------------------------------------------------------
#
# Per-IP limits shared by all three PUBLIC, anonymous endpoints: subscribe,
# confirm and unsubscribe. An abuse control, not a tuning knob — `subscribe`
# sends mail on somebody else's behalf, and `confirm`/`unsubscribe` are token
# lookups, so without a limit they are oracles you can ask ten thousand times.
#
# Deliberately tighter than the search limits beside them: nobody subscribes to
# a newsletter five times in five minutes, and the cost of being wrong in the
# other direction is somebody else's inbox.
# NEWSLETTER_RATE_LIMIT_MAX=5
# NEWSLETTER_RATE_LIMIT_WINDOW_SEC=300
#
# Site search (ADR-0040) — public endpoint rate limits
# ---------------------------------------------------------------------------
#
# Per-IP limits on the two PUBLIC, anonymous endpoints. These are an abuse
# control, not a tuning knob: raising them widens the amount of full-text work
# an unauthenticated caller can force per IP.
# SITE_SEARCH_RATE_LIMIT_MAX=60
# SITE_SEARCH_RATE_LIMIT_WINDOW_SEC=60
#
# The typeahead endpoint is cheaper per call and allows more of them.
# SITE_SEARCH_SUGGEST_RATE_LIMIT_MAX=120
# SITE_SEARCH_SUGGEST_RATE_LIMIT_WINDOW_SEC=60

# ---------------------------------------------------------------------------
# Form drafts (retention)
# ---------------------------------------------------------------------------
#
# Retention window for `bun run form-drafts:purge`. Default 30 days.
# FORM_DRAFT_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Edge cache / Varnish (ADR-0042)
# ---------------------------------------------------------------------------
#
# An OPTIONAL caching tier in front of the app. Everything below is unset by
# default, and unset means the subsystem is completely inert: no surrogate
# headers, no invalidation, no behaviour change. Enabling it is a two-sided
# change — the app must be configured here AND a Varnish container must be put
# in front (`infra/varnish/docker-compose.varnish.yml`). Doing only one of the
# two is harmless but pointless.
#
# EDGE_CACHE_MODE: off | auto | on
#   off  (default) — inert.
#   auto — cache only while the origin is actually under load. At rest the
#          advertised TTL is 0 and visitors get live data; once sustained
#          request rate or latency crosses the thresholds below, the TTL ramps
#          up and Varnish starts absorbing repeated public reads instead of the
#          database. This is the recommended setting.
#   on   — always advertise the declared TTL for declared public surfaces.
# Mode NEVER changes WHAT is cacheable (that is a fail-closed allow-list in
# src/lib/edge-cache/), only how long.
# EDGE_CACHE_MODE=auto
#
# Varnish's listener, used for BAN (invalidation) requests. Without it, content
# edits are not invalidated and stay visible until their TTL expires.
# EDGE_CACHE_PURGE_ENDPOINT=http://varnish:80
#
# Shared secret sent as X-Edge-Purge-Token and checked by the VCL. MUST match
# the varnish container's own EDGE_CACHE_PURGE_TOKEN. Setting the endpoint
# WITHOUT this is reported as a CRITICAL finding by `bun run security:readiness`:
# the VCL rejects unauthenticated BANs, so every invalidation fails silently and
# the site serves stale content indefinitely while looking healthy.
# EDGE_CACHE_PURGE_TOKEN=
#
# Hard ceiling on any advertised edge TTL, in seconds (default 300). Clamps even
# a surface that declares longer, so one careless declaration cannot pin stale
# content at the edge for a day.
# EDGE_CACHE_MAX_TTL_SECONDS=300
#
# How long the edge may serve a stale copy while revalidating in the background
# (default 600). The main protection against a thundering herd reaching the
# database when a popular object expires.
# EDGE_CACHE_STALE_WHILE_REVALIDATE_SECONDS=600
#
# Auto-mode activation thresholds. Sustained requests/second and rolling mean
# origin latency (ms) at which the TTL ramp begins; the ramp reaches the full
# declared TTL at twice the threshold.
# EDGE_CACHE_AUTO_REQUEST_RATE_THRESHOLD=5
# EDGE_CACHE_AUTO_LATENCY_THRESHOLD_MS=250
# EDGE_CACHE_AUTO_WINDOW_SECONDS=60
#
# Rows drained per tenant per pass of `bun run edge-cache:purge` (default 200).
# EDGE_CACHE_PURGE_BATCH_SIZE=200

# ---------------------------------------------------------------------------
# Tenant subdomain serving records (bun run tenant-domain:dns:sync)
# ---------------------------------------------------------------------------
#
# Turns a row in `awcms_tenant_domains` into a working subdomain. Only applies
# to `domain_type = 'subdomain'` rows in the platform's OWN managed zone —
# custom domains live in the tenant's zone and keep the manual/TXT flow.
#
# Which DNS adapter `bun run tenant-domain:dns:sync` uses. `manual` (the
# default) makes NO outbound call at all — verification stays a TXT record the
# tenant places themselves. `cloudflare` is the only other value, and it turns
# the job into something that talks to a real DNS API.
# TENANT_DOMAIN_DNS_PROVIDER=manual
#
# Required as a set WHEN (and only when) the provider above is `cloudflare` —
# see TENANT_DOMAIN_CLOUDFLARE_REQUIRED_WHEN_SELECTED in
# src/modules/tenant-domain/domain/tenant-domain-dns-config.ts. The adapter
# refuses any hostname outside the configured root, so the root is a security
# boundary and not just a convenience.
# TENANT_DOMAIN_PLATFORM_ROOT_DOMAIN=awcms.example.com
# TENANT_DOMAIN_CLOUDFLARE_ZONE_ID=replace-me
# TENANT_DOMAIN_CLOUDFLARE_API_TOKEN=replace-me
#
# Optional per-call timeout for the adapter's bounded network calls (default
# 8000). An unset or invalid value falls back to the default — never a boot
# failure over a tuning knob.
# TENANT_DOMAIN_CLOUDFLARE_TIMEOUT_MS=8000
#
# With either the provider or the target below unset, the job exits without
# touching the database.
#
# Where tenant traffic should land: an IPv4 address when
# TENANT_DOMAIN_SERVING_RECORD_TYPE=A, or a hostname for CNAME (the default).
# There is deliberately NO default value — guessing this points every tenant
# subdomain at a wrong address, which is a platform-wide outage.
# For this deployment that is the production app host, so tenant subdomains
# become <tenant>.awcms.ahlikoding.com pointing at it. Pair it with
# TENANT_DOMAIN_PLATFORM_ROOT_DOMAIN=awcms.ahlikoding.com — the adapter refuses
# any hostname outside the configured root. See docs/awcms/environments.md
# §Subdomain tenant: the root is a written-down ASSUMPTION, not a settled
# decision, and changing it later means migrating tenant hostnames.
#
# Only ONE deployment may hold `cloudflare` for a given zone: two of them
# writing serving records for the same hostname into that zone overwrite each
# other, and the loser's tenants point somewhere they were never meant to. With
# a single deployed environment (ADR-0083) that is settled here by construction
# — it becomes a live hazard again the moment a second install is aimed at the
# same zone, and the second install is the one that stays on `manual`.
# TENANT_DOMAIN_SERVING_TARGET=awcms.ahlikoding.com
#
# A | CNAME (default CNAME).
# TENANT_DOMAIN_SERVING_RECORD_TYPE=CNAME
#
# Proxied (orange cloud) unless set to exactly "false". Proxying is what
# supplies TLS for an unbounded number of subdomains without issuing a
# certificate per name — the reason unlimited subdomains are practical here.
# TENANT_DOMAIN_SERVING_PROXIED=true

# ---------------------------------------------------------------------------
# media_library — Cloudflare R2 object storage for managed media
# ---------------------------------------------------------------------------
#
# The whole block is OPTIONAL: with NEWS_MEDIA_R2_ENABLED unset or not exactly
# "true", the module's upload/verification path is inert and nothing below is
# read. Turning it on without the five required keys is a boot-time config
# error, not a runtime surprise — `bun run config:validate` reports it.
#
# NEWS_MEDIA_R2_ENABLED=true
#
# The five required once enabled. Account/key/secret come from the Cloudflare
# R2 dashboard; the secret is a real credential and never belongs in a commit.
# NEWS_MEDIA_R2_ACCOUNT_ID=
# NEWS_MEDIA_R2_ACCESS_KEY_ID=
# NEWS_MEDIA_R2_SECRET_ACCESS_KEY=
# NEWS_MEDIA_R2_BUCKET=
#
# The public base URL every managed media object's URL is built from — a
# custom domain or r2.dev address serving the bucket above. It must be https,
# and it must be the base of a bucket that only THIS deployment writes: it is
# how the code recognises its own media. ADR-0044 §4's advertisement ingest
# (`bun run blog:ads:ingest`) uses it to tell a managed image from an arbitrary
# external one, and with it unset that job reports every ad as residue rather
# than migrating anything — loud and lossless, but it migrates nothing.
# NEWS_MEDIA_R2_PUBLIC_BASE_URL=https://media.example.com
#
# Tuning knobs, all with defaults. An unset or malformed value falls back
# rather than failing boot.
# NEWS_MEDIA_R2_PRESIGNED_UPLOAD_TTL_SECONDS=900
# NEWS_MEDIA_R2_MAX_UPLOAD_BYTES=10485760
# NEWS_MEDIA_R2_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
# NEWS_MEDIA_R2_PENDING_TTL_MINUTES=60
# NEWS_MEDIA_R2_ORPHAN_GRACE_DAYS=30

# ---------------------------------------------------------------------------
# Redis — shared rate limiting and cache across instances
# ---------------------------------------------------------------------------
#
# Read the consequence before deciding this block is optional. With
# REDIS_ENABLED unset, the rate limiter keeps its counters IN PROCESS. On one
# replica that is correct. On N replicas it silently becomes N x every limit you
# configured — including the login and auth-source ceilings — because each
# replica counts only the requests it happened to receive. Nothing warns: the
# limits still appear enforced, just N times too permissive.
#
# So: one replica, leave it off. More than one replica, this is REQUIRED.
# REDIS_ENABLED=false
#
# Required once enabled; boot-time config error without it. Schemes accepted:
# redis:// and rediss:// (use rediss:// when the hop leaves the Docker network).
# REDIS_URL=redis://localhost:6379
#
# Tuning knobs, all with defaults. Out-of-range values fall back rather than
# failing boot.
# REDIS_KEY_PREFIX=awcms
# REDIS_CONNECTION_TIMEOUT_MS=2000
# REDIS_COMMAND_TIMEOUT_MS=1000
# REDIS_MAX_RETRIES=3
# REDIS_CACHE_DEFAULT_TTL_SEC=300

# ---------------------------------------------------------------------------
# blog_content — social share buttons on public article pages
# ---------------------------------------------------------------------------
#
# Every flag defaults to TRUE, so leaving this whole block out renders the full
# share row. Set a flag to "false" to drop that one button; only the exact
# string "false" disables it.
# BLOG_SHARE_BUTTONS_ENABLED=true
# BLOG_SHARE_NATIVE_ENABLED=true
# BLOG_SHARE_WHATSAPP_ENABLED=true
# BLOG_SHARE_TELEGRAM_ENABLED=true
# BLOG_SHARE_FACEBOOK_ENABLED=true
# BLOG_SHARE_LINKEDIN_ENABLED=true
# BLOG_SHARE_X_ENABLED=true
# BLOG_SHARE_EMAIL_ENABLED=true
#
# Instagram has no web share URL that prefills a post, so it is offered only
# through the OS share sheet. Setting this to "false" advertises Instagram on
# desktop too, where the button cannot do anything useful.
# BLOG_SHARE_INSTAGRAM_NATIVE_ONLY=true

# ---------------------------------------------------------------------------
# blog_content — automatic internal links from tag terms
# ---------------------------------------------------------------------------
#
# ON by default: rendered articles get their tag terms linked to the matching
# archive. The caps exist to keep editorial prose from turning into a link farm
# and to bound render time on very long articles — raising them is a content
# decision, not a tuning one. Malformed values fall back to the default.
# BLOG_AUTO_INTERNAL_TAG_LINKS_ENABLED=true
# BLOG_AUTO_INTERNAL_TAG_LINKS_MAX_PER_POST=10
# BLOG_AUTO_INTERNAL_TAG_LINKS_MAX_PER_TAG=1
# BLOG_AUTO_INTERNAL_TAG_LINKS_MIN_TERM_LENGTH=3
# BLOG_AUTO_INTERNAL_TAG_LINKS_LINK_FIRST_OCCURRENCE_ONLY=true
# BLOG_AUTO_INTERNAL_TAG_LINKS_EXCLUDE_HEADINGS=true

# ---------------------------------------------------------------------------
# news_portal preset — full online + R2 profile
# ---------------------------------------------------------------------------
#
# Opt-in, never a default: the readiness check requires NEWS_PORTAL_ENABLED to
# be exactly "true" AND the profile below to be "full_online_r2". The media half
# of the same preset is media_library's question (ADR-0036), so the R2 block
# above must be satisfied too or readiness still reports not-ready.
# NEWS_PORTAL_ENABLED=true
# NEWS_PORTAL_PROFILE=full_online_r2

# ---------------------------------------------------------------------------
# reporting — generated export artefacts
# ---------------------------------------------------------------------------
#
# Where scheduled report exports are written, and how long they are kept. The
# path is a LOCAL filesystem path: on a container without a volume mounted here
# the artefacts live only as long as the container does.
# REPORTING_EXPORT_ROOT_PATH=./var/reporting-exports
# REPORTING_EXPORT_RETENTION_DAYS=7
