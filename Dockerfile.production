# syntax=docker/dockerfile:1.7
#
# Dockerfile.production — image registry-based deployment (ADR-0001,
# docs/awcms/deployment-profiles.md §production (online) — image registry).
# Immutable, built once in CI (release.yml), pulled+run identically per
# environment. NOT the LAN-first default (docker-compose.yml bind-mount
# path) — this is the opt-in registry/orchestrator path.
#
# Does NOT run migrations — the runtime role (awcms_app, least-privilege)
# has no DDL/GRANT rights. Run `bun run db:migrate` as a separate step
# against a privileged connection before this container's first start
# (docs/awcms/deployment-profiles.md §Model dua-peran basis data).

FROM oven/bun:1.4.4 AS base

# The perl-base CVE workaround (#833) below is KEPT. Re-checked against the
# 1.4.4 image (2026-10-24, #1172): `docker run --rm --entrypoint dpkg
# oven/bun:1.4.4 -s perl-base` reports 5.40.1-6+deb13u1 — i.e. the base image
# ALREADY carries the Debian fix, so the three CVEs below are not present in
# it (oven/bun:1.4.4 index digest sha256:1d22548f177f..., published
# 2026-10-22; `bun --version` in the image prints 1.4.4). The step is
# `apt-get upgrade`: a no-op when the base is already patched, and it closes
# any future fixable Debian CVE on the next rebuild without waiting for
# oven/bun to republish the tag — so it is kept on purpose (one layer,
# loosens nothing), no longer because the CVEs are suspected to be present.
# The image is pinned by tag, not by digest (floating `latest` is never used).
#
# Original finding (#833, 2026-09-27) for oven/bun:1.4.2: its Debian (trixie)
# base shipped perl-base 5.40.1-6 with three CRITICAL, fixed-upstream CVEs
# (CVE-2026-13221, CVE-2026-42496, CVE-2026-8376 — fixed in 5.40.1-6+deb13u1);
# every 1.4.2 tag resolved to one digest published 2026-09-05, before the fix
# existed, so waiting for upstream was not an option then.
# Applying the Debian security upgrade here, in `base`, instead of only in
# the `runtime`/`jobs` stages that ship, means every derived stage (`deps`,
# `build`, `prod-deps`, `jobs`, `runtime`) inherits it from one layer, and
# any future fixable Debian CVE on this base is closed on the next rebuild
# without waiting for oven/bun to republish the tag — the same pattern
# awcms-one applies to its own storefront runtime image.
RUN apt-get update \
  && apt-get upgrade -y \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /home/bun/app

# ---- deps: full deps (incl. dev) needed to build ----
FROM base AS deps
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# ---- build: astro build (server output, node adapter standalone) ----
FROM base AS build
COPY --from=deps /home/bun/app/node_modules ./node_modules
COPY . .
RUN bun run build

# ---- prod-deps: production-only deps for the final runtime image ----
FROM base AS prod-deps
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

# ---- jobs: the same source, able to RUN the 32 registered job targets --------
#
# The `runtime` stage below deliberately carries only `dist/`. That makes it
# small and it makes `bun run <target>` impossible: every one of the 32 job
# targets in the module registry resolves to `bun scripts/<name>.ts`, and
# `scripts/` is not in that image. The failure is `Script not found` — a job that
# is scheduled and cannot execute, which reads in a log exactly like a job that
# had nothing to do.
#
# This stage exists so the jobs image is BUILT AND PUBLISHED BY CI from the same
# commit as the app. Before it, the host kept a hand-copied snapshot of the
# source as a docker build context: it worked, and it did not follow releases, so
# after every deploy the cron ran the PREVIOUS release's code against the NEW
# schema until someone remembered to refresh it. Nothing reported that either.
#
# It intentionally uses the FULL dependency set (`deps`, not `prod-deps`): jobs
# execute TypeScript directly through Bun and import from `src/`, so trimming to
# production dependencies would fail at import time rather than at build time —
# the worst place to discover it.
#
# No HEALTHCHECK and no CMD default: this image is invoked as
# `docker run --rm awcms-jobs bun run <target>` by a scheduler, never left
# running. A default CMD would invite starting it as a service.
#
# It is placed BEFORE `runtime` on purpose. `docker build` with no `--target`
# builds the LAST stage, and several things build this file that way (Coolify's
# build-from-repo path among them). Putting the jobs image last would silently
# swap the published application image for one that has no `dist/` and no CMD —
# a deploy that "succeeds" and serves nothing. `runtime` stays last so the
# defaultless build keeps meaning "the app"; CI names both targets explicitly.
FROM base AS jobs
ENV APP_ENV=production

COPY --from=deps --chown=bun:bun /home/bun/app/node_modules ./node_modules
COPY --chown=bun:bun package.json bun.lock tsconfig.json ./
COPY --chown=bun:bun scripts ./scripts
COPY --chown=bun:bun src ./src
COPY --chown=bun:bun sql ./sql
COPY --chown=bun:bun locales ./locales
COPY --chown=bun:bun openapi ./openapi

# The host-side runner and its two generated env files (Issue #1131, L5).
# `ops/run-job.sh` is copied to the host by hand, and so are the env files; the
# image is pulled on its own schedule. A newer image can read a scoped secret
# that an older host file does not grant, and the job then runs without it and
# reports success. Shipping the three files here lets the runner compare its
# host copies with these and refuse on any difference. They hold variable
# NAMES and job targets only (`tests/jobs-image-ops-files.test.ts` asserts no
# line has a value), so nothing secret is baked in. Only these three: the rest
# of `ops/` (backup, restore drill, log shipping) is host tooling, not job code.
COPY --chown=bun:bun ops/run-job.sh ops/awcms-jobs.env-global ops/awcms-jobs.env-scoped ./ops/

USER bun

# ---- runtime: minimal, non-root, read-only-filesystem compatible ----
FROM base AS runtime
ENV APP_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4321

COPY --from=prod-deps --chown=bun:bun /home/bun/app/node_modules ./node_modules
COPY --from=build --chown=bun:bun /home/bun/app/dist ./dist
COPY --chown=bun:bun package.json ./

# Runtime code resolves these directories against `process.cwd()` at request
# time (never bundled into `dist/`), so the `runtime` stage must carry them
# even though it otherwise ships only compiled output:
#   - `src/modules/omes-control/contracts/v1` — the vendored OMES contract
#     snapshot (PIN.json, schemas, state tables, fixtures) that
#     `src/modules/omes-control/domain/contracts/loader.ts`
#     (`VENDORED_CONTRACTS_DIR`) reads on every worker enroll/poll/result/
#     heartbeat/ai-privacy-posture/hermes-orchestration request and every
#     `/admin/omes/*` page load. Without it, every one of those loads
#     ENOENTs.
#   - `sql`, `openapi`, `asyncapi` — read by
#     `src/modules/module-management/application/health-registry.ts` for the
#     `migrations_applied`, `openapi_documented`, and `asyncapi_documented`
#     module health signals (`/api/v1/modules/[moduleKey]/health`). Missing
#     directories don't throw there (each read is try/caught), but every
#     module's health check always reports `fail` in production.
COPY --chown=bun:bun src/modules/omes-control/contracts ./src/modules/omes-control/contracts
COPY --chown=bun:bun sql ./sql
COPY --chown=bun:bun openapi ./openapi
COPY --chown=bun:bun asyncapi ./asyncapi

USER bun
EXPOSE 4321

# LIVENESS, deliberately — `/api/v1/health` is dependency-free and answers 200
# with the database on fire. That is the right question for a probe that
# RESTARTS things: restarting an app does not repair a database, and a probe
# that cycles containers through a database outage turns one incident into two.
#
# The other question — can this process actually serve content — is answered by
# `/api/v1/database/pool/health` (`databaseReachable`, `circuitBreakerState`).
# Finding D10 was that nothing read it; `ops/synthetic-check.sh` now does, from
# outside, where it alerts a human instead of restarting a container. Do not
# "fix" the probe below to point at it.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD bun -e "fetch('http://localhost:'+(process.env.PORT||4321)+'/api/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["bun", "./dist/standalone-entry.mjs"]
