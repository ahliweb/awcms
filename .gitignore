# Dependencies
node_modules/

# Environment (never commit secrets)
.env
.env.*
!.env.example

# Local dev-only Docker Compose overrides — auto-loaded by
# `docker compose`, never committed (each operator's own local port/volume
# preferences, not shared config). See docker-compose.override.yml.example.
docker-compose.override.yml

# PgBouncer SCRAM verifier file — contains SCRAM-SHA-256 verifiers
# (equivalent to password hashes; usable for offline dictionary attacks
# against DB roles), never committed.
userlist.txt

# Build output
dist/
.astro/
build/

# Local storage & backups
storage/
*.dump
*.sql.gz

# Logs & OS
*.log
.DS_Store
Thumbs.db

# Playwright E2E artifacts
playwright-report/
test-results/
blob-report/

# Claude Code user-local settings (jangan commit)
.claude/settings.local.json

# graphify skill: track the shareable graph output, but never the
# regenerable cache nor the machine/user-specific path markers.
graphify-out/cache/

# EVERY dotted file inside graphify-out is a build intermediate or a
# machine-specific marker; the shareable output is the undotted set
# (`graph.json`, `manifest.json`, `cost.json`, `GRAPH_REPORT.md`). The skill's
# own final step deletes the intermediates, so a tracked copy can only ever be
# absent (dirty tree after every run) or left over from a run interrupted
# before cleanup — i.e. stale, describing a graph.json that has since moved.
#
# A blanket rule, not an enumeration: an INTERRUPTED run leaves files no list
# anticipates. The sibling awcms-astro repo was carrying seven of them
# (`.graphify_ast.json`, `.graphify_chunk_NN.json`, `.graphify_detect.json`,
# `.graphify_uncached.txt`, `.detect_err.txt`, plus the two path markers) —
# enumeration only guards the runs that finish cleanly, and those are not the
# runs that leave rubbish behind.
#
# Nothing shareable is lost: `.graphify_labels.json` holds the community labels
# GRAPH_REPORT.md §Community Hubs already renders, and it only needs to survive
# long enough for a `--wiki` export inside the same run.
graphify-out/.*

# graphify keeps a dated backup of the curated graph on every rebuild.
# The live artifacts beside it are the ones under review; a second full copy is
# ~12 MB of duplicate JSON per run.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# graph.html is NOT tracked, deliberately. Two reasons, both learned the hard
# way: graphify silently stops emitting it once the corpus passes its viz node
# limit (the committed copy then rots while graph.json beside it stays current),
# and at this corpus size it weighs ~8.7 MB per rebuild against graph.json's
# ~10 MB, doubling what every refresh adds to history forever.
#
# Nothing is lost: it is one command away, and graph.json — which IS tracked —
# is the queryable source it renders from.
#
#   GRAPHIFY_VIZ_NODE_LIMIT=8000 graphify cluster-only .
#
# Raise the limit above the current node count (see GRAPH_REPORT.md §Summary)
# or the file is skipped without failing.
graphify-out/graph.html
