{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/control-center/v1/outbox-event.schema.json",
  "title": "outbox-event",
  "description": "An outbox-pattern record (issue #94 acceptance criteria: 'provider events asynchronous through the outbox/queue; no network payment call occurs inside a database transaction'). A webhook handler's ONLY job inside its own transaction is to verify the envelope and write one outbox-event row; every downstream effect (entitlement update, deployment action, notification) is a separate, retryable dispatch of this row, never a direct call made while the verifying transaction is still open.",
  "type": "object",
  "required": ["outbox_id", "event_id", "event_type", "occurred_at", "status", "attempts", "payload"],
  "additionalProperties": false,
  "properties": {
    "outbox_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "event_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "event_type": {
      "type": "string",
      "enum": [
        "payment.succeeded",
        "payment.failed",
        "invoice.recurring",
        "dunning.retry",
        "refund.completed",
        "dispute.opened",
        "cancellation.requested"
      ]
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "status": { "type": "string", "enum": ["pending", "dispatched", "failed"] },
    "attempts": { "type": "integer", "minimum": 0 },
    "next_attempt_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "correlation_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "payload": { "type": "object" }
  }
}
