      }
    }
  },
  "relations": {
    "hosts": { "from": ["server"], "to": ["deployment"], "evidence": "deployment.server_id" },
    "targets": { "from": ["job"], "to": ["server", "deployment"], "evidence": "job.server_id / job.deployment_id" },
    "delegates_to": { "from": ["hermes_subagent"], "to": ["hermes_subagent"], "evidence": "hermes-orchestration-tree node.parent_subagent_id (opaque Hermes correlation identifier)" },
    "observed_on": { "from": ["hermes_subagent", "ai_privacy_posture"], "to": ["server"], "evidence": "hermes-orchestration-tree.server_id / ai-privacy-posture-view.server_id" },
    "describes": { "from": ["health_report"], "to": ["server"], "evidence": "health snapshot server_id" },
    "protects": { "from": ["backup"], "to": ["server"], "evidence": "backup snapshot server_id" },
    "member_of": { "from": ["capability"], "to": ["architecture_plane"], "evidence": "architecture-capabilities-view capability.plane" },
    "awaits_decision_for": { "from": ["approval_item"], "to": ["job", "deployment", "backup"], "evidence": "operation request workflow_instance_id and target" }
  },
  "actions": {
    "open_details": { "mutating": false, "existing_path": "GET <detail_route>", "permission": "the source read_permission" },
    "operation.status": { "mutating": true, "existing_path": "POST /api/v1/omes/operations (operation=status)", "permission": "omes_control.deployments.read", "approval": "none" },
    "operation.preflight": { "mutating": true, "existing_path": "POST /api/v1/omes/operations (operation=preflight)", "permission": "omes_control.deployments.read", "approval": "none" },
    "operation.start": { "mutating": true, "existing_path": "POST /api/v1/omes/operations (operation=start)", "permission": "omes_control.deployments.operate", "approval": "none" },
    "operation.stop": { "mutating": true, "existing_path": "POST /api/v1/omes/operations (operation=stop)", "permission": "omes_control.deployments.operate", "approval": "workflow:omes_control.destructive_operation" },
    "operation.restart": { "mutating": true, "existing_path": "POST /api/v1/omes/operations (operation=restart)", "permission": "omes_control.deployments.operate", "approval": "none" },
    "operation.update": { "mutating": true, "existing_path": "POST /api/v1/omes/operations (operation=update)", "permission": "omes_control.deployments.operate", "approval": "none" },
    "operation.backup": { "mutating": true, "existing_path": "POST /api/v1/omes/operations (operation=backup)", "permission": "omes_control.deployments.operate", "approval": "none" },
    "operation.rollback": { "mutating": true, "existing_path": "POST /api/v1/omes/operations (operation=rollback)", "permission": "omes_control.backups.rollback", "approval": "workflow:omes_control.destructive_operation" },
    "job.cancel": { "mutating": true, "existing_path": "POST /api/v1/omes/jobs/{id}/cancel", "permission": "omes_control.jobs.cancel", "approval": "none" },
    "job.requeue": { "mutating": true, "existing_path": "POST /api/v1/omes/jobs/{id}/approve", "permission": "omes_control.jobs.approve", "approval": "none" },
    "backup.restore": { "mutating": true, "existing_path": "POST /api/v1/omes/backups/{id}/restore", "permission": "omes_control.backups.restore", "approval": "workflow:omes_control.destructive_operation" },
    "approval.open_in_inbox": { "mutating": false, "existing_path": "GET /admin/approvals?workflowKey=omes_control.destructive_operation&instance={id}", "permission": "workflow.approval.read", "approval": "decisions are made only in the canonical workflow inbox" }
  },
  "replay_bases": {
    "event_log": "Every retained transition is an event (deduplicated by source key); replay steps through them.",
    "snapshot_series": "Periodic retained snapshots; the state between two snapshots is the earlier snapshot's, labelled as last known.",
    "terminal_transitions": "Only creation and terminal transitions are retained; intermediate steps are an explicit evidence gap.",
    "current_only": "Only the current state is retained; in historical mode the object is shown with an evidence gap, never back-dated."
  },
  "forbidden_field_terms": [
    "prompt",
    "transcript",
    "reasoning",
    "chain_of_thought",
    "tool_args",
    "tool_arguments",
    "tool_result",
    "raw",
    "payload",
    "command",
    "shell",
    "argv",
    "token",
    "secret",
    "password",
    "credential",
    "private_key"
  ]
}
