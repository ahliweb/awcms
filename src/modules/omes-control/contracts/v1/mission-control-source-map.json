{
  "source_map_version": "1.0.0",
  "issue": "https://github.com/ahliweb/omes/issues/264",
  "adr_reference": "ADR-0031",
  "description": "Anti-redundancy source map for the AWCMS 3D Mission Control workspace (epic #263). Every scene object kind maps to exactly ONE existing authority, source contract/record, opaque identifier field, freshness rule, allowed display fields, canonical 2D detail route, candidate EXISTING actions, and replay evidence basis. Mission Control is a derived presentation/read-model composition (ADR-0031): this map is not a registry of new capabilities, not an authorization policy, and not a new mission/task lifecycle. An object kind, state value, relation, action, or source absent from this map is unsupported and MUST fail closed (render unknown / unavailable, offer no action). OMES guard MC1-MC9 (lib/omes/py/architecture/mission_control.py) keeps this file consistent with the contracts it references.",
  "workspace": {
    "route": "/admin/omes/mission-control",
    "implementation_repository": "ahliweb/awcms",
    "replaces_screens": [],
    "description": "One additional integrated workspace inside the existing AWCMS AdminLayout. It replaces none of the canonical screens below; every object links back to one of them."
  },
  "canonical_screens": [
    { "route": "/admin/omes", "name": "Overview", "issue": 200 },
    { "route": "/admin/omes/servers", "name": "Servers", "issue": 200 },
    { "route": "/admin/omes/deployments", "name": "Deployments", "issue": 200 },
    { "route": "/admin/omes/operations", "name": "Operations", "issue": 200 },
    { "route": "/admin/omes/jobs", "name": "Jobs", "issue": 200 },
    { "route": "/admin/omes/health", "name": "Health", "issue": 201 },
    { "route": "/admin/omes/backups", "name": "Backups and recovery", "issue": 201 },
    { "route": "/admin/omes/audit", "name": "Audit", "issue": 201 },
    { "route": "/admin/omes/enrollments", "name": "Enrollments", "issue": 233 },
    { "route": "/admin/omes/ai-privacy", "name": "AI Privacy", "issue": 232 },
    { "route": "/admin/omes/orkestrasi-langsung", "name": "Live Orchestration", "issue": 246 },
    { "route": "/admin/omes/hermes", "name": "Hermes", "issue": 246 },
    { "route": "/admin/omes/progres-hermes", "name": "Hermes Repository Progress", "issue": 249 },
    { "route": "/admin/omes/arsitektur", "name": "Architecture", "issue": 246 },
    { "route": "/admin/approvals", "name": "Workflow approvals inbox (AWCMS workflow-approval module, not OMES-specific)", "issue": null }
  ],
  "visual_states": {
    "ok": "Explicitly proven succeeded/healthy/converged by a live source.",
    "in_progress": "Explicitly reported as starting/running/in progress by a live source.",
    "pending": "Explicitly reported as queued/pending/awaiting a decision by a live source.",
    "warning": "Explicitly reported as degraded/drifted/interrupted/attention-needed.",
    "failed": "Explicitly reported as failed/unhealthy/rejected.",
    "cancelled": "Explicitly reported as cancelled.",
    "informational": "A record with no health semantics (capability, plane, milestone, decommissioned/maintenance server).",
    "stale": "The source's newest observation is older than its freshness budget; never shown as ok.",
    "unknown": "No observation, an UNKNOWN/unrecognised state value, or a source that could not be read."
  },
  "freshness_rule": {
    "description": "visual_state = state_map[kind][source_state] (unknown when the value is absent from the map), then: freshness 'unknown' -> 'unknown'; freshness 'stale' -> keep 'failed' or 'warning' (a last-known problem never disappears), otherwise 'stale' (a last-known success is never shown as current). Animation never changes visual_state.",
    "unknown": "unknown",
    "stale_keeps": ["failed", "warning"],
    "stale_otherwise": "stale",
    "unmapped_state": "unknown"
  },
  "sources": {
    "omes_server_inventory": {
      "authority": "omes",
      "record": "AWCMS awcms_omes_servers row reconciled from OMES enrollment and worker heartbeat (#195, #192)",
      "contracts": ["server-registration.response", "worker-heartbeat.request"],
      "freshness": { "basis": "last worker heartbeat (AWCMS STALE_HEARTBEAT_THRESHOLD_MS)", "stale_after_seconds": 300 },
      "read_permission": "omes_control.servers.read"
    },
    "omes_deployment_view": {
      "authority": "omes",
      "record": "AWCMS awcms_omes_deployments desired vs observed state (#91)",
      "contracts": ["deployment-view"],
      "freshness": { "basis": "last_reconciled_at (AWCMS STALE_RECONCILIATION_THRESHOLD_MS)", "stale_after_seconds": 1800 },
      "read_permission": "omes_control.deployments.read"
    },
    "omes_job_status": {
      "authority": "omes",
      "record": "AWCMS awcms_omes_jobs plus awcms_omes_worker_results (#90, #192)",
      "contracts": ["job-status.response", "worker-result.request"],
      "freshness": { "basis": "a non-terminal job takes the freshness of its target server heartbeat (AWCMS STALE_HEARTBEAT_THRESHOLD_MS); terminal states are final evidence and never go stale", "stale_after_seconds": 300 },
      "read_permission": "omes_control.jobs.read"
    },
    "omes_health_readiness": {
      "authority": "omes",
      "record": "AWCMS awcms_omes_health_snapshots (latest per server) (#79)",
      "contracts": ["health-readiness.response"],
      "freshness": { "basis": "latest snapshot captured_at; AWCMS defines no health staleness rule, so this Mission Control budget is new and documented in ADR-0031", "stale_after_seconds": 1800 },
      "read_permission": "omes_control.servers.read"
    },
    "omes_backup_status": {
      "authority": "omes",
      "record": "AWCMS awcms_omes_backup_snapshots (#82)",
      "contracts": ["backup-status.response"],
      "freshness": { "basis": "backup captured_at (AWCMS BACKUP_FRESHNESS_THRESHOLD_MS)", "stale_after_seconds": 86400 },
      "read_permission": "omes_control.backups.read"
    },
    "hermes_orchestration_tree": {
      "authority": "hermes",
      "record": "AWCMS awcms_omes_hermes_orchestration_trees/events produced from the supported Hermes observer (#183, ADR-0028)",
      "contracts": ["hermes-orchestration-tree", "hermes-orchestration-event"],
      "freshness": { "basis": "AWCMS classifyOrchestrationFreshness (DEFAULT_TREE_FRESHNESS_WINDOW_SECONDS)", "stale_after_seconds": 120 },
      "read_permission": "omes_control.hermes_orchestration.read"
    },
    "omes_architecture_capabilities_view": {
      "authority": "omes",
      "record": "Pinned architecture-capabilities-view snapshot vendored into AWCMS (#246 part 3, #247)",
      "contracts": ["architecture-capabilities-view"],
      "freshness": { "basis": "pinned OMES release snapshot; never stale, but never live host evidence either", "stale_after_seconds": null },
      "read_permission": "omes_control.architecture.read"
    },
    "github_repository_progress_view": {
      "authority": "provider",
      "record": "AWCMS awcms_omes_repository_progress observation polled from GitHub (#249, ADR-0030)",
      "contracts": ["repository-progress-view"],
      "freshness": { "basis": "observed_at against the 15-minute poll interval x REPOSITORY_PROGRESS_STALE_GRACE_MULTIPLIER (2)", "stale_after_seconds": 1800 },
      "read_permission": "omes_control.hermes_orchestration.read"
    },
    "omes_ai_privacy_posture_view": {
      "authority": "omes",
      "record": "AWCMS awcms_omes_ai_privacy_posture (#217, #232, ADR-0029)",
      "contracts": ["ai-privacy-posture-view"],
      "freshness": { "basis": "evidence_freshness field", "stale_after_seconds": null },
      "read_permission": "omes_control.ai_privacy.read"
    },
    "awcms_workflow_approval": {
      "authority": "awcms",
      "record": "AWCMS workflow-approval instance/task rows for OMES workflow keys (omes_control.destructive_operation); no OMES contract - AWCMS is the approval authority",
      "contracts": [],
      "freshness": { "basis": "workflow instance updated_at; read on every request", "stale_after_seconds": null },
      "read_permission": "workflow.approval.read"
    }
  },
  "kinds": {
    "server": {
      "zone": "infrastructure",
      "source": "omes_server_inventory",
      "source_id_field": "server_id",
      "label_field": "hostname",
      "summary_field": null,
      "state_field": "status",
      "allowed_fields": ["server_id", "hostname", "status", "os_name", "os_version", "arch", "last_heartbeat_at"],
      "detail_route": "/admin/omes/servers",
      "interaction": "shortcut_to_existing_actions",
      "candidate_actions": ["open_details", "operation.status", "operation.preflight"],
      "replay_basis": "current_only",
      "contract_state_enums": [
        { "contract": "worker-heartbeat.request", "path": ["properties", "status"] }
      ],
      "projection_state_values": ["offline", "online", "degraded", "maintenance", "decommissioned"],
      "state_map": {
        "online": "ok",
        "healthy": "ok",
        "degraded": "warning",
        "maintenance": "informational",
        "decommissioned": "informational",
        "offline": "unknown"
      }
    },
    "deployment": {
