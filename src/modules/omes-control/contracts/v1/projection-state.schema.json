{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/control-center/v1/projection-state.schema.json",
  "title": "projection-state",
  "description": "The freshness/rebuild/reconciliation metadata every read-model report projection must carry (issue #95). A projection is NEVER a second source of truth: `cursor` names exactly how far the projection has consumed its source event stream, `freshness` says how stale it may be, `rebuild` says whether it is currently being recomputed from scratch, and `reconciliation` records the last comparison against the authoritative source records (subscription/invoice/job/audit records, never the projection itself).",
  "type": "object",
  "required": ["projection_name", "cursor", "freshness", "rebuild", "reconciliation"],
  "additionalProperties": false,
  "properties": {
    "projection_name": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "cursor": {
      "type": "object",
      "required": ["last_event_id", "last_event_at"],
      "additionalProperties": false,
      "properties": {
        "last_event_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
        "last_event_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "freshness": {
      "type": "object",
      "required": ["as_of", "lag_seconds", "stale"],
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "lag_seconds": { "type": "integer", "minimum": 0 },
        "stale": { "type": "boolean" }
      }
    },
    "rebuild": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["not_rebuilding", "rebuilding", "rebuilt"] },
        "started_at": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "completed_at": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "required": ["last_reconciled_at", "discrepancies_found"],
      "additionalProperties": false,
      "properties": {
        "last_reconciled_at": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "discrepancies_found": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
