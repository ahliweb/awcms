{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/control-center/v1/entitlement.schema.json",
  "title": "entitlement",
  "description": "The resolved, effective limits a tenant currently holds (issue #92): plan limits plus any active add-on `limits_delta`, minus anything a resource policy currently withholds. This is the ONLY record `lib/omes/py/jobs/entitlement.py`'s evaluator reads to allow/deny a requested action; it is derived from `subscription` + `catalog-plan` + `catalog-addon` + `catalog-resource-policy`, never edited directly by a client.",
  "type": "object",
  "required": [
    "entitlement_id",
    "tenant_id",
    "subscription_id",
    "state",
    "limits",
    "effective_from",
    "source_event_id"
  ],
  "additionalProperties": false,
  "properties": {
    "entitlement_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "tenant_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "subscription_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "state": {
      "type": "string",
      "enum": [
        "trialing",
        "active",
        "past_due",
        "grace_period",
        "suspended",
        "cancelled",
        "expired"
      ]
    },
    "limits": {
      "type": "object",
      "required": [
        "servers",
        "logical_agents",
        "specialist_agents",
        "isolated_workers",
        "storage_gb",
        "backup_retention_days"
      ],
      "additionalProperties": false,
      "properties": {
        "servers": { "type": "integer", "minimum": 0 },
        "logical_agents": { "type": "integer", "minimum": 0 },
        "specialist_agents": { "type": "integer", "minimum": 0 },
        "isolated_workers": { "type": "integer", "minimum": 0 },
        "storage_gb": { "type": "integer", "minimum": 0 },
        "backup_retention_days": { "type": "integer", "minimum": 0 },
        "backends": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" }
        }
      }
    },
    "resource_policy_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "effective_from": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "effective_until": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source_event_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" }
  }
}
