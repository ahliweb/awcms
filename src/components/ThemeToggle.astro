---
/**
 * ThemeToggle — cycles system -> light -> dark -> system, persists the choice
 * in `localStorage["awcms_theme"]`, and updates `data-theme` on `<html>` live
 * (no reload). Adapted from awcms-micro's `src/components/ThemeToggle.astro`.
 *
 * The no-flash resolution on first paint is NOT this component's job — that
 * happens in the `is:inline` head script (`src/lib/security/theme-init-script.ts`),
 * which runs before the body paints. This toggle only handles the live change
 * after the user clicks. Both agree on one storage key, exported from that same
 * module so the two can never drift.
 *
 * Unlike awcms-micro's version, the labels are plain English literals rather
 * than `t()` props: awcms has no gettext catalog (no i18n module ported), and
 * every other string in this admin shell is likewise literal English. The
 * `data-label-*` attributes are kept anyway — that is the seam that lets
 * translated labels arrive later without the client script needing to read a
 * catalog it cannot access.
 *
 * CSP: this component ships NO script of its own. The behaviour lives in
 * `src/lib/ui/theme-toggle-client.ts`, imported by `AdminLayout.astro`'s script
 * block so it lands in a shared chunk that `script-src 'self'` admits.
 *
 * That is a CORRECTION, not a preference. This comment used to claim that a
 * component `<script>` without `is:inline` is bundled to an external module and
 * therefore needs no hash bookkeeping. The built manifest disagreed: the one
 * import was a string constant, the minifier folded it, nothing was left that
 * needed a chunk, and Astro inlined the whole body — which the CSP then refused,
 * leaving this button rendered and inert in production. See the module's own
 * doc comment for the full mechanism, and `bun run build:inline-scripts:check`
 * for the gate that now reads `dist/` instead of trusting a comment like this
 * one.
 */
interface Props {
  ariaLabel?: string;
  systemLabel?: string;
  lightLabel?: string;
  darkLabel?: string;
}

const {
  ariaLabel = "Change colour theme",
  systemLabel = "System",
  lightLabel = "Light",
  darkLabel = "Dark"
} = Astro.props;
---

<button
  type="button"
  id="theme-toggle"
  class="theme-toggle"
  data-mode="system"
  data-label-system={systemLabel}
  data-label-light={lightLabel}
  data-label-dark={darkLabel}
  aria-label={ariaLabel}
>
  <span class="theme-toggle-icon" aria-hidden="true">🖥️</span>
  <span class="theme-toggle-label">{systemLabel}</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--sp-1) var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--color-text);
    cursor: pointer;
  }

  .theme-toggle:hover {
    background: var(--color-surface-2);
  }

  .theme-toggle:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* Touch target >= 44px on tablet/mobile; desktop admin keeps the compact
     density above. */
  @media (max-width: 767.98px) {
    .theme-toggle {
      min-height: 44px;
      min-width: 44px;
    }

    /* Icon alone on phones — the topbar already carries brand, tenant badge,
       roles and logout, and the word is redundant next to the glyph. */
    .theme-toggle-label {
      display: none;
    }
  }
</style>
