---
/**
 * Password recovery request page (Wave 2 delta auth, adapted from awcms-micro
 * Issue #496). Posts `{ loginIdentifier }` plus the tenant header to
 * `POST /api/v1/auth/password/forgot` and shows ONE fixed confirmation
 * afterwards.
 *
 * ## The UI keeps the endpoint's promise
 *
 * The endpoint is account-enumeration-safe: it returns the same 200 body
 * whether or not the identifier matched anything. A page that rendered a
 * different state for "sent" than for "not found" would hand that guarantee
 * straight back, so this one has exactly one post-submit state — the form is
 * replaced by the server's own generic message, on any 2xx. It also does not
 * pre-check the identifier against anything.
 *
 * Rate limiting (429) and Turnstile rejections DO surface, because they are
 * properties of the CALLER, not of whether an account exists.
 *
 * ## Stable DOM contract (do not rename — E2E specs depend on these)
 *
 * `#forgot-form`, `#tenant-id`, `#login-identifier`, `#forgot-submit`,
 * `#forgot-error`, `#forgot-notice`. The tenant field always carries
 * `name="tenantId"` and id `#tenant-id` in all three picker shapes, exactly as
 * on `/login`, so the submit can always read it.
 *
 * ## CSP (strict, single-owner)
 *
 * Same rules as `/login`: `tokens.css`/`motion.css`/`auth.css` are external
 * same-origin stylesheets, the client script is Astro-BUNDLED (the `import` is
 * what forces that — an import-free script would be inlined and blocked), and
 * the only third-party origin is Cloudflare's Turnstile loader, and only when
 * the deployment profile actually requires it.
 */
import "../styles/tokens.css";
import "../styles/motion.css";
import "../styles/auth.css";
import {
  isTurnstileRequired,
  resolveTurnstileSiteKey,
  PASSWORD_RESET_TURNSTILE_ACTION
} from "../lib/security/turnstile";
import { loadTenantPickerModel } from "../modules/tenant-admin/application/tenant-picker-directory";
import AuthBrandPanel from "../components/AuthBrandPanel.astro";
import { getTranslatorFor } from "../lib/i18n";
import { resolveAuthPageLocale } from "../lib/i18n/auth-page-locale";

const turnstileActive = isTurnstileRequired();
const turnstileSiteKey = turnstileActive ? resolveTurnstileSiteKey() : null;

// Same picker as `/login`, from the same shared reader — recovery has to land
// the user in the tenant they will then sign in to.
const picker = await loadTenantPickerModel();
const tenantOptions = picker.options;
const tenantPickerMode = picker.mode;
const singleTenant = tenantPickerMode === "single" ? tenantOptions[0]! : null;

// Language (ADR-0095): cookie -> tenant default -> Accept-Language -> en. The
// tenant default is consulted ONLY for the single-tenant deployment (whose
// name the page already prints), never for a tenant the visitor picked or
// typed — see `src/lib/i18n/auth-page-locale.ts`.
const locale = await resolveAuthPageLocale({
  cookies: Astro.cookies,
  request: Astro.request,
  tenantId: singleTenant?.id ?? null
});
const { tx } = getTranslatorFor(locale);

// Messages for the client script, translated here (a script cannot). The
// confirmation is ONE fixed sentence: the page never shows the server's text or
// any state that depends on whether the identifier matched an account.
const formMessages = {
  "data-msg-rate-limited": tx(
    "recovery",
    "Too many requests. Please wait a few minutes and try again."
  ),
  "data-msg-failed": tx(
    "recovery",
    "Could not send the reset link. Check your details and try again."
  ),
  "data-msg-sent": tx(
    "recovery",
    "If an account exists for that identifier, password reset instructions have been sent."
  ),
  "data-msg-network": tx("recovery", "Network error. Please try again."),
  "data-msg-busy": tx("recovery", "Please wait…")
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{tx("recovery", "Reset your password")} · AWCMS</title>
  </head>
  <body class="auth-body">
    <main class="auth">
      <AuthBrandPanel
        locale={locale}
        headline={tx("recovery", "Locked out? A reset link is one step away.")}
        subline={tx(
          "recovery",
          "We send a single-use link to the address on file. Nothing about your account changes until you use it."
        )}
      />
      <div class="auth-form-panel">
        <div class="auth-card">
          <div class="auth-head">
            <div class="auth-brand">
              <span class="auth-mark" aria-hidden="true">
                A
              </span>
              <span class="auth-wordmark">AWCMS</span>
            </div>
            <h1 class="auth-title">{tx("recovery", "Reset your password")}</h1>
            <p class="auth-subtitle">
              {tx(
                "recovery",
                "Enter the identifier you sign in with. If it belongs to an account, we'll email a link to set a new password."
              )}
            </p>
          </div>

          <form id="forgot-form" class="auth-form" novalidate {...formMessages}>
            <p id="forgot-error" class="auth-error" role="alert" hidden></p>

            {singleTenant && (
              <div class="auth-tenant-context">
                <span class="auth-tenant-context-label">
                  {tx("recovery", "Recovering for")}
                </span>
                <span class="auth-tenant-context-name">
                  {singleTenant.name}
                </span>
                <input
                  id="tenant-id"
                  name="tenantId"
                  type="hidden"
                  value={singleTenant.id}
                />
              </div>
            )}

            {tenantPickerMode === "select" && (
              <div class="auth-field">
                <label for="tenant-id">{tx("recovery", "Organization")}</label>
                <div class="auth-select">
                  <select
                    id="tenant-id"
                    name="tenantId"
                    required
                    autocomplete="organization"
                  >
                    <option value="" disabled selected>
                      {tx("recovery", "Choose your organization")}
                    </option>
                    {tenantOptions.map((tenant) => (
                      <option value={tenant.id}>{tenant.name}</option>
                    ))}
                  </select>
                </div>
              </div>
            )}

            {tenantPickerMode === "manual" && (
              <div class="auth-field">
                <label for="tenant-id">{tx("recovery", "Tenant ID")}</label>
                <input
                  id="tenant-id"
                  name="tenantId"
                  type="text"
                  required
                  autocomplete="off"
                  spellcheck={false}
                />
              </div>
            )}

            <div class="auth-field">
              <label for="login-identifier">
                {tx("recovery", "Login identifier")}
              </label>
              <input
                id="login-identifier"
                name="loginIdentifier"
                type="text"
                required
                autocomplete="username"
                spellcheck={false}
              />
            </div>

            {turnstileActive && turnstileSiteKey && (
              <div
                class="cf-turnstile auth-turnstile"
                data-sitekey={turnstileSiteKey}
                data-action={PASSWORD_RESET_TURNSTILE_ACTION}
              />
            )}

            <button type="submit" id="forgot-submit" class="auth-submit">
              {tx("recovery", "Send reset link")}
            </button>
          </form>

          <p id="forgot-notice" class="auth-notice" role="status" hidden></p>

          <nav
            class="auth-links"
            aria-label={tx("recovery", "Account recovery")}
          >
            <a href="/login">{tx("recovery", "Back to sign in")}</a>
          </nav>

          <p class="auth-foot">
            {tx("recovery", "Secured workspace access")} · AWCMS
          </p>
        </div>
      </div>
    </main>

    {turnstileActive && turnstileSiteKey && (
      <script
        is:inline
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer
      />
    )}

    <script>
      // The import is deliberate — it forces Astro to bundle this script to an
      // external file (an import-free script would be inlined, and inline
      // scripts are blocked by this app's CSP). See admin-form-client.ts.
      import { lockElement, onSubmit } from "../lib/ui/admin-form-client";

      const errorBox = document.getElementById("forgot-error");
      const noticeBox = document.getElementById("forgot-notice");
      // Server-translated messages (ADR-0095), rendered as data-msg-* on the
      // form. No English literals here: they would only add client weight.
      const messages = document.getElementById("forgot-form")?.dataset ?? {};

      function reveal(element: HTMLElement | null, message: string): void {
        if (!element) return;
        element.textContent = message;
        element.hidden = false;
      }

      // `onSubmit` owns the single-flight guard (#1224): a second submit while
      // this handler is pending is ignored, released on ANY settled outcome so
      // a refused or expired Turnstile challenge still lets the person retry.
      onSubmit("forgot-form", async ({ form, data: formData, submit }) => {
        if (errorBox) errorBox.hidden = true;

        const tenantId = String(formData.get("tenantId") ?? "").trim();
        const loginIdentifier = String(
          formData.get("loginIdentifier") ?? ""
        ).trim();
        // Turnstile auto-injects this hidden field once solved; absent entirely
        // when the widget is not rendered, matching the server's optional field.
        const turnstileToken = formData.get("cf-turnstile-response");

        const unlock = submit
          ? lockElement(submit, messages.msgBusy ?? "")
          : () => {};

        try {
          const response = await fetch("/api/v1/auth/password/forgot", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-AWCMS-Tenant-ID": tenantId
            },
            credentials: "same-origin",
            body: JSON.stringify({
              loginIdentifier,
              ...(turnstileToken ? { turnstileToken } : {})
            })
          });

          const payload = await response.json().catch(() => null);

          if (!response.ok || !payload || payload.success !== true) {
            // Caller-side problems only (rate limit, Turnstile, malformed
            // input). Nothing here can distinguish "no such account", because
            // the server never returns that.
            reveal(
              errorBox,
              response.status === 429
                ? (messages.msgRateLimited ?? "")
                : (messages.msgFailed ?? "")
            );
            unlock();
            return;
          }

          // One post-submit state: a fixed sentence in the page's language. It
          // is the server's own generic message translated, so it still says
          // nothing about whether the identifier matched an account.
          form.hidden = true;
          reveal(noticeBox, messages.msgSent ?? "");
        } catch {
          reveal(errorBox, messages.msgNetwork ?? "");
          unlock();
        }
      });
    </script>
  </body>
</html>
