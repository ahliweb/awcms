---
/**
 * Password recovery request page (Wave 2 delta auth, adapted from awcms-micro
 * Issue #496). Posts `{ loginIdentifier }` plus the tenant header to
 * `POST /api/v1/auth/password/forgot` and shows ONE fixed confirmation
 * afterwards.
 *
 * ## The UI keeps the endpoint's promise
 *
 * The endpoint is account-enumeration-safe: it returns the same 200 body
 * whether or not the identifier matched anything. A page that rendered a
 * different state for "sent" than for "not found" would hand that guarantee
 * straight back, so this one has exactly one post-submit state — the form is
 * replaced by the server's own generic message, on any 2xx. It also does not
 * pre-check the identifier against anything.
 *
 * Rate limiting (429) and Turnstile rejections DO surface, because they are
 * properties of the CALLER, not of whether an account exists.
 *
 * ## Stable DOM contract (do not rename — E2E specs depend on these)
 *
 * `#forgot-form`, `#tenant-id`, `#login-identifier`, `#forgot-submit`,
 * `#forgot-error`, `#forgot-notice`. The tenant field always carries
 * `name="tenantId"` and id `#tenant-id` in all three picker shapes, exactly as
 * on `/login`, so the submit can always read it.
 *
 * ## CSP (strict, single-owner)
 *
 * Same rules as `/login`: `tokens.css`/`motion.css`/`auth.css` are external
 * same-origin stylesheets, the client script is Astro-BUNDLED (the `import` is
 * what forces that — an import-free script would be inlined and blocked), and
 * the only third-party origin is Cloudflare's Turnstile loader, and only when
 * the deployment profile actually requires it.
 */
import "../styles/tokens.css";
import "../styles/motion.css";
import "../styles/auth.css";
import {
  isTurnstileRequired,
  resolveTurnstileSiteKey,
  PASSWORD_RESET_TURNSTILE_ACTION
} from "../lib/security/turnstile";
import { loadTenantPickerModel } from "../modules/tenant-admin/application/tenant-picker-directory";
import AuthBrandPanel from "../components/AuthBrandPanel.astro";

const turnstileActive = isTurnstileRequired();
const turnstileSiteKey = turnstileActive ? resolveTurnstileSiteKey() : null;

// Same picker as `/login`, from the same shared reader — recovery has to land
// the user in the tenant they will then sign in to.
const picker = await loadTenantPickerModel();
const tenantOptions = picker.options;
const tenantPickerMode = picker.mode;
const singleTenant = tenantPickerMode === "single" ? tenantOptions[0]! : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Reset your password · AWCMS</title>
  </head>
  <body class="auth-body">
    <main class="auth">
      <AuthBrandPanel
        headline="Locked out? A reset link is one step away."
        subline="We send a single-use link to the address on file. Nothing about your account changes until you use it."
      />
      <div class="auth-form-panel">
        <div class="auth-card">
          <div class="auth-head">
            <div class="auth-brand">
              <span class="auth-mark" aria-hidden="true">A</span>
              <span class="auth-wordmark">AWCMS</span>
            </div>
            <h1 class="auth-title">Reset your password</h1>
            <p class="auth-subtitle">
              Enter the identifier you sign in with. If it belongs to an
              account, we'll email a link to set a new password.
            </p>
          </div>

          <form id="forgot-form" class="auth-form" novalidate>
            <p id="forgot-error" class="auth-error" role="alert" hidden></p>

            {
              singleTenant && (
                <div class="auth-tenant-context">
                  <span class="auth-tenant-context-label">Recovering for</span>
                  <span class="auth-tenant-context-name">
                    {singleTenant.name}
                  </span>
                  <input
                    id="tenant-id"
                    name="tenantId"
                    type="hidden"
                    value={singleTenant.id}
                  />
                </div>
              )
            }

            {
              tenantPickerMode === "select" && (
                <div class="auth-field">
                  <label for="tenant-id">Organization</label>
                  <div class="auth-select">
                    <select
                      id="tenant-id"
                      name="tenantId"
                      required
                      autocomplete="organization"
                    >
                      <option value="" disabled selected>
                        Choose your organization
                      </option>
                      {tenantOptions.map((tenant) => (
                        <option value={tenant.id}>{tenant.name}</option>
                      ))}
                    </select>
                  </div>
                </div>
              )
            }

            {
              tenantPickerMode === "manual" && (
                <div class="auth-field">
                  <label for="tenant-id">Tenant ID</label>
                  <input
                    id="tenant-id"
                    name="tenantId"
                    type="text"
                    required
                    autocomplete="off"
                    spellcheck={false}
                  />
                </div>
              )
            }

            <div class="auth-field">
              <label for="login-identifier">Login identifier</label>
              <input
                id="login-identifier"
                name="loginIdentifier"
                type="text"
                required
                autocomplete="username"
                spellcheck={false}
              />
            </div>

            {
              turnstileActive && turnstileSiteKey && (
                <div
                  class="cf-turnstile auth-turnstile"
                  data-sitekey={turnstileSiteKey}
                  data-action={PASSWORD_RESET_TURNSTILE_ACTION}
                />
              )
            }

            <button type="submit" id="forgot-submit" class="auth-submit">
              Send reset link
            </button>
          </form>

          <p id="forgot-notice" class="auth-notice" role="status" hidden></p>

          <nav class="auth-links" aria-label="Account recovery">
            <a href="/login">Back to sign in</a>
          </nav>

          <p class="auth-foot">Secured workspace access · AWCMS</p>
        </div>
      </div>
    </main>

    {
      turnstileActive && turnstileSiteKey && (
        <script
          is:inline
          src="https://challenges.cloudflare.com/turnstile/v0/api.js"
          async
          defer
        />
      )
    }

    <script>
      // The import is deliberate — it forces Astro to bundle this script to an
      // external file (an import-free script would be inlined, and inline
      // scripts are blocked by this app's CSP). See admin-form-client.ts.
      import { lockElement } from "../lib/ui/admin-form-client";

      const form = document.getElementById(
        "forgot-form"
      ) as HTMLFormElement | null;
      const errorBox = document.getElementById("forgot-error");
      const noticeBox = document.getElementById("forgot-notice");
      const submitButton = document.getElementById(
        "forgot-submit"
      ) as HTMLButtonElement | null;

      function reveal(element: HTMLElement | null, message: string): void {
        if (!element) return;
        element.textContent = message;
        element.hidden = false;
      }

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!submitButton || submitButton.disabled) return;
        if (errorBox) errorBox.hidden = true;

        const formData = new FormData(form);
        const tenantId = String(formData.get("tenantId") ?? "").trim();
        const loginIdentifier = String(
          formData.get("loginIdentifier") ?? ""
        ).trim();
        // Turnstile auto-injects this hidden field once solved; absent entirely
        // when the widget is not rendered, matching the server's optional field.
        const turnstileToken = formData.get("cf-turnstile-response");

        const unlock = lockElement(submitButton, "Please wait…");

        try {
          const response = await fetch("/api/v1/auth/password/forgot", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-AWCMS-Tenant-ID": tenantId
            },
            credentials: "same-origin",
            body: JSON.stringify({
              loginIdentifier,
              ...(turnstileToken ? { turnstileToken } : {})
            })
          });

          const payload = await response.json().catch(() => null);

          if (!response.ok || !payload || payload.success !== true) {
            // Caller-side problems only (rate limit, Turnstile, malformed
            // input). Nothing here can distinguish "no such account", because
            // the server never returns that.
            reveal(
              errorBox,
              response.status === 429
                ? "Too many requests. Please wait a few minutes and try again."
                : "Could not send the reset link. Check your details and try again."
            );
            unlock();
            return;
          }

          // One post-submit state, taken from the server's own generic message.
          form.hidden = true;
          reveal(
            noticeBox,
            payload.data?.message ??
              "If an account exists for that identifier, password reset instructions have been sent."
          );
        } catch {
          reveal(errorBox, "Network error. Please try again.");
          unlock();
        }
      });
    </script>
  </body>
</html>
