---
/**
 * Login page (Issue #166 — ported from awcms-mini's `login.astro`; redesigned
 * into a modern, mobile-first auth screen by the UI/UX overhaul phase 2).
 * POSTs to `POST /api/v1/auth/login`, which sets the two httpOnly SSR session
 * cookies (`src/lib/auth/ssr-session.ts`) the `/admin` guard in
 * `src/middleware.ts` then consumes.
 *
 * ## Stable DOM contract (do not rename — E2E specs + client script depend on
 * these): `#login-form`, `#tenant-id`, `#login-identifier`, `#password`,
 * `#login-submit`, `#login-error`. The tenant field ALWAYS carries
 * `name="tenantId"` and id `#tenant-id` regardless of which of the three
 * shapes below it takes, so `String(formData.get("tenantId"))` in the client
 * script keeps working and the submit still sends the `X-AWCMS-Tenant-ID`
 * header. `<select>` and `<input>` both expose `.value` via `FormData`.
 *
 * ## Auto tenant picker (UI/UX phase 2)
 * The manual "paste a UUID" field is a poor experience, so this page reads the
 * active tenant registry SERVER-SIDE (SSR frontmatter) — `awcms_tenants` is the
 * root table, deliberately WITHOUT RLS (see `sql/017`), so it is queried on the
 * app connection with NO tenant context (there is none yet — the user has not
 * picked one). Only `id` + `tenant_name` of `status = 'active'` rows are read,
 * nothing sensitive. The shape adapts to the count:
 *   - 0 rows (pre-setup) OR any DB error (placeholder `DATABASE_URL`, not
 *     migrated, breaker open) → the original manual TEXT `#tenant-id` input,
 *     preserving backward-compatibility and the zero-fixture E2E render path.
 *   - exactly 1 → a HIDDEN `#tenant-id` prefilled with that tenant's id plus a
 *     read-only "Signing in to <name>" readout; the user types nothing.
 *   - 2..TENANT_PICKER_LIMIT → a `<select id="tenant-id">` of tenant NAMES
 *     (value = UUID).
 *   - more than TENANT_PICKER_LIMIT → fall back to the manual input rather than
 *     render a huge public dropdown (bounds the query AND avoids mass tenant
 *     enumeration; a deployment with that many tenants resolves the tenant by
 *     domain, not by asking the user to scroll a list).
 * Rendering tenant names to an unauthenticated visitor when count > 1 is an
 * accepted product decision for this base repo's small multi-tenant dev
 * setups; the query is capped and read-only.
 *
 * ## Cloudflare Turnstile (Issue #186)
 * The widget and its loader render ONLY when `isTurnstileRequired()` (the
 * full-online deployment-profile gate AND `TURNSTILE_ENABLED=true`). Every
 * local/offline/LAN deployment (the default) renders no `cf-turnstile` div and
 * no `challenges.cloudflare.com` script. When required, the middleware CSP
 * opens `script-src`/`frame-src` for that one Cloudflare origin
 * (`src/lib/security/security-headers.ts`) and the external loader is an
 * explicit `is:inline` `<script src>`. `TURNSTILE_SITE_KEY` is public;
 * `TURNSTILE_SECRET_KEY` is server-side only and never reaches this page.
 *
 * ## CSP (strict, single-owner)
 * `default-src 'self'` with NO `'unsafe-inline'`. Everything on this page obeys
 * it: `tokens.css`/`motion.css`/`auth.css` are all
 * emitted as external same-origin `<link>`s (`build.inlineStylesheets:
 * "never"`, see astro.config.mjs), the login client is an Astro-BUNDLED module
 * script (not `is:inline`), animations are pure CSS, and no third-party origin
 * (font CDN / library) is referenced. Non-essential motion degrades under
 * `@media (prefers-reduced-motion: reduce)`.
 */
import "../styles/tokens.css";
import "../styles/motion.css";
import "../styles/auth.css";
import {
  isTurnstileRequired,
  resolveTurnstileSiteKey,
  LOGIN_TURNSTILE_ACTION
} from "../lib/security/turnstile";
import { loadTenantPickerModel } from "../modules/tenant-admin/application/tenant-picker-directory";
import AuthBrandPanel from "../components/AuthBrandPanel.astro";
import { resolveProductIdentity } from "../lib/product-identity";
import { getTranslatorFor } from "../lib/i18n";
import { resolveAuthPageLocale } from "../lib/i18n/auth-page-locale";
import {
  resolveChallengeTtlSec,
  resolveMfaMaxVerifyAttempts
} from "../lib/auth/mfa-config";

const turnstileActive = isTurnstileRequired();
const turnstileSiteKey = turnstileActive ? resolveTurnstileSiteKey() : null;

// --- Auto tenant picker (read-only SSR read of the root tenant registry) ---
// Shared with `/forgot-password` — the cap, the status filter, and the
// degrade-to-manual behaviour all live in `tenant-picker-directory.ts`.
const picker = await loadTenantPickerModel();
const tenantOptions = picker.options;
const tenantPickerMode = picker.mode;
const singleTenant = tenantPickerMode === "single" ? tenantOptions[0]! : null;

// Language (ADR-0095): cookie -> tenant default -> Accept-Language -> en. The
// tenant default is consulted ONLY for the single-tenant deployment, whose
// name this page already prints — never for a tenant the visitor picked or
// typed, which would turn the page language into a tenant-existence oracle
// (`src/lib/i18n/auth-page-locale.ts`).
const locale = await resolveAuthPageLocale({
  cookies: Astro.cookies,
  request: Astro.request,
  tenantId: singleTenant?.id ?? null
});
const { tx } = getTranslatorFor(locale);

// The client script cannot translate (the catalogue is a server module), so
// every message it may show arrives as a `data-msg-*` attribute. The two
// failure messages are fixed sentences: neither varies with whether the
// account exists, in any language.
const formMessages = {
  "data-msg-failed": tx(
    "login",
    "Sign in failed. Check your details and try again."
  ),
  "data-msg-network": tx("login", "Network error. Please try again."),
  "data-msg-busy": tx("login", "Please wait…"),
  "data-msg-show": tx("login", "Show"),
  "data-msg-hide": tx("login", "Hide"),
  "data-msg-show-password": tx("login", "Show password"),
  "data-msg-hide-password": tx("login", "Hide password"),
  "data-msg-mfa-failed": tx(
    "login",
    "That code was not accepted. Check it and try again."
  ),
  "data-msg-mfa-restart": tx(
    "login",
    "Verification could not be completed. Sign in again."
  ),
  "data-msg-mfa-use-recovery": tx("login", "Use a recovery code instead"),
  "data-msg-mfa-use-code": tx("login", "Use an authenticator code instead"),
  "data-msg-mfa-label-code": tx("login", "Authentication code"),
  "data-msg-mfa-label-recovery": tx("login", "Recovery code"),
  "data-msg-enrol-qr-label": tx(
    "login",
    "QR code for your authenticator app. If you cannot scan it, type the key shown below into the app instead."
  ),
  // Server configuration, rendered so the page never needs a refusal reason
  // to know when a challenge is spent (anti-oracle, #1365).
  "data-mfa-ttl-sec": String(resolveChallengeTtlSec()),
  "data-mfa-max-attempts": String(resolveMfaMaxVerifyAttempts())
};

// Issue #1352: deployment product identity (default = "AWCMS").
const identity = resolveProductIdentity(process.env);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{tx("login", "Sign in")} · {identity.productName}</title>
  </head>
  <body class="auth-body">
    <main class="auth">
      <AuthBrandPanel locale={locale} />
      <div class="auth-form-panel">
        <div class="auth-card">
          <div class="auth-head">
            <div class="auth-brand">
              <span class="auth-mark" aria-hidden="true">
                {identity.mark}
              </span>
              <span class="auth-wordmark">{identity.wordmark}</span>
            </div>
            <h1 class="auth-title">{tx("login", "Sign in")}</h1>
            <p class="auth-subtitle">
              {tx("login", "Welcome back. Sign in to your workspace.")}
            </p>
          </div>

          <form id="login-form" class="auth-form" novalidate {...formMessages}>
            <p id="login-error" class="auth-error" role="alert" hidden></p>

            {singleTenant && (
              <div class="auth-tenant-context">
                <span class="auth-tenant-context-label">
                  {tx("login", "Signing in to")}
                </span>
                <span class="auth-tenant-context-name">
                  {singleTenant.name}
                </span>
                <input
                  id="tenant-id"
                  name="tenantId"
                  type="hidden"
                  value={singleTenant.id}
                />
              </div>
            )}

            {tenantPickerMode === "select" && (
              <div class="auth-field">
                <label for="tenant-id">{tx("login", "Organization")}</label>
                <div class="auth-select">
                  <select
                    id="tenant-id"
                    name="tenantId"
                    required
                    autocomplete="organization"
                  >
                    <option value="" disabled selected>
                      {tx("login", "Choose your organization")}
                    </option>
                    {tenantOptions.map((tenant) => (
                      <option value={tenant.id}>{tenant.name}</option>
                    ))}
                  </select>
                </div>
              </div>
            )}

            {tenantPickerMode === "manual" && (
              <div class="auth-field">
                <label for="tenant-id">{tx("login", "Tenant ID")}</label>
                <input
                  id="tenant-id"
                  name="tenantId"
                  type="text"
                  required
                  autocomplete="off"
                  spellcheck={false}
                />
              </div>
            )}

            <div class="auth-field">
              <label for="login-identifier">
                {tx("login", "Login identifier")}
              </label>
              <input
                id="login-identifier"
                name="loginIdentifier"
                type="text"
                required
                autocomplete="username"
                spellcheck={false}
              />
            </div>

            <div class="auth-field">
              <label for="password">{tx("login", "Password")}</label>
              <div class="auth-password">
                <input
                  id="password"
                  name="password"
                  type="password"
                  required
                  autocomplete="current-password"
                />
                <button
                  type="button"
                  id="password-toggle"
                  class="auth-password-toggle"
                  aria-pressed="false"
                  aria-label={tx("login", "Show password")}
                >
                  <span class="auth-password-toggle-label">
                    {tx("login", "Show")}
                  </span>
                </button>
              </div>
            </div>

            {turnstileActive && turnstileSiteKey && (
              <div
                class="cf-turnstile auth-turnstile"
                data-sitekey={turnstileSiteKey}
                data-action={LOGIN_TURNSTILE_ACTION}
              />
            )}

            <button type="submit" id="login-submit" class="auth-submit">
              {tx("login", "Sign in")}
            </button>
          </form>

          <form id="mfa-form" class="auth-form" novalidate hidden>
            <p class="auth-subtitle" id="mfa-intro">
              {tx(
                "login",
                "Enter the 6-digit code from your authenticator app to finish signing in."
              )}
            </p>
            <p id="mfa-error" class="auth-error" role="alert" hidden></p>
            <div class="auth-field">
              <label for="mfa-code" id="mfa-code-label">
                {tx("login", "Authentication code")}
              </label>
              <input
                id="mfa-code"
                name="code"
                type="text"
                required
                inputmode="numeric"
                autocomplete="one-time-code"
                maxlength="7"
                pattern="[0-9 ]*"
                spellcheck={false}
              />
            </div>
            <button type="submit" id="mfa-submit" class="auth-submit">
              {tx("login", "Verify")}
            </button>
            <div class="auth-links">
              <button type="button" id="mfa-toggle" class="auth-link-button">
                {tx("login", "Use a recovery code instead")}
              </button>
              <button type="button" id="mfa-back" class="auth-link-button">
                {tx("login", "Back to sign in")}
              </button>
            </div>
          </form>

          {/* Pre-session enrolment (#1425): a tenant policy requires a second
              factor and this person has none yet. The grant lives in script
              memory only; the secret is the QR plus the manual key, nothing
              else, and both are cleared when the step ends. */}
          <form id="enrol-form" class="auth-form" novalidate hidden>
            <p class="auth-subtitle" id="enrol-intro">
              {tx(
                "login",
                "Your organization requires two-factor authentication. Scan the QR code with an authenticator app, or type the key into it, then enter the 6-digit code it shows."
              )}
            </p>
            <p id="enrol-error" class="auth-error" role="alert" hidden></p>
            <div class="auth-qr" id="enrol-qr"></div>
            <p class="auth-secret">
              <span class="auth-secret-label" id="enrol-secret-label">
                {tx("login", "Key for your authenticator app")}
              </span>
              <code
                id="enrol-secret"
                aria-labelledby="enrol-secret-label"
              ></code>
            </p>
            <div class="auth-field">
              <label for="enrol-code">
                {tx("login", "Authentication code")}
              </label>
              <input
                id="enrol-code"
                name="code"
                type="text"
                required
                inputmode="numeric"
                autocomplete="one-time-code"
                maxlength="7"
                pattern="[0-9 ]*"
                spellcheck={false}
              />
            </div>
            <button type="submit" id="enrol-submit" class="auth-submit">
              {tx("login", "Confirm and finish")}
            </button>
            <div class="auth-links">
              <button type="button" id="enrol-back" class="auth-link-button">
                {tx("login", "Back to sign in")}
              </button>
            </div>
          </form>

          <section id="enrol-recovery" class="auth-form" hidden>
            <h2 class="auth-title" id="enrol-recovery-title" tabindex="-1">
              {tx("login", "Save your recovery codes")}
            </h2>
            <p class="auth-subtitle">
              {tx(
                "login",
                "Each code works once if you lose your authenticator app. They are shown only now: store them somewhere safe before you continue."
              )}
            </p>
            <ul class="auth-recovery-codes" id="enrol-recovery-list"></ul>
            <button type="button" id="enrol-continue" class="auth-submit">
              {tx("login", "Continue to your workspace")}
            </button>
          </section>

          <nav class="auth-links" aria-label={tx("login", "Account recovery")}>
            <a href="/forgot-password">
              {tx("login", "Forgot your password?")}
            </a>
          </nav>

          <p class="auth-foot">
            {tx("login", "Secured workspace access")} · {identity.productName}
          </p>
        </div>
      </div>
    </main>

    {turnstileActive && turnstileSiteKey && (
      <script
        is:inline
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer
      />
    )}

    <script>
      // The import is deliberate — it forces Astro to bundle this script to an
      // external file (an import-free script would be inlined, and inline
      // scripts are blocked by this app's CSP). See admin-form-client.ts.
      import {
        buildEnrolHeaders,
        buildEnrolVerifyBody,
        buildVerifyBody,
        createChallengeBudget,
        isPlausibleTotpCode,
        readEnrolStart,
        readEnrolVerify,
        readLoginOutcome,
        readVerifySuccess
      } from "../lib/ui/login-mfa-client";

      import {
        holdForNavigation,
        lockElement,
        onSubmit
      } from "../lib/ui/admin-form-client";

      const errorBox = document.getElementById("login-error");
      // Server-translated messages (ADR-0095), rendered as data-msg-* on the
      // form. No English literals here: they would only add client weight.
      const messages = document.getElementById("login-form")?.dataset ?? {};

      // Password visibility toggle — pure enhancement, wired here (no inline
      // handler) so the strict CSP is respected. Absent-safe if the elements
      // are ever removed.
      const passwordInput = document.getElementById(
        "password"
      ) as HTMLInputElement | null;
      const passwordToggle = document.getElementById(
        "password-toggle"
      ) as HTMLButtonElement | null;
      const passwordToggleLabel = passwordToggle?.querySelector(
        ".auth-password-toggle-label"
      );

      passwordToggle?.addEventListener("click", () => {
        if (!passwordInput) return;
        const reveal = passwordInput.type === "password";
        passwordInput.type = reveal ? "text" : "password";
        passwordToggle.setAttribute("aria-pressed", String(reveal));
        passwordToggle.setAttribute(
          "aria-label",
          (reveal ? messages.msgHidePassword : messages.msgShowPassword) ?? ""
        );
        if (passwordToggleLabel) {
          passwordToggleLabel.textContent =
            (reveal ? messages.msgHide : messages.msgShow) ?? "";
        }
      });

      function showError(message: string): void {
        if (!errorBox) return;
        errorBox.textContent = message;
        errorBox.hidden = false;
      }

      // --- Second-factor step (#1365) -------------------------------------
      // The challenge token lives ONLY in these variables: never in storage,
      // the URL or the DOM. They are cleared when the step ends.
      const loginForm = document.getElementById("login-form");
      const mfaForm = document.getElementById("mfa-form");
      const mfaError = document.getElementById("mfa-error");
      const mfaCode = document.getElementById(
        "mfa-code"
      ) as HTMLInputElement | null;
      const mfaLabel = document.getElementById("mfa-code-label");
      const mfaToggle = document.getElementById("mfa-toggle");
      const mfaBack = document.getElementById("mfa-back");
      let challengeToken: string | null = null;
      let challengeTenant = "";
      let budget: ReturnType<typeof createChallengeBudget> | null = null;
      let recoveryMode = false;

      function showMfaError(message: string): void {
        if (!mfaError) return;
        mfaError.textContent = message;
        mfaError.hidden = false;
      }

      function setRecoveryMode(on: boolean): void {
        recoveryMode = on;
        if (mfaCode) {
          mfaCode.value = "";
          mfaCode.maxLength = on ? 64 : 7;
          mfaCode.inputMode = on ? "text" : "numeric";
          mfaCode.autocomplete = on ? "off" : "one-time-code";
          if (on) mfaCode.removeAttribute("pattern");
          else mfaCode.setAttribute("pattern", "[0-9 ]*");
        }
        if (mfaLabel) {
          mfaLabel.textContent =
            (on ? messages.msgMfaLabelRecovery : messages.msgMfaLabelCode) ??
            "";
        }
        if (mfaToggle) {
          mfaToggle.textContent =
            (on ? messages.msgMfaUseCode : messages.msgMfaUseRecovery) ?? "";
        }
        mfaCode?.focus();
      }

      function endMfaStep(restart: boolean): void {
        challengeToken = null;
        budget = null;
        if (mfaCode) mfaCode.value = "";
        if (mfaError) mfaError.hidden = true;
        recoveryMode = false;
        if (mfaForm) mfaForm.hidden = true;
        if (loginForm) loginForm.hidden = false;
        if (passwordInput) passwordInput.value = "";
        if (restart) showError(messages.msgMfaRestart ?? "");
        passwordInput?.focus();
      }

      function startMfaStep(token: string, tenantId: string): void {
        challengeToken = token;
        challengeTenant = tenantId;
        budget = createChallengeBudget(
          Number(messages.mfaTtlSec) || 300,
          Number(messages.mfaMaxAttempts) || 5
        );
        if (errorBox) errorBox.hidden = true;
        if (mfaError) mfaError.hidden = true;
        if (loginForm) loginForm.hidden = true;
        if (mfaForm) mfaForm.hidden = false;
        setRecoveryMode(false);
      }

      // --- Pre-session enrolment step (#1425) ------------------------------
      // The enrolment grant lives ONLY in these variables, like the challenge
      // token above: never in storage, the URL or the DOM. The TOTP secret is
      // rendered as the QR and the manual key the person needs, and nothing
      // else; both are wiped when the step ends or the page is left.
      const enrolForm = document.getElementById("enrol-form");
      const enrolError = document.getElementById("enrol-error");
      const enrolCode = document.getElementById(
        "enrol-code"
      ) as HTMLInputElement | null;
      const enrolBack = document.getElementById("enrol-back");
      const enrolRecovery = document.getElementById("enrol-recovery");
      const enrolRecoveryList = document.getElementById("enrol-recovery-list");
      const enrolContinue = document.getElementById("enrol-continue");
      const enrolTargets = { qrId: "enrol-qr", secretId: "enrol-secret" };
      let enrolToken: string | null = null;
      let enrolTenant = "";
      let enrolBudget: ReturnType<typeof createChallengeBudget> | null = null;
      let recoveryShown = false;

      // Drops the QR and the manual key. Local on purpose: the QR encoder is
      // loaded only when an enrolment actually starts (see `startEnrolStep`),
      // so clearing must not need it.
      function clearEnrolSecret(): void {
        document.getElementById(enrolTargets.qrId)?.replaceChildren();
        const secret = document.getElementById(enrolTargets.secretId);
        if (secret) secret.textContent = "";
      }

      function showEnrolError(message: string): void {
        if (!enrolError) return;
        enrolError.textContent = message;
        enrolError.hidden = false;
      }

      function endEnrolStep(restart: boolean): void {
        enrolToken = null;
        enrolBudget = null;
        clearEnrolSecret();
        if (enrolCode) enrolCode.value = "";
        if (enrolError) enrolError.hidden = true;
        if (enrolForm) enrolForm.hidden = true;
        if (loginForm) loginForm.hidden = false;
        if (passwordInput) passwordInput.value = "";
        if (restart) showError(messages.msgMfaRestart ?? "");
        passwordInput?.focus();
      }

      function showRecoveryCodes(codes: readonly string[]): void {
        clearEnrolSecret();
        enrolToken = null;
        enrolBudget = null;
        if (enrolForm) enrolForm.hidden = true;
        recoveryShown = codes.length > 0;
        if (!recoveryShown) {
          holdForNavigation();
          window.location.href = "/admin";
          return;
        }
        // `textContent`, never `innerHTML`.
        enrolRecoveryList?.replaceChildren(
          ...codes.map((code) => {
            const item = document.createElement("li");
            item.textContent = code;
            return item;
          })
        );
        if (enrolRecovery) enrolRecovery.hidden = false;
        document.getElementById("enrol-recovery-title")?.focus();
      }

      enrolBack?.addEventListener("click", () => endEnrolStep(false));
      enrolContinue?.addEventListener("click", () => {
        recoveryShown = false;
        enrolRecoveryList?.replaceChildren();
        holdForNavigation();
        window.location.href = "/admin";
      });
      window.addEventListener("pagehide", () => {
        if (enrolToken) endEnrolStep(false);
        if (recoveryShown) enrolRecoveryList?.replaceChildren();
      });
      window.addEventListener("pageshow", (event) => {
        // Back/forward cache restored the page after its recovery codes were
        // wiped: the session already exists, so go on rather than show a blank
        // panel.
        if (event.persisted && recoveryShown) window.location.href = "/admin";
      });

      /** Starts enrolment; true when the secret is on screen. */
      async function startEnrolStep(
        token: string,
        tenantId: string
      ): Promise<boolean> {
        const response = await fetch("/api/v1/auth/mfa/totp/enroll/start", {
          method: "POST",
          headers: buildEnrolHeaders(tenantId, token),
          credentials: "same-origin",
          body: "{}"
        });
        const started = readEnrolStart(
          response.ok,
          await response.json().catch(() => null)
        );
        if (!started) return false;

        // The QR encoder is a separate chunk, fetched here and not on the
        // initial `/login` load: almost every visit never enrols. A failed
        // fetch throws to the caller, which returns to the password step.
        const { renderEnrolmentQr } = await import("../lib/ui/enrolment-qr");

        enrolToken = token;
        enrolTenant = tenantId;
        enrolBudget = createChallengeBudget(
          Number(messages.mfaTtlSec) || 300,
          Number(messages.mfaMaxAttempts) || 5
        );
        renderEnrolmentQr(
          document,
          started.otpauthUri,
          messages.msgEnrolQrLabel ?? "",
          enrolTargets
        );
        const secret = document.getElementById("enrol-secret");
        if (secret) secret.textContent = started.secret;
        if (errorBox) errorBox.hidden = true;
        if (enrolError) enrolError.hidden = true;
        if (loginForm) loginForm.hidden = true;
        if (enrolForm) enrolForm.hidden = false;
        enrolCode?.focus();
        return true;
      }

      mfaToggle?.addEventListener("click", () =>
        setRecoveryMode(!recoveryMode)
      );
      mfaBack?.addEventListener("click", () => endMfaStep(false));

      // `onSubmit` owns the single-flight guard (#1224): a second submit —
      // click, double tap or Enter — while this handler is pending is ignored,
      // and it is released on ANY settled outcome, so a refused or expired
      // Turnstile challenge still lets the person retry.
      onSubmit("login-form", async ({ data: formData, submit }) => {
        const unlock = submit
          ? lockElement(submit, messages.msgBusy ?? "")
          : () => {};

        if (errorBox) errorBox.hidden = true;

        const tenantId = String(formData.get("tenantId") ?? "").trim();
        const loginIdentifier = String(
          formData.get("loginIdentifier") ?? ""
        ).trim();
        const password = String(formData.get("password") ?? "");
        // Cloudflare Turnstile (Issue #186) auto-injects a hidden
        // `cf-turnstile-response` field into this form once solved — absent
        // entirely when the widget is not rendered (Turnstile not required for
        // this deployment), matching the server's own optional field.
        const turnstileToken = formData.get("cf-turnstile-response");

        try {
          const response = await fetch("/api/v1/auth/login", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-AWCMS-Tenant-ID": tenantId
            },
            credentials: "same-origin",
            body: JSON.stringify({
              loginIdentifier,
              password,
              ...(turnstileToken ? { turnstileToken } : {})
            })
          });

          const payload = await response.json().catch(() => null);

          const outcome = readLoginOutcome(response.ok, payload);

          if (outcome.kind === "mfa") {
            startMfaStep(outcome.challengeToken, tenantId);
            unlock();
            return;
          }

          if (outcome.kind === "enrol") {
            // Any refusal of the start (expired or spent grant, deployment
            // switch off, rate limit) is the same way back to the password
            // step: the page does not read why.
            let started = false;
            try {
              started = await startEnrolStep(outcome.enrolmentToken, tenantId);
            } catch {
              // Network failure or the lazy chunk did not load: the grant was
              // never stored, so there is nothing to clear.
              started = false;
            }
            if (started) {
              unlock();
              return;
            }
            enrolToken = null;
            showError(messages.msgMfaRestart ?? "");
            unlock();
            return;
          }

          if (outcome.kind !== "success") {
            // Generic message only — the server deliberately collapses every
            // deny reason so the UI must not reconstruct a specific one, and it
            // must never surface internal detail (Issue #540).
            showError(messages.msgFailed ?? "");
            unlock();
            return;
          }

          // Navigating away — leave the form locked so it can't be re-submitted
          // during the redirect (released again by a bfcache `pageshow`).
          holdForNavigation();
          window.location.href = "/admin";
        } catch {
          showError(messages.msgNetwork ?? "");
          unlock();
        }
      });

      onSubmit("enrol-form", async ({ submit }) => {
        if (!enrolToken || !enrolBudget || !enrolCode) return;
        const unlock = submit
          ? lockElement(submit, messages.msgBusy ?? "")
          : () => {};
        if (enrolError) enrolError.hidden = true;

        if (!isPlausibleTotpCode(enrolCode.value)) {
          showEnrolError(messages.msgMfaFailed ?? "");
          unlock();
          enrolCode.focus();
          return;
        }

        try {
          const response = await fetch("/api/v1/auth/mfa/totp/enroll/verify", {
            method: "POST",
            headers: buildEnrolHeaders(enrolTenant, enrolToken),
            credentials: "same-origin",
            body: JSON.stringify(buildEnrolVerifyBody(enrolCode.value))
          });
          const done = readEnrolVerify(
            response.ok,
            await response.json().catch(() => null)
          );

          if (done) {
            // The session cookies are set; the grant is spent.
            showRecoveryCodes(done.recoveryCodes);
            unlock();
            return;
          }

          enrolBudget.recordFailure();
          unlock();
          if (enrolBudget.exhausted()) {
            endEnrolStep(true);
            return;
          }
          showEnrolError(messages.msgMfaFailed ?? "");
          enrolCode.value = "";
          enrolCode.focus();
        } catch {
          showEnrolError(messages.msgNetwork ?? "");
          unlock();
        }
      });

      onSubmit("mfa-form", async ({ submit }) => {
        if (!challengeToken || !budget || !mfaCode) return;
        const unlock = submit
          ? lockElement(submit, messages.msgBusy ?? "")
          : () => {};
        if (mfaError) mfaError.hidden = true;

        const value = mfaCode.value;
        const plausible = recoveryMode
          ? value.trim().length > 0
          : isPlausibleTotpCode(value);
        if (!plausible) {
          showMfaError(messages.msgMfaFailed ?? "");
          unlock();
          mfaCode.focus();
          return;
        }

        try {
          const response = await fetch("/api/v1/auth/mfa/totp/verify", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-AWCMS-Tenant-ID": challengeTenant
            },
            credentials: "same-origin",
            body: JSON.stringify(
              buildVerifyBody(challengeToken, value, recoveryMode)
            )
          });
          const payload = await response.json().catch(() => null);

          if (readVerifySuccess(response.ok, payload)) {
            challengeToken = null;
            holdForNavigation();
            window.location.href = "/admin";
            return;
          }

          budget.recordFailure();
          unlock();
          if (budget.exhausted()) {
            endMfaStep(true);
            return;
          }
          showMfaError(messages.msgMfaFailed ?? "");
          mfaCode.value = "";
          mfaCode.focus();
        } catch {
          showMfaError(messages.msgNetwork ?? "");
          unlock();
        }
      });
    </script>
  </body>
</html>
