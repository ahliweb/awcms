---
/**
 * Public self-registration page (Wave 2 delta auth). Posts
 * `{ displayName, loginIdentifier }` plus the tenant header to
 * `POST /api/v1/auth/register`.
 *
 * ## No password field, deliberately
 *
 * The account is created at APPROVAL with an unusable credential and the
 * applicant sets their own password from an emailed link. So there is nothing
 * to collect here, nothing to confirm, and no secret from an unverified
 * stranger for this system to store. See `sql/074`'s header.
 *
 * ## One post-submit state
 *
 * The endpoint answers identically whether the address is new, already
 * registered, or already pending. A page that distinguished them would hand
 * back the account-enumeration guarantee the endpoint exists to keep, so the
 * form is replaced by the server's own generic message on any 2xx.
 *
 * ## Off by default
 *
 * `AUTH_SELF_REGISTRATION_ENABLED` gates the whole flow; when off, this renders
 * a neutral "not available" card rather than a form that would 404 on submit.
 *
 * Stable DOM contract (do not rename — E2E specs depend on these):
 * `#register-form`, `#tenant-id`, `#display-name`, `#login-identifier`,
 * `#register-submit`, `#register-error`, `#register-notice`.
 */
import "../styles/tokens.css";
import "../styles/motion.css";
import "../styles/auth.css";
import { isSelfRegistrationEnabled } from "../lib/auth/self-registration-config";
import {
  isTurnstileRequired,
  resolveTurnstileSiteKey,
  REGISTER_TURNSTILE_ACTION
} from "../lib/security/turnstile";
import { loadTenantPickerModel } from "../modules/tenant-admin/application/tenant-picker-directory";

const enabled = isSelfRegistrationEnabled();
const turnstileActive = enabled && isTurnstileRequired();
const turnstileSiteKey = turnstileActive ? resolveTurnstileSiteKey() : null;

// Only read the tenant registry when the feature is on — a disabled deployment
// should not run a query to render a static notice.
const picker = enabled
  ? await loadTenantPickerModel()
  : { mode: "manual" as const, options: [] };
const tenantOptions = picker.options;
const tenantPickerMode = picker.mode;
const singleTenant = tenantPickerMode === "single" ? tenantOptions[0]! : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Request access · AWCMS</title>
  </head>
  <body class="auth-body">
    <main class="auth">
      <div class="auth-card">
        <div class="auth-head">
          <div class="auth-brand">
            <span class="auth-mark" aria-hidden="true">A</span>
            <span class="auth-wordmark">AWCMS</span>
          </div>
          <h1 class="auth-title">Request access</h1>
          <p class="auth-subtitle">
            {
              enabled
                ? "Tell us who you are. An administrator reviews every request; you'll get an email to set your password once you're approved."
                : "Self-registration is not available on this site."
            }
          </p>
        </div>

        {
          enabled && (
            <>
              <form id="register-form" class="auth-form" novalidate>
                <p id="register-error" class="auth-error" role="alert" hidden />

                {singleTenant && (
                  <div class="auth-tenant-context">
                    <span class="auth-tenant-context-label">
                      Requesting for
                    </span>
                    <span class="auth-tenant-context-name">
                      {singleTenant.name}
                    </span>
                    <input
                      id="tenant-id"
                      name="tenantId"
                      type="hidden"
                      value={singleTenant.id}
                    />
                  </div>
                )}

                {tenantPickerMode === "select" && (
                  <div class="auth-field">
                    <label for="tenant-id">Organization</label>
                    <div class="auth-select">
                      <select
                        id="tenant-id"
                        name="tenantId"
                        required
                        autocomplete="organization"
                      >
                        <option value="" disabled selected>
                          Choose your organization
                        </option>
                        {tenantOptions.map((tenant) => (
                          <option value={tenant.id}>{tenant.name}</option>
                        ))}
                      </select>
                    </div>
                  </div>
                )}

                {tenantPickerMode === "manual" && (
                  <div class="auth-field">
                    <label for="tenant-id">Tenant ID</label>
                    <input
                      id="tenant-id"
                      name="tenantId"
                      type="text"
                      required
                      autocomplete="off"
                      spellcheck={false}
                    />
                  </div>
                )}

                <div class="auth-field">
                  <label for="display-name">Your name</label>
                  <input
                    id="display-name"
                    name="displayName"
                    type="text"
                    required
                    autocomplete="name"
                    maxlength="120"
                  />
                </div>

                <div class="auth-field">
                  <label for="login-identifier">Email address</label>
                  <input
                    id="login-identifier"
                    name="loginIdentifier"
                    type="email"
                    required
                    autocomplete="email"
                    spellcheck={false}
                    maxlength="320"
                  />
                  <p class="auth-hint">
                    This becomes your sign-in identifier, and where the approval
                    email goes.
                  </p>
                </div>

                {turnstileActive && turnstileSiteKey && (
                  <div
                    class="cf-turnstile auth-turnstile"
                    data-sitekey={turnstileSiteKey}
                    data-action={REGISTER_TURNSTILE_ACTION}
                  />
                )}

                <button type="submit" id="register-submit" class="auth-submit">
                  Send request
                </button>
              </form>

              <p
                id="register-notice"
                class="auth-notice"
                role="status"
                hidden
              />
            </>
          )
        }

        <nav class="auth-links" aria-label="Account">
          <a href="/login">Back to sign in</a>
        </nav>

        <p class="auth-foot">Secured workspace access · AWCMS</p>
      </div>
    </main>

    {
      turnstileActive && turnstileSiteKey && (
        <script
          is:inline
          src="https://challenges.cloudflare.com/turnstile/v0/api.js"
          async
          defer
        />
      )
    }

    <script>
      // The import is deliberate — it forces Astro to bundle this script to an
      // external file (an import-free script would be inlined, and inline
      // scripts are blocked by this app's CSP). See admin-form-client.ts.
      import { lockElement } from "../lib/ui/admin-form-client";

      const form = document.getElementById(
        "register-form"
      ) as HTMLFormElement | null;
      const errorBox = document.getElementById("register-error");
      const noticeBox = document.getElementById("register-notice");
      const submitButton = document.getElementById(
        "register-submit"
      ) as HTMLButtonElement | null;

      function reveal(element: HTMLElement | null, message: string): void {
        if (!element) return;
        element.textContent = message;
        element.hidden = false;
      }

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!submitButton || submitButton.disabled) return;
        if (errorBox) errorBox.hidden = true;

        const formData = new FormData(form);
        const tenantId = String(formData.get("tenantId") ?? "").trim();
        const displayName = String(formData.get("displayName") ?? "").trim();
        const loginIdentifier = String(
          formData.get("loginIdentifier") ?? ""
        ).trim();
        const turnstileToken = formData.get("cf-turnstile-response");

        const unlock = lockElement(submitButton, "Please wait…");

        try {
          const response = await fetch("/api/v1/auth/register", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-AWCMS-Tenant-ID": tenantId
            },
            credentials: "same-origin",
            body: JSON.stringify({
              displayName,
              loginIdentifier,
              ...(turnstileToken ? { turnstileToken } : {})
            })
          });

          const payload = await response.json().catch(() => null);

          if (!response.ok || !payload || payload.success !== true) {
            // Caller-side problems only. Nothing here distinguishes "already
            // registered" from "new" — the server never says.
            reveal(
              errorBox,
              response.status === 429
                ? "Too many requests. Please wait a few minutes and try again."
                : "Could not send your request. Check your details and try again."
            );
            unlock();
            return;
          }

          form.hidden = true;
          reveal(
            noticeBox,
            payload.data?.message ??
              "Thanks — if this address can register, your request is now awaiting review."
          );
        } catch {
          reveal(errorBox, "Network error. Please try again.");
          unlock();
        }
      });
    </script>
  </body>
</html>
