---
/**
 * Password reset completion page (Wave 2 delta auth, adapted from awcms-micro
 * Issue #496). Posts `{ token, newPassword }` plus the tenant header to
 * `POST /api/v1/auth/password/reset`.
 *
 * ## Where the token and tenant come from
 *
 * The link `forgot.ts` emails is either the sealed shape `?p=<opaque>` (when
 * `AUTH_URL_PARAM_ENCRYPTION_KEY` is set — token + tenant sealed together with
 * AES-256-GCM) or the plain `?token=…&tenantId=…`. Unsealing happens SERVER-SIDE
 * in this frontmatter; the key never reaches the browser. A `?p=` that fails to
 * open — tampered, truncated, or encrypted under a rotated key — yields no
 * token, and the page renders its invalid-link state rather than silently
 * falling through to the plain-parameter branch, which is what would let a
 * tampered link be retried as an empty one.
 *
 * The completion endpoint is tenant-scoped (RLS) and requires the tenant header,
 * which is why the link carries the tenant at all. When it is missing (a link
 * from an older deployment, or manual navigation) a tenant field is shown so the
 * user can still complete the reset.
 *
 * Embedding the raw token in a hidden field is standard: it is already in the
 * user's own URL bar, it is single-use, and it is short-lived.
 *
 * ## Generic failure, mirroring the endpoint
 *
 * The API never distinguishes not-found from expired from already-used, so this
 * page shows one generic error for every rejection. Reconstructing a specific
 * reason in the UI would rebuild the oracle the endpoint deliberately removed.
 *
 * ## Stable DOM contract (do not rename — E2E specs depend on these)
 *
 * `#reset-form`, `#reset-token`, `#tenant-id`, `#new-password`,
 * `#confirm-password`, `#reset-submit`, `#reset-error`, `#reset-notice`.
 */
import "../styles/tokens.css";
import "../styles/motion.css";
import "../styles/auth.css";
import { openUrlParams } from "../lib/security/secure-url-params";
import { MIN_PASSWORD_LENGTH } from "../modules/identity-access/domain/password-reset-validation";
import AuthBrandPanel from "../components/AuthBrandPanel.astro";
import { getTranslatorFor } from "../lib/i18n";
import { resolveAuthPageLocale } from "../lib/i18n/auth-page-locale";

const sealed = Astro.url.searchParams.get("p")?.trim() ?? "";
let token = "";
let tenantId = "";

if (sealed) {
  const opened = openUrlParams(sealed);
  token = opened?.token?.trim() ?? "";
  tenantId = opened?.tenantId?.trim() ?? "";
} else {
  token = Astro.url.searchParams.get("token")?.trim() ?? "";
  tenantId = Astro.url.searchParams.get("tenantId")?.trim() ?? "";
}

const hasToken = token.length > 0;

// Language (ADR-0095): cookie -> tenant default -> Accept-Language -> en. The
// tenant default is used ONLY when the tenant came out of a SEALED link
// (AES-256-GCM, so this deployment issued it). A plain `?tenantId=` is chosen
// by whoever wrote the URL; honouring it would make the page language answer
// "does this tenant exist, and what does it speak" — a tenant oracle — so it
// contributes nothing (`src/lib/i18n/auth-page-locale.ts`).
const locale = await resolveAuthPageLocale({
  cookies: Astro.cookies,
  request: Astro.request,
  tenantId: sealed && hasToken && tenantId ? tenantId : null
});
const { tx } = getTranslatorFor(locale);

// Messages for the client script, translated here (a script cannot). The
// rejection message is ONE fixed sentence for every refusal, in every language.
const formMessages = {
  "data-msg-min-length": tx(
    "recovery",
    "Password must be at least {count} characters.",
    { count: MIN_PASSWORD_LENGTH }
  ),
  "data-msg-mismatch": tx("recovery", "The two passwords do not match."),
  "data-msg-rate-limited": tx(
    "recovery",
    "Too many attempts. Please wait a few minutes and try again."
  ),
  "data-msg-invalid": tx(
    "recovery",
    "This password reset link is invalid or has expired."
  ),
  "data-msg-done": tx(
    "recovery",
    "Your password has been changed and every session was signed out."
  ),
  "data-msg-network": tx("recovery", "Network error. Please try again."),
  "data-msg-busy": tx("recovery", "Please wait…"),
  "data-msg-show": tx("recovery", "Show"),
  "data-msg-hide": tx("recovery", "Hide"),
  "data-msg-show-password": tx("recovery", "Show password"),
  "data-msg-hide-password": tx("recovery", "Hide password")
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{tx("recovery", "Set a new password")} · AWCMS</title>
  </head>
  <body class="auth-body">
    <main class="auth">
      <AuthBrandPanel
        locale={locale}
        headline={tx("recovery", "Choose a new password.")}
        subline={tx(
          "recovery",
          "The link that brought you here works once and expires; setting a password signs out every other session."
        )}
      />
      <div class="auth-form-panel">
        <div class="auth-card">
          <div class="auth-head">
            <div class="auth-brand">
              <span class="auth-mark" aria-hidden="true">
                A
              </span>
              <span class="auth-wordmark">AWCMS</span>
            </div>
            <h1 class="auth-title">{tx("recovery", "Set a new password")}</h1>
            <p class="auth-subtitle">
              {tx(
                "recovery",
                "Choose a new password for your account. Signing you out everywhere is part of the reset."
              )}
            </p>
          </div>

          {!hasToken ? (
            <>
              <p class="auth-error" role="alert">
                {tx(
                  "recovery",
                  "This password reset link is invalid or has expired."
                )}
              </p>
              <nav
                class="auth-links"
                aria-label={tx("recovery", "Account recovery")}
              >
                <a href="/forgot-password">
                  {tx("recovery", "Request a new link")}
                </a>
                <a href="/login">{tx("recovery", "Back to sign in")}</a>
              </nav>
            </>
          ) : (
            <>
              <form
                id="reset-form"
                class="auth-form"
                novalidate
                {...formMessages}
              >
                <p id="reset-error" class="auth-error" role="alert" hidden />

                <input
                  id="reset-token"
                  name="token"
                  type="hidden"
                  value={token}
                />

                {tenantId ? (
                  <input
                    id="tenant-id"
                    name="tenantId"
                    type="hidden"
                    value={tenantId}
                  />
                ) : (
                  <div class="auth-field">
                    <label for="tenant-id">{tx("recovery", "Tenant ID")}</label>
                    <input
                      id="tenant-id"
                      name="tenantId"
                      type="text"
                      required
                      autocomplete="off"
                      spellcheck={false}
                    />
                  </div>
                )}

                <div class="auth-field">
                  <label for="new-password">
                    {tx("recovery", "New password")}
                  </label>
                  <div class="auth-password">
                    <input
                      id="new-password"
                      name="newPassword"
                      type="password"
                      required
                      autocomplete="new-password"
                      minlength={MIN_PASSWORD_LENGTH}
                    />
                    <button
                      type="button"
                      id="new-password-toggle"
                      class="auth-password-toggle"
                      aria-pressed="false"
                      aria-label={tx("recovery", "Show password")}
                    >
                      <span class="auth-password-toggle-label">
                        {tx("recovery", "Show")}
                      </span>
                    </button>
                  </div>
                  <p class="auth-hint">
                    {tx("recovery", "At least {count} characters.", {
                      count: MIN_PASSWORD_LENGTH
                    })}
                  </p>
                </div>

                <div class="auth-field">
                  <label for="confirm-password">
                    {tx("recovery", "Confirm new password")}
                  </label>
                  <input
                    id="confirm-password"
                    name="confirmPassword"
                    type="password"
                    required
                    autocomplete="new-password"
                  />
                </div>

                <button type="submit" id="reset-submit" class="auth-submit">
                  {tx("recovery", "Set new password")}
                </button>
              </form>

              <p id="reset-notice" class="auth-notice" role="status" hidden />

              <nav
                class="auth-links"
                id="reset-login-link"
                aria-label={tx("recovery", "Account recovery")}
                hidden
              >
                <a href="/login">
                  {tx("recovery", "Sign in with your new password")}
                </a>
              </nav>
            </>
          )}

          <p class="auth-foot">
            {tx("recovery", "Secured workspace access")} · AWCMS
          </p>
        </div>
      </div>
    </main>

    <script>
      // The import is deliberate — it forces Astro to bundle this script to an
      // external file (an import-free script would be inlined, and inline
      // scripts are blocked by this app's CSP). See admin-form-client.ts.
      import { lockElement, onSubmit } from "../lib/ui/admin-form-client";
      import { MIN_PASSWORD_LENGTH } from "../modules/identity-access/domain/password-reset-validation";

      // Server-translated messages (ADR-0095), rendered as data-msg-* on the
      // form. No English literals here: they would only add client weight.
      const messages = document.getElementById("reset-form")?.dataset ?? {};
      const errorBox = document.getElementById("reset-error");
      const noticeBox = document.getElementById("reset-notice");
      const loginLink = document.getElementById("reset-login-link");
      const passwordInput = document.getElementById(
        "new-password"
      ) as HTMLInputElement | null;
      const passwordToggle = document.getElementById(
        "new-password-toggle"
      ) as HTMLButtonElement | null;
      const passwordToggleLabel = passwordToggle?.querySelector(
        ".auth-password-toggle-label"
      );

      passwordToggle?.addEventListener("click", () => {
        if (!passwordInput) return;
        const reveal = passwordInput.type === "password";
        passwordInput.type = reveal ? "text" : "password";
        passwordToggle.setAttribute("aria-pressed", String(reveal));
        passwordToggle.setAttribute(
          "aria-label",
          (reveal ? messages.msgHidePassword : messages.msgShowPassword) ?? ""
        );
        if (passwordToggleLabel) {
          passwordToggleLabel.textContent =
            (reveal ? messages.msgHide : messages.msgShow) ?? "";
        }
      });

      function reveal(element: HTMLElement | null, message: string): void {
        if (!element) return;
        element.textContent = message;
        element.hidden = false;
      }

      // `onSubmit` owns the single-flight guard (#1224): a second submit while
      // this handler is pending is ignored, released on ANY settled outcome so
      // a refused or expired Turnstile challenge still lets the person retry.
      onSubmit("reset-form", async ({ form, data: formData, submit }) => {
        if (errorBox) errorBox.hidden = true;

        const token = String(formData.get("token") ?? "");
        const tenantId = String(formData.get("tenantId") ?? "").trim();
        const newPassword = String(formData.get("newPassword") ?? "");
        const confirmPassword = String(formData.get("confirmPassword") ?? "");

        // Client-side guards are UX only — the server re-validates both the
        // length and the token, and is the only authority on either.
        if (newPassword.length < MIN_PASSWORD_LENGTH) {
          reveal(errorBox, messages.msgMinLength ?? "");
          return;
        }

        if (newPassword !== confirmPassword) {
          reveal(errorBox, messages.msgMismatch ?? "");
          return;
        }

        const unlock = submit
          ? lockElement(submit, messages.msgBusy ?? "")
          : () => {};

        try {
          const response = await fetch("/api/v1/auth/password/reset", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-AWCMS-Tenant-ID": tenantId
            },
            credentials: "same-origin",
            body: JSON.stringify({ token, newPassword })
          });

          const payload = await response.json().catch(() => null);

          if (!response.ok || !payload || payload.success !== true) {
            // One generic message: the server refuses to say WHY a token was
            // rejected, and the UI must not invent a reason.
            reveal(
              errorBox,
              response.status === 429
                ? (messages.msgRateLimited ?? "")
                : (messages.msgInvalid ?? "")
            );
            unlock();
            return;
          }

          form.hidden = true;
          reveal(noticeBox, messages.msgDone ?? "");
          if (loginLink) loginLink.hidden = false;
        } catch {
          reveal(errorBox, messages.msgNetwork ?? "");
          unlock();
        }
      });
    </script>
  </body>
</html>
