---
/**
 * CRM follow-up rules and the tenant switch (Issue #1165, ADR-0159).
 *
 * ## What this screen is, and is not
 *
 * It is the READ side of the rule catalogue: every rule with its current
 * revision, and, for the rule opened with `?rule=`, the whole immutable
 * revision history. A revision never changes once published, so what is shown
 * is exactly what will run.
 *
 * Writes (all high-risk, audited at warning, each with an `Idempotency-Key`
 * held stable per distinct body so a retry replays instead of raising
 * `IDEMPOTENCY_CONFLICT`): the tenant's own switch (`PATCH /settings`), creating
 * a rule with its first revision (`POST /rules`), publishing the next immutable
 * revision (`POST /rules/{id}/revisions`, carrying the `expectedVersion` the
 * person SAW) and archiving (`POST /rules/{id}/archive`). All four are gated by
 * `rules.configure`. A revision is never edited in place: "Publish a new
 * revision" always appends.
 *
 * The SIMULATION (`POST /rules/simulate`, `rules.read`) is the same form's
 * second button: it evaluates the DRAFT in the form against a sample event and
 * writes nothing, so a reader without `configure` may use it and it works while
 * the tenant switch is off.
 *
 * A fixed assignee and an escalation recipient are typed as the person's id: no
 * staff picker exists yet (recorded in the module README), and the server
 * refuses an id that is not an active user of this tenant (`USER_NOT_FOUND`).
 *
 * It shows NOTHING about any prospect: a rule describes a process. A person a
 * rule names is "You" or "Another staff member".
 */
import AdminLayout from "../../../layouts/AdminLayout.astro";
import "../../../styles/admin-screens.css";
import { loadAdminScreen } from "../../../lib/auth/admin-screen";
import { logAdminPageError } from "../../../lib/logging/error-log";
import { getTranslatorFor } from "../../../lib/i18n";
import {
  assigneeModeLabel,
  stageCategoryLabel,
  triggerKindLabel,
  weekdayLabel
} from "../../../lib/i18n/labels/crm-follow-up";
import { formatUtcMinute } from "../../../lib/ui/channel-accounts-screen";
import {
  minutesToClock,
  offsetParts
} from "../../../lib/ui/crm-follow-up-screen";
import {
  emptyValues,
  valuesFromDefinition
} from "../../../lib/ui/crm-follow-up-rule-form";
import { asUuid } from "../../../modules/crm-follow-up/application/route-support";
import { loadRules } from "../../../modules/crm-follow-up/application/screen-loaders";
import {
  ASSIGNEE_MODES,
  STAGE_CATEGORIES,
  TRIGGER_KINDS
} from "../../../modules/crm-follow-up/domain/crm-follow-up-constants";

const ssr = Astro.locals.ssrContext!;
const { t, tn } = getTranslatorFor(Astro.locals.locale);
const LIST_PATH = "/admin/crm-follow-up";
const PATH = `${LIST_PATH}/rules`;
const selectedRuleId = asUuid(Astro.url.searchParams.get("rule"));

/**
 * The guards of this screen, spelled out as literals so
 * `admin:screen-coverage:check` (which reads source text) sees the permissions
 * it claims; the page-contract test holds each equal to
 * `CRM_FOLLOW_UP_GUARDS` and to the endpoint that enforces it.
 */
const READ_GUARD = {
  moduleKey: "crm_follow_up",
  activityCode: "rules",
  action: "read"
} as const;
const CONFIGURE_GUARD = {
  moduleKey: "crm_follow_up",
  activityCode: "rules",
  action: "configure"
} as const;

const screen = await loadAdminScreen({
  ssr,
  workClass: "interactive",
  authorize: READ_GUARD,
  load: ({ tx, auth, can }) =>
    loadRules({
      context: { tx, tenantId: ssr.tenantId, auth, now: new Date() },
      selectedRuleId,
      configureGuard: CONFIGURE_GUARD,
      can
    }),
  onError: (error) => {
    logAdminPageError(
      "admin/crm-follow-up/rules.astro: failed to load the rules",
      error,
      { correlationId: Astro.locals.correlationId }
    );
  }
});

const canRead = screen.state !== "denied";
const loadError = screen.state === "error";
const data = screen.state === "allowed" ? screen.data : null;
const deploymentEnabled = data === null ? true : data.enabled;
const rules = data?.rules ?? [];
const selected = data?.selected ?? null;
const revision = selected?.rule.currentRevision ?? null;
const definition = revision?.definition ?? null;
const me = data?.me ?? null;

const canConfigure = data?.canConfigure ?? false;
const selectedActive = selected !== null && selected.rule.status === "active";
/**
 * `revise` appends the next revision of the opened rule; `create` makes a new
 * rule (also the mode for an ARCHIVED rule, which cannot change: its values
 * only seed the form); `draft` is a reader's form, which can simulate and
 * nothing else.
 */
const editorMode = !canConfigure
  ? "draft"
  : selectedActive
    ? "revise"
    : "create";
const form = definition ? valuesFromDefinition(definition) : emptyValues();
const dayOptions = [1, 2, 3, 4, 5, 6, 7];

/** Translated here, read by the page script: a client script cannot translate. */
const messages = {
  VERSION_CONFLICT: t(
    "Someone else changed this rule. Reload the page and try again."
  ),
  RULE_CODE_TAKEN: t("A rule with this code already exists."),
  USER_NOT_FOUND: t(
    "A person you named is not an active user of this organisation."
  ),
  RULE_ARCHIVED: t("This rule is archived and can no longer change."),
  REVISION_UNCHANGED: t(
    "Nothing changed: the definition is identical to the current revision."
  ),
  CALENDAR_UNSCHEDULABLE: t(
    "The working time does not allow these offsets. Allow more working days or hours."
  ),
  CRM_FOLLOW_UP_DISABLED: t(
    "Follow-up tasks are switched off on this deployment."
  ),
  ACCESS_DENIED: t("You may not change follow-up rules."),
  INTERACTIVE_SESSION_REQUIRED: t("This needs a signed-in person."),
  RESOURCE_NOT_FOUND: t("That rule is no longer available."),
  rejected: t("Please correct: {fields}."),
  confirmArchive: t(
    "Archive this rule? It creates no new task from now on. Tasks it already created keep running, and an archived rule cannot be restored."
  ),
  busy: t("Please wait…"),
  fallback: t("Could not save the change. Please try again.")
};

/** What the form's controls are called in a "please correct" sentence. */
const fieldLabels = {
  code: t("Code"),
  name: t("Name"),
  kind: t("Starts when"),
  pipelineId: t("Only for pipeline"),
  stageCategory: t("Only for stage category"),
  stageKey: t("Only for stage"),
  taskTitle: t("Task title"),
  dueAfterMinutes: t("Due after"),
  afterMinutes: t("Escalates after"),
  recipientTenantUserId: t("Escalation recipient"),
  mode: t("Assigned to"),
  tenantUserId: t("Person"),
  maxOpenPerLead: t("Open tasks per lead, at most"),
  timeZone: t("Time zone"),
  workingDays: t("Working days"),
  workStartMinute: t("Work starts"),
  workEndMinute: t("Work ends"),
  holidays: t("Holidays"),
  occurredAt: t("When it happened"),
  leadId: t("Lead id"),
  ownerTenantUserId: t("Lead owner")
};

/** The simulation's answer, in the page's own words. */
const simLabels = {
  wouldCreate: t("A task would be created."),
  wouldNot: t("No task would be created."),
  not_matched: t("The sample event does not match the rule's trigger."),
  lead_stopped: t("A stop signal is already recorded on this lead."),
  capped: t("The lead already has as many open tasks as the rule allows."),
  due: t("Due"),
  escalates: t("Escalates"),
  never: t("Never"),
  assignee: t("Assigned to"),
  nobody: t("No one"),
  inactive: t(
    "The candidate assignee is not an active user, so the task would have no assignee."
  ),
  notices: t("Staff notices"),
  noNotices: t("None"),
  assigned: t("When assigned"),
  dueNotice: t("When due"),
  lead: t("That lead"),
  leadStopped: t("Stopped"),
  leadLive: t("Open tasks: {count}"),
  yes: t("Yes"),
  no: t("No"),
  you: t("You"),
  other: t("Another staff member")
};

function personText(id: string | null): string {
  if (id === null) return "—";

  return id === me ? t("You") : t("Another staff member");
}

function durationText(totalMinutes: number): string {
  const { hours, minutes } = offsetParts(totalMinutes);

  return t("{hours} h {minutes} min of working time", { hours, minutes });
}
---

<AdminLayout
  title={t("Follow-up rules")}
  description={t(
    "The rules that turn lead events into follow-up tasks, their immutable revisions, and the organisation's follow-up switch."
  )}
>
  <p class="page-description">
    <a href={LIST_PATH}>{t("Back to the worklist")}</a>
  </p>

  {!canRead && (
    <p class="state-notice fade-in-up" id="crm-follow-up-rules-denied">
      {t("You do not have permission to view follow-up rules.")}
    </p>
  )}

  {canRead && loadError && (
    <p class="state-notice fade-in-up" id="crm-follow-up-rules-error">
      {t("The rules could not be loaded right now. Please try again later.")}
    </p>
  )}

  {canRead && !loadError && !deploymentEnabled && (
    <p class="state-notice fade-in-up" id="crm-follow-up-rules-disabled">
      {t("Follow-up tasks are switched off on this deployment.")}
    </p>
  )}

  {canRead && !loadError && deploymentEnabled && data && (
    <>
      <section
        class="admin-section fade-in-up"
        aria-labelledby="crm-follow-up-switch-title"
        id="crm-follow-up-switch"
        data-enabled={String(data.settings.enabled)}
      >
        <h2 class="admin-section-title" id="crm-follow-up-switch-title">
          {t("Follow-up for this organisation")}
        </h2>

        <p
          id="crm-follow-up-switch-error-box"
          class="admin-create-error"
          role="alert"
          tabindex="-1"
          hidden
        ></p>

        <p>
          <span
            class="admin-status-pill"
            data-tone={data.settings.enabled ? "success" : "neutral"}
          >
            <span class="admin-status-pill-dot" aria-hidden="true" />
            {data.settings.enabled ? t("On") : t("Off")}
          </span>
        </p>
        <p class="page-description">
          {data.settings.enabled
            ? t(
                "Rules create tasks, due tasks are escalated and staff are notified."
              )
            : t(
                "While follow-up is off no task is created and no notice is sent. Rules can still be read."
              )}{" "}
          {t("Staff notices per person per hour: {count}", {
            count: data.settings.maxNoticesPerRecipientHour
          })}
        </p>

        {data.canConfigure && (
          <button
            class="btn btn-secondary js-follow-up-switch"
            type="button"
            data-currently-on={String(data.settings.enabled)}
          >
            {data.settings.enabled
              ? t("Switch follow-up off")
              : t("Switch follow-up on")}
          </button>
        )}
      </section>

      <section
        class="admin-section fade-in-up"
        aria-labelledby="crm-follow-up-rules-title"
      >
        <h2 class="admin-section-title" id="crm-follow-up-rules-title">
          {t("Rules")}
        </h2>
        <p class="page-description">
          {t(
            "A rule's published revisions never change: changing a rule publishes a new revision, and tasks already created keep the revision that created them."
          )}
        </p>
        <div
          class="data-table-scroll"
          role="region"
          tabindex="0"
          aria-labelledby="crm-follow-up-rules-caption"
        >
          <table
            class="data-table data-table--stack"
            id="crm-follow-up-rules-table"
          >
            <caption id="crm-follow-up-rules-caption">
              {tn("{count} rule", "{count} rules", rules.length, {
                count: rules.length
              })}
            </caption>
            <thead>
              <tr>
                <th scope="col">{t("Rule")}</th>
                <th scope="col">{t("Status")}</th>
                <th scope="col">{t("Starts when")}</th>
                <th scope="col">{t("Due after")}</th>
                <th scope="col">{t("Revision")}</th>
              </tr>
            </thead>
            <tbody>
              {rules.length === 0 ? (
                <tr>
                  <td colspan={5}>
                    <span class="cell-muted">
                      {t("No follow-up rules yet.")}
                    </span>
                  </td>
                </tr>
              ) : (
                rules.map((rule) => (
                  <tr data-rule-id={rule.id} data-status={rule.status}>
                    <td data-label={t("Rule")}>
                      <a href={`${PATH}?rule=${rule.id}`}>{rule.name}</a>
                      <span class="cell-muted"> {rule.code}</span>
                    </td>
                    <td data-label={t("Status")}>
                      <span
                        class="admin-status-pill"
                        data-tone={
                          rule.status === "active" ? "success" : "neutral"
                        }
                      >
                        <span
                          class="admin-status-pill-dot"
                          aria-hidden="true"
                        />
                        {rule.status === "active" ? t("Active") : t("Archived")}
                      </span>
                    </td>
                    <td data-label={t("Starts when")}>
                      {rule.currentRevision
                        ? triggerKindLabel(
                            t,
                            rule.currentRevision.definition.trigger.kind
                          )
                        : "—"}
                    </td>
                    <td data-label={t("Due after")}>
                      {rule.currentRevision
                        ? durationText(
                            rule.currentRevision.definition.dueAfterMinutes
                          )
                        : "—"}
                    </td>
                    <td data-label={t("Revision")}>
                      {rule.currentRevisionNumber}
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </section>

      {data.selectedNotFound && (
        <p class="state-notice" id="crm-follow-up-rule-not-found">
          {t("That rule was not found.")}
        </p>
      )}

      {selected && definition && revision && (
        <section
          class="admin-section fade-in-up"
          aria-labelledby="crm-follow-up-rule-title"
          id="crm-follow-up-rule"
          data-rule-id={selected.rule.id}
        >
          <h2 class="admin-section-title" id="crm-follow-up-rule-title">
            {selected.rule.name}
            <span class="cell-muted"> {selected.rule.code}</span>
          </h2>
          <dl class="admin-detail-list" id="crm-follow-up-rule-summary">
            <dt>{t("Starts when")}</dt>
            <dd>{triggerKindLabel(t, definition.trigger.kind)}</dd>
            {definition.trigger.stageCategory !== null && (
              <>
                <dt>{t("Only for stage category")}</dt>
                <dd>
                  {stageCategoryLabel(t, definition.trigger.stageCategory)}
                </dd>
              </>
            )}
            {definition.trigger.stageKey !== null && (
              <>
                <dt>{t("Only for stage")}</dt>
                <dd>{definition.trigger.stageKey}</dd>
              </>
            )}
            {definition.trigger.pipelineId !== null && (
              <>
                <dt>{t("Only for pipeline")}</dt>
                <dd>
                  <span class="cell-muted">
                    {definition.trigger.pipelineId}
                  </span>
                </dd>
              </>
            )}
            <dt>{t("Task title")}</dt>
            <dd>{definition.taskTitle}</dd>
            <dt>{t("Assigned to")}</dt>
            <dd>
              {assigneeModeLabel(t, definition.assignee.mode)}
              {definition.assignee.tenantUserId !== null && (
                <span class="cell-muted">
                  {" "}
                  ({personText(definition.assignee.tenantUserId)})
                </span>
              )}
            </dd>
            <dt>{t("Due after")}</dt>
            <dd>{durationText(definition.dueAfterMinutes)}</dd>
            <dt>{t("Escalates after")}</dt>
            <dd>
              {definition.escalation === null
                ? t("Never")
                : durationText(definition.escalation.afterMinutes)}
              {definition.escalation?.recipientTenantUserId != null && (
                <span class="cell-muted">
                  {" "}
                  ({personText(definition.escalation.recipientTenantUserId)})
                </span>
              )}
            </dd>
            <dt>{t("Staff notices")}</dt>
            <dd>
              {[
                definition.notify.onAssign ? t("When assigned") : null,
                definition.notify.onDue ? t("When due") : null
              ]
                .filter((item) => item !== null)
                .join(", ") || t("None")}
            </dd>
            <dt>{t("Open tasks per lead, at most")}</dt>
            <dd>{definition.maxOpenPerLead}</dd>
            <dt>{t("Working time")}</dt>
            <dd>
              {definition.calendar.workingDays
                .map((day) => weekdayLabel(t, day))
                .join(", ")}{" "}
              {minutesToClock(definition.calendar.workStartMinute)}-
              {minutesToClock(definition.calendar.workEndMinute)}{" "}
              <span class="cell-muted">{definition.calendar.timeZone}</span>
            </dd>
            <dt>{t("Holidays")}</dt>
            <dd>
              {definition.calendar.holidays.length === 0
                ? t("None")
                : definition.calendar.holidays.join(", ")}
            </dd>
          </dl>

          {data.canConfigure && selected.rule.status === "active" && (
            <p>
              <button
                class="btn btn-secondary js-rule-archive"
                type="button"
                data-version={selected.rule.version}
                data-rule-id={selected.rule.id}
              >
                {t("Archive this rule")}
              </button>
            </p>
          )}

          <h3 class="admin-section-title" id="crm-follow-up-revisions-title">
            {t("Revisions")}
          </h3>
          <div
            class="data-table-scroll"
            role="region"
            tabindex="0"
            aria-labelledby="crm-follow-up-revisions-title"
          >
            <table
              class="data-table data-table--stack"
              id="crm-follow-up-revisions-table"
            >
              <thead>
                <tr>
                  <th scope="col">{t("Revision")}</th>
                  <th scope="col">{t("Published")}</th>
                  <th scope="col">{t("By")}</th>
                  <th scope="col">{t("Fingerprint")}</th>
                </tr>
              </thead>
              <tbody>
                {[...selected.revisions]
                  .sort((a, b) => b.revisionNumber - a.revisionNumber)
                  .map((item) => (
                    <tr
                      data-revision={item.revisionNumber}
                      data-current={String(
                        item.revisionNumber ===
                          selected.rule.currentRevisionNumber
                      )}
                    >
                      <td data-label={t("Revision")}>
                        {item.revisionNumber}
                        {item.revisionNumber ===
                          selected.rule.currentRevisionNumber && (
                          <span class="cell-muted"> {t("Current")}</span>
                        )}
                      </td>
                      <td data-label={t("Published")}>
                        {formatUtcMinute(item.publishedAt)}
                      </td>
                      <td data-label={t("By")}>
                        {personText(item.publishedBy)}
                      </td>
                      <td data-label={t("Fingerprint")}>
                        <span class="cell-muted">
                          {item.definitionHash.slice(0, 12)}
                        </span>
                      </td>
                    </tr>
                  ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <section
        class="admin-section fade-in-up"
        aria-labelledby="crm-follow-up-editor-title"
        id="crm-follow-up-editor"
        data-mode={editorMode}
        data-me={me ?? ""}
        data-rule-id={selected?.rule.id ?? ""}
        data-version={selected?.rule.version ?? ""}
        data-messages={JSON.stringify(messages)}
        data-field-labels={JSON.stringify(fieldLabels)}
        data-sim-labels={JSON.stringify(simLabels)}
      >
        <h2 class="admin-section-title" id="crm-follow-up-editor-title">
          {editorMode === "revise"
            ? t("Publish a new revision")
            : editorMode === "create"
              ? t("Create a rule")
              : t("Try a rule draft")}
        </h2>
        <p class="page-description">
          {editorMode === "revise"
            ? t(
                "The form starts from the current revision of {name}. Publishing appends revision {number}; earlier revisions stay as they are.",
                {
                  name: selected?.rule.name ?? "",
                  number: (selected?.rule.currentRevisionNumber ?? 0) + 1
                }
              )
            : editorMode === "create"
              ? t(
                  "A new rule starts at revision 1. Use Simulate to see what a draft would do before saving it."
                )
              : t(
                  "You may simulate a draft but not save it. Simulating writes nothing."
                )}{" "}
          {editorMode === "revise" && (
            <a href={PATH}>{t("Start a new rule instead")}</a>
          )}
        </p>

        <form id="crm-rule-form" class="admin-create-form rule-editor">
          <p
            id="crm-rule-error-box"
            class="admin-create-error"
            role="alert"
            tabindex="-1"
            hidden
          ></p>

          {editorMode === "create" && (
            <fieldset>
              <legend>{t("Identity")}</legend>
              <label for="rule-code">{t("Code")}</label>
              <input
                id="rule-code"
                type="text"
                maxlength="40"
                autocomplete="off"
                aria-describedby="rule-code-hint"
              />
              <p class="form-hint" id="rule-code-hint">
                {t(
                  "2 to 40 characters: start with a lowercase letter, then lowercase letters, digits, dashes and underscores. It cannot change later."
                )}
              </p>
              <label for="rule-name">{t("Name")}</label>
              <input
                id="rule-name"
                type="text"
                maxlength="120"
                autocomplete="off"
              />
            </fieldset>
          )}

          <fieldset>
            <legend>{t("Starts when")}</legend>
            <label for="rule-trigger-kind">{t("Starts when")}</label>
            <select id="rule-trigger-kind">
              {TRIGGER_KINDS.map((kind) => (
                <option value={kind} selected={form.triggerKind === kind}>
                  {triggerKindLabel(t, kind)}
                </option>
              ))}
            </select>
            <div id="rule-filters">
              <label for="rule-pipeline-id">{t("Only for pipeline")}</label>
              <input
                id="rule-pipeline-id"
                type="text"
                value={form.pipelineId}
                autocomplete="off"
                aria-describedby="rule-filters-hint"
              />
              <label for="rule-stage-category">
                {t("Only for stage category")}
              </label>
              <select id="rule-stage-category">
                <option value="" selected={form.stageCategory === ""}>
                  {t("Any")}
                </option>
                {STAGE_CATEGORIES.map((category) => (
                  <option
                    value={category}
                    selected={form.stageCategory === category}
                  >
                    {stageCategoryLabel(t, category)}
                  </option>
                ))}
              </select>
              <label for="rule-stage-key">{t("Only for stage")}</label>
              <input
                id="rule-stage-key"
                type="text"
                maxlength="40"
                value={form.stageKey}
                autocomplete="off"
              />
              <p class="form-hint" id="rule-filters-hint">
                {t(
                  "Leave a filter blank to match any. A lead assigned event carries no pipeline or stage, so it takes no filter."
                )}
              </p>
            </div>
          </fieldset>

          <fieldset>
            <legend>{t("The task")}</legend>
            <label for="rule-task-title">{t("Task title")}</label>
            <input
              id="rule-task-title"
              type="text"
              maxlength="160"
              value={form.taskTitle}
              autocomplete="off"
            />
            <label for="rule-assignee-mode">{t("Assigned to")}</label>
            <select id="rule-assignee-mode">
              {ASSIGNEE_MODES.map((mode) => (
                <option value={mode} selected={form.assigneeMode === mode}>
                  {assigneeModeLabel(t, mode)}
                </option>
              ))}
            </select>
            <div id="rule-assignee-user-box">
              <label for="rule-assignee-user">{t("Person")}</label>
              <input
                id="rule-assignee-user"
                type="text"
                value={form.assigneeUser}
                autocomplete="off"
                aria-describedby="rule-person-hint"
              />
              <p class="form-hint" id="rule-person-hint">
                {t(
                  "The person's id. They must be an active user of this organisation."
                )}
              </p>
            </div>
            <p class="form-legend">{t("Due after (working time)")}</p>
            <label for="rule-due-hours">{t("Hours")}</label>
            <input
              id="rule-due-hours"
              type="number"
              min="0"
              step="1"
              inputmode="numeric"
              value={form.dueHours}
            />
            <label for="rule-due-minutes">{t("Minutes")}</label>
            <input
              id="rule-due-minutes"
              type="number"
              min="0"
              step="1"
              inputmode="numeric"
              value={form.dueMinutes}
            />
            <label for="rule-max-open">
              {t("Open tasks per lead, at most")}
            </label>
            <input
              id="rule-max-open"
              type="number"
              min="1"
              step="1"
              inputmode="numeric"
              value={form.maxOpenPerLead}
            />
          </fieldset>

          <fieldset>
            <legend>{t("Escalation and notices")}</legend>
            <p class="form-hint">
              {t(
                "Leave both escalation boxes blank for a rule that never escalates."
              )}
            </p>
            <label for="rule-escalate-hours">
              {t("Escalates after, hours")}
            </label>
            <input
              id="rule-escalate-hours"
              type="number"
              min="0"
              step="1"
              inputmode="numeric"
              value={form.escalateHours}
            />
            <label for="rule-escalate-minutes">
              {t("Escalates after, minutes")}
            </label>
            <input
              id="rule-escalate-minutes"
              type="number"
              min="0"
              step="1"
              inputmode="numeric"
              value={form.escalateMinutes}
            />
            <label for="rule-escalation-recipient">
              {t("Escalation recipient")}
            </label>
            <input
              id="rule-escalation-recipient"
              type="text"
              value={form.escalationRecipient}
              autocomplete="off"
              aria-describedby="rule-recipient-hint"
            />
            <p class="form-hint" id="rule-recipient-hint">
              {t(
                "Optional: the person's id. Blank still escalates the task, but no escalation notice is sent."
              )}
            </p>
            <label class="checkbox-label" for="rule-notify-assign">
              <input
                id="rule-notify-assign"
                type="checkbox"
                checked={form.notifyOnAssign}
              />
              {t("Notify when assigned")}
            </label>
            <label class="checkbox-label" for="rule-notify-due">
              <input
                id="rule-notify-due"
                type="checkbox"
                checked={form.notifyOnDue}
              />
              {t("Notify when due")}
            </label>
          </fieldset>

          <fieldset>
            <legend>{t("Working time")}</legend>
            <label for="rule-time-zone">{t("Time zone")}</label>
            <input
              id="rule-time-zone"
              type="text"
              value={form.timeZone}
              autocomplete="off"
              aria-describedby="rule-zone-hint"
            />
            <p class="form-hint" id="rule-zone-hint">
              {t("An IANA name such as Asia/Jakarta.")}
            </p>
            <p class="form-legend" id="rule-days-legend">
              {t("Working days")}
            </p>
            <div role="group" aria-labelledby="rule-days-legend">
              {dayOptions.map((day) => (
                <label class="checkbox-label" for={`rule-day-${day}`}>
                  <input
                    id={`rule-day-${day}`}
                    type="checkbox"
                    data-day={day}
                    checked={form.workingDays.includes(day)}
                  />
                  {weekdayLabel(t, day)}
                </label>
              ))}
            </div>
            <label for="rule-work-start">{t("Work starts")}</label>
            <input
              id="rule-work-start"
              type="text"
              inputmode="numeric"
              placeholder="09:00"
              maxlength="5"
              value={form.workStart}
              autocomplete="off"
            />
            <label for="rule-work-end">{t("Work ends")}</label>
            <input
              id="rule-work-end"
              type="text"
              inputmode="numeric"
              placeholder="17:00"
              maxlength="5"
              value={form.workEnd}
              autocomplete="off"
              aria-describedby="rule-clock-hint"
            />
            <p class="form-hint" id="rule-clock-hint">
              {t("24-hour time, HH:MM. The day may end at 24:00.")}
            </p>
            <label for="rule-holidays">{t("Holidays")}</label>
            <textarea
              id="rule-holidays"
              rows="3"
              autocomplete="off"
              aria-describedby="rule-holidays-hint"
            >{form.holidays}</textarea>
            <p class="form-hint" id="rule-holidays-hint">
              {t("One date per line, as YYYY-MM-DD.")}
            </p>
          </fieldset>

          <fieldset>
            <legend>{t("Sample event for the simulation")}</legend>
            <label for="rule-sample-at">{t("When it happened")}</label>
            <input id="rule-sample-at" type="datetime-local" />
            <label for="rule-sample-pipeline">{t("Pipeline id")}</label>
            <input id="rule-sample-pipeline" type="text" autocomplete="off" />
            <label for="rule-sample-category">{t("Stage category")}</label>
            <select id="rule-sample-category">
              <option value="">{t("None")}</option>
              {STAGE_CATEGORIES.map((category) => (
                <option value={category}>
                  {stageCategoryLabel(t, category)}
                </option>
              ))}
            </select>
            <label for="rule-sample-stage">{t("Stage")}</label>
            <input
              id="rule-sample-stage"
              type="text"
              maxlength="40"
              autocomplete="off"
            />
            <label for="rule-sample-owner">{t("Lead owner")}</label>
            <input id="rule-sample-owner" type="text" autocomplete="off" />
            <label for="rule-sample-lead">{t("Lead id")}</label>
            <input
              id="rule-sample-lead"
              type="text"
              autocomplete="off"
              aria-describedby="rule-sample-lead-hint"
            />
            <p class="form-hint" id="rule-sample-lead-hint">
              {t(
                "Optional: with a lead id the simulation also checks that lead's stop signals and open tasks."
              )}
            </p>
          </fieldset>

          <div class="admin-form-actions">
            {editorMode !== "draft" && (
              <button type="submit" id="rule-save">
                {editorMode === "revise"
                  ? t("Publish revision")
                  : t("Create rule")}
              </button>
            )}
            <button type="button" id="rule-simulate" class="js-rule-simulate">
              {t("Simulate this draft")}
            </button>
          </div>
        </form>

        <div
          id="crm-rule-sim-result"
          class="state-notice"
          role="status"
          aria-live="polite"
          tabindex="-1"
          hidden
        ></div>
      </section>
    </>
  )}
</AdminLayout>

<script>
  // Bundled unconditionally (Astro hoists every `<script>` at build time). The
  // import forces Astro to emit this EXTERNAL, where the app's
  // `default-src 'self'` CSP allows it.
  import {
    checkboxChecked,
    holdForNavigation,
    inputValue,
    localDateTimeToInstant,
    lockElement,
    messageBox,
    mutateAndReload,
    onAction,
    onSubmit,
    sendJson,
    sendJsonRequest
  } from "../../../lib/ui/admin-form-client";
  import { createIdempotencyKeySource } from "../../../lib/ui/admin-idempotency-key";
  import { confirmAction } from "../../../lib/ui/confirm-dialog-client";
  import { switchBody } from "../../../lib/ui/crm-follow-up-screen";
  import {
    archiveBody,
    createBody,
    publishBody,
    rejectedFieldNames,
    simulateBody,
    type RejectedField,
    type RuleFormValues
  } from "../../../lib/ui/crm-follow-up-rule-form";

  const switchError = messageBox("crm-follow-up-switch-error-box");
  const ruleError = messageBox("crm-rule-error-box");
  const BASE = "/api/v1/crm-follow-up";
  const PATH = "/admin/crm-follow-up/rules";

  // Every write is high-risk and requires the header. One key per distinct
  // (url, body): a retry replays, a changed form gets a new key. No body here
  // carries an instant, so a retry of the same form cannot conflict.
  const keyFor = createIdempotencyKeySource();

  function failure(errorCode: string | null): string {
    switch (errorCode) {
      case "INTERACTIVE_SESSION_REQUIRED":
        return "This needs a signed-in person.";
      case "ACCESS_DENIED":
        return "You may not change the follow-up switch.";
      default:
        return "Could not save the change. Please try again.";
    }
  }

  onAction(".js-follow-up-switch", async (button) => {
    const url = `${BASE}/settings`;
    const body = switchBody(button.dataset.currentlyOn === "true");

    if (
      !(await confirmAction(
        body.enabled
          ? "Switch follow-up on? Rules will start creating tasks and staff will receive notices."
          : "Switch follow-up off? No task will be created and no notice sent until it is switched on again."
      ))
    ) {
      return;
    }

    await mutateAndReload(
      button,
      switchError,
      () =>
        sendJson("PATCH", url, body, {
          "Idempotency-Key": keyFor({ url, body })
        }),
      failure
    );
  });

  // The rule editor. Its sentences were translated on the server and ride on
  // the element: a client script cannot translate.
  const editor = document.getElementById("crm-follow-up-editor");

  function carried(name: "messages" | "fieldLabels" | "simLabels") {
    try {
      return JSON.parse(editor?.dataset[name] ?? "{}") as Record<
        string,
        string
      >;
    } catch {
      return {};
    }
  }

  const messages = carried("messages");
  const fieldLabels = carried("fieldLabels");
  const simLabels = carried("simLabels");

  function describe(errorCode: string | null, fields: RejectedField[]): string {
    if (errorCode === "VALIDATION_ERROR") {
      const names = rejectedFieldNames(fields, fieldLabels);

      if (names.length > 0) {
        return (messages.rejected ?? "").replace("{fields}", names.join(", "));
      }
    }

    return (
      (errorCode !== null ? messages[errorCode] : undefined) ??
      messages.fallback ??
      ""
    );
  }

  function readValues(): RuleFormValues {
    const days: number[] = [];

    for (const box of document.querySelectorAll<HTMLInputElement>(
      "input[data-day]"
    )) {
      if (box.checked) days.push(Number(box.dataset.day));
    }

    const holidays = document.getElementById("rule-holidays");

    return {
      triggerKind: inputValue("rule-trigger-kind"),
      pipelineId: inputValue("rule-pipeline-id"),
      stageCategory: inputValue("rule-stage-category"),
      stageKey: inputValue("rule-stage-key"),
      taskTitle: inputValue("rule-task-title"),
      dueHours: inputValue("rule-due-hours"),
      dueMinutes: inputValue("rule-due-minutes"),
      escalateHours: inputValue("rule-escalate-hours"),
      escalateMinutes: inputValue("rule-escalate-minutes"),
      escalationRecipient: inputValue("rule-escalation-recipient"),
      assigneeMode: inputValue("rule-assignee-mode"),
      assigneeUser: inputValue("rule-assignee-user"),
      notifyOnAssign: checkboxChecked("rule-notify-assign"),
      notifyOnDue: checkboxChecked("rule-notify-due"),
      maxOpenPerLead: inputValue("rule-max-open"),
      timeZone: inputValue("rule-time-zone"),
      workingDays: days,
      workStart: inputValue("rule-work-start"),
      workEnd: inputValue("rule-work-end"),
      holidays: holidays instanceof HTMLTextAreaElement ? holidays.value : ""
    };
  }

  // A lead_assigned trigger takes no filter, and a lead_owner assignee takes no
  // person: hide what the API would refuse.
  function syncVisibility() {
    const filters = document.getElementById("rule-filters");
    const person = document.getElementById("rule-assignee-user-box");

    if (filters) {
      filters.hidden = inputValue("rule-trigger-kind") === "lead_assigned";
    }

    if (person) {
      person.hidden = inputValue("rule-assignee-mode") !== "fixed_user";
    }
  }

  syncVisibility();
  document
    .getElementById("rule-trigger-kind")
    ?.addEventListener("change", syncVisibility);
  document
    .getElementById("rule-assignee-mode")
    ?.addEventListener("change", syncVisibility);

  // Save: create a rule, or publish the next revision of the opened one. The
  // `expectedVersion` is the one the page was rendered with, so a rule someone
  // else changed meanwhile answers VERSION_CONFLICT instead of being overwritten.
  onSubmit("crm-rule-form", async ({ submit }) => {
    const mode = editor?.dataset.mode;

    if (mode !== "create" && mode !== "revise") return;

    const values = readValues();
    const ruleId = editor?.dataset.ruleId ?? "";
    const url =
      mode === "create" ? `${BASE}/rules` : `${BASE}/rules/${ruleId}/revisions`;
    const body =
      mode === "create"
        ? createBody(inputValue("rule-code"), inputValue("rule-name"), values)
        : publishBody(Number(editor?.dataset.version ?? "0"), values);

    ruleError.clear();
    const unlock = submit
      ? lockElement(submit, messages.busy ?? "Please wait…")
      : () => {};
    const result = await sendJsonRequest("POST", url, body, {
      "Idempotency-Key": keyFor({ url, body })
    });

    if (result.ok) {
      holdForNavigation();
      const created = (result.payload?.data as { id?: string } | undefined)?.id;

      if (mode === "create" && typeof created === "string") {
        window.location.assign(`${PATH}?rule=${encodeURIComponent(created)}`);
      } else {
        window.location.reload();
      }

      return;
    }

    const details = result.payload?.error?.details;

    ruleError.show(
      describe(
        result.errorCode,
        Array.isArray(details) ? (details as RejectedField[]) : []
      )
    );
    document.getElementById("crm-rule-error-box")?.focus();
    unlock();
  });

  onAction(".js-rule-archive", async (button) => {
    const ruleId = button.dataset.ruleId ?? "";
    const url = `${BASE}/rules/${ruleId}/archive`;
    const body = archiveBody(Number(button.dataset.version ?? "0"));

    if (!(await confirmAction(messages.confirmArchive ?? ""))) return;

    await mutateAndReload(
      button,
      ruleError,
      () =>
        sendJson("POST", url, body, {
          "Idempotency-Key": keyFor({ url, body })
        }),
      (errorCode) => describe(errorCode, [])
    );
  });

  // The simulation: read-only, so no key and no reload. It sends the DRAFT in
  // the form, never the stored revision.
  type Simulation = {
    wouldCreateTask: boolean;
    blockedBy: string[];
    dueAt: string;
    escalateAt: string | null;
    assigneeTenantUserId: string | null;
    candidateAssigneeInactive: boolean;
    notices: { kind: string; scheduledAt: string }[];
    lead: { stopped: boolean; liveTasks: number } | null;
  };

  function formatter(timeZone: string): (iso: string) => string {
    try {
      const format = new Intl.DateTimeFormat(
        document.documentElement.lang || undefined,
        { dateStyle: "medium", timeStyle: "short", timeZone }
      );

      return (iso) => format.format(new Date(iso));
    } catch {
      return (iso) => iso;
    }
  }

  function line(label: string, value: string): HTMLParagraphElement {
    const paragraph = document.createElement("p");
    const strong = document.createElement("strong");

    strong.textContent = label;
    paragraph.append(strong, ` ${value}`);

    return paragraph;
  }

  function person(id: string | null): string {
    if (id === null) return simLabels.nobody ?? "";

    return id === editor?.dataset.me
      ? (simLabels.you ?? "")
      : (simLabels.other ?? "");
  }

  function render(data: Simulation, timeZone: string) {
    const box = document.getElementById("crm-rule-sim-result");

    if (!box) return;

    const when = formatter(timeZone);
    const nodes: Node[] = [];
    const verdict = document.createElement("p");
    const strong = document.createElement("strong");

    strong.textContent = data.wouldCreateTask
      ? (simLabels.wouldCreate ?? "")
      : (simLabels.wouldNot ?? "");
    verdict.append(strong);
    nodes.push(verdict);

    for (const reason of data.blockedBy) {
      const item = document.createElement("p");

      item.textContent = simLabels[reason] ?? reason;
      nodes.push(item);
    }

    nodes.push(line(simLabels.due ?? "", when(data.dueAt)));
    nodes.push(
      line(
        simLabels.escalates ?? "",
        data.escalateAt === null
          ? (simLabels.never ?? "")
          : when(data.escalateAt)
      )
    );
    nodes.push(
      line(simLabels.assignee ?? "", person(data.assigneeTenantUserId))
    );

    if (data.candidateAssigneeInactive) {
      const warning = document.createElement("p");

      warning.textContent = simLabels.inactive ?? "";
      nodes.push(warning);
    }

    nodes.push(
      line(
        simLabels.notices ?? "",
        data.notices.length === 0
          ? (simLabels.noNotices ?? "")
          : data.notices
              .map(
                (notice) =>
                  `${
                    notice.kind === "assigned"
                      ? (simLabels.assigned ?? "")
                      : (simLabels.dueNotice ?? "")
                  }: ${when(notice.scheduledAt)}`
              )
              .join("; ")
      )
    );

    if (data.lead !== null) {
      nodes.push(
        line(
          simLabels.lead ?? "",
          `${simLabels.leadStopped ?? ""}: ${
            data.lead.stopped ? (simLabels.yes ?? "") : (simLabels.no ?? "")
          }; ${(simLabels.leadLive ?? "").replace(
            "{count}",
            String(data.lead.liveTasks)
          )}`
        )
      );
    }

    box.replaceChildren(...nodes);
    box.hidden = false;
    box.focus();
  }

  onAction(".js-rule-simulate", async (button) => {
    const values = readValues();
    const body = simulateBody(values, {
      occurredAt: localDateTimeToInstant("rule-sample-at"),
      pipelineId: inputValue("rule-sample-pipeline"),
      stageCategory: inputValue("rule-sample-category"),
      stageKey: inputValue("rule-sample-stage"),
      ownerTenantUserId: inputValue("rule-sample-owner"),
      leadId: inputValue("rule-sample-lead")
    });

    ruleError.clear();
    const unlock = lockElement(button, messages.busy ?? "Please wait…");
    const result = await sendJsonRequest(
      "POST",
      `${BASE}/rules/simulate`,
      body
    );

    unlock();

    if (!result.ok || result.payload?.data === undefined) {
      const details = result.payload?.error?.details;

      ruleError.show(
        describe(
          result.errorCode,
          Array.isArray(details) ? (details as RejectedField[]) : []
        )
      );
      document.getElementById("crm-rule-error-box")?.focus();

      return;
    }

    render(result.payload.data as Simulation, values.timeZone);
  });
</script>
