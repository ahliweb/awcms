                          <span class="admin-status-pill" data-tone="danger">
                            <span
                              class="admin-status-pill-dot"
                              aria-hidden="true"
                            />
                            {t("Deleted")}
                          </span>
                        ) : (
                          <span
                            class="admin-status-pill"
                            data-tone={supplierStatusTone(row.status)}
                          >
                            <span
                              class="admin-status-pill-dot"
                              aria-hidden="true"
                            />
                            {supplierStatusLabel(row.status)}
                          </span>
                        )}
                      </td>
                      <td data-label={t("Categories")}>
                        {row.categories.length > 0
                          ? row.categories.join(", ")
                          : "—"}
                      </td>
                      <td data-label={t("Actions")}>
                        {row.deletedAt === null && (
                          <a
                            class="btn-inline"
                            href={pageUrl({
                              supplier: row.id,
                              cursor: null
                            })}
                          >
                            {t("Open {code}", { code: row.vendorCode })}
                          </a>
                        )}
                        {row.deletedAt !== null && data.canRestoreSupplier && (
                          <button
                            type="button"
                            class="module-toggle js-supplier-restore"
                            data-supplier-id={row.id}
                          >
                            {t("Restore")}
                          </button>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {data.suppliersNext && (
            <p>
              <a
                class="btn-inline"
                href={pageUrl({ cursor: data.suppliersNext })}
              >
                {t("Next page")}
              </a>
            </p>
          )}
        </section>
      )}

      {view === "suppliers" && supplier_ && (
        <section
          class="fade-in-up"
          aria-labelledby="procurement-supplier-heading"
        >
          <p>
            <a class="btn-inline" href={pageUrl({ supplier: null })}>
              {t("Back to the suppliers")}
            </a>
          </p>
          <h2 id="procurement-supplier-heading">
            {supplier_.name} ({supplier_.vendorCode})
          </h2>

          {data.canUpdateSupplier ? (
            <form
              id="supplier-edit-form"
              class="admin-create-form"
              data-supplier-id={supplier_.id}
            >
              <label for="supplier-edit-name">
                {t("Name")}
                <input
                  id="supplier-edit-name"
                  name="name"
                  type="text"
                  required
                  maxlength="200"
                  value={supplier_.name}
                />
              </label>
              <label for="supplier-edit-status">
                {t("Status")}
                <select id="supplier-edit-status" name="status">
                  {SUPPLIER_STATUSES.map((status) => (
                    <option
                      value={status}
                      selected={status === supplier_.status}
                    >
                      {SUPPLIER_STATUS_LABEL[status]}
                    </option>
                  ))}
                </select>
              </label>
              <label for="supplier-edit-categories">
                {t("Categories")}
                <input
                  id="supplier-edit-categories"
                  name="categories"
                  type="text"
                  autocomplete="off"
                  value={supplier_.categories.join(", ")}
                />
              </label>
              <label for="supplier-edit-tags">
                {t("Tags")}
                <input
                  id="supplier-edit-tags"
                  name="tags"
                  type="text"
                  autocomplete="off"
                  value={supplier_.tags.join(", ")}
                />
              </label>
              <button id="supplier-edit-submit" type="submit">
                {t("Save supplier")}
              </button>
            </form>
          ) : (
            <dl class="admin-detail-list">
              <dt>{t("Status")}</dt>
              <dd>{supplierStatusLabel(supplier_.status)}</dd>
              <dt>{t("Categories")}</dt>
              <dd>
                {supplier_.categories.length > 0
                  ? supplier_.categories.join(", ")
                  : "—"}
              </dd>
              <dt>{t("Tags")}</dt>
              <dd>
                {supplier_.tags.length > 0 ? supplier_.tags.join(", ") : "—"}
              </dd>
            </dl>
          )}

          {data.canDeleteSupplier && (
            <p>
              <button
                id="supplier-delete"
                type="button"
                class="btn-inline btn-inline--danger js-supplier-delete"
                data-supplier-id={supplier_.id}
                data-confirm={t(
                  "Delete {code}? Its documents keep referencing it, and it can be restored later.",
                  { code: supplier_.vendorCode }
                )}
              >
                {t("Delete supplier")}
              </button>
            </p>
          )}

          <section aria-labelledby="procurement-identifiers-heading">
            <h3 id="procurement-identifiers-heading">
              {t("Identifiers and references")}
            </h3>
            <p class="page-description">
              {t(
                "Tax and business identifiers and payment or contact references are shown masked. Revealing one is a separate permission and is recorded in the audit log."
              )}
            </p>

            {data.identifiers.length === 0 ? (
              <div class="empty-state">
                <p id="procurement-identifiers-empty">
                  {t("This supplier has no identifier or reference yet.")}
                </p>
              </div>
            ) : (
              <div
                class="data-table-scroll"
                role="region"
                tabindex="0"
                aria-labelledby="procurement-identifiers-heading"
              >
                <table
                  class="data-table data-table--stack"
                  id="procurement-identifiers-table"
                >
                  <thead>
                    <tr>
                      <th scope="col">{t("Type")}</th>
                      <th scope="col">{t("Label")}</th>
                      <th scope="col">{t("Value (masked)")}</th>
                      {(data.canRevealIdentifier || data.canUpdateSupplier) && (
                        <th scope="col">{t("Actions")}</th>
                      )}
                    </tr>
                  </thead>
                  <tbody>
                    {data.identifiers.map((identifier) => (
                      <tr data-identifier-id={identifier.id}>
                        <th scope="row" data-label={t("Type")}>
                          {identifierTypeLabel(identifier.type)}
                        </th>
                        <td data-label={t("Label")}>
                          {identifier.label ?? "—"}
                        </td>
                        <td data-label={t("Value (masked)")}>
                          <code>{identifier.maskedValue}</code>
                        </td>
                        {(data.canRevealIdentifier ||
                          data.canUpdateSupplier) && (
                          <td data-label={t("Actions")}>
                            {data.canRevealIdentifier && (
                              <button
                                type="button"
                                class="module-toggle js-reveal-identifier"
                                data-supplier-id={supplier_.id}
                                data-identifier-id={identifier.id}
                                data-confirm={t(
                                  "Reveal this value in clear text? The disclosure is recorded in the audit log."
                                )}
                                data-type-label={identifierTypeLabel(
                                  identifier.type
                                )}
                              >
                                {t("Reveal")}
                              </button>
                            )}
                            {data.canUpdateSupplier && (
                              <button
                                type="button"
                                class="btn-inline btn-inline--danger js-remove-identifier"
                                data-supplier-id={supplier_.id}
                                data-identifier-id={identifier.id}
                                data-confirm={t(
                                  "Remove this identifier or reference?"
                                )}
                              >
                                {t("Remove")}
                              </button>
                            )}
                          </td>
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {data.canRevealIdentifier && (
              <>
                {/* The live region is persistent and never hidden: a region that
                    is inserted or un-hidden at the moment its text changes is not
                    reliably announced. Only its surroundings come and go. */}
                <p>
                  <code
                    id="identifier-reveal-result"
                    role="status"
                    aria-live="polite"
                    aria-atomic="true"
                  />
                </p>
                <div
                  id="identifier-reveal-panel"
                  hidden
                  class="admin-code-block"
                  data-msg-title={t("Revealed value")}
                >
                  <p id="identifier-reveal-title" class="form-legend"></p>
                  <p class="page-description">
                    {t(
                      "Shown once. It is not stored, and it disappears when you hide it, after a minute, or when you leave the page."
                    )}
                  </p>
                  <button
                    id="identifier-reveal-hide"
                    type="button"
                    class="btn-inline"
                  >
                    {t("Hide")}
                  </button>
                </div>
              </>
            )}

            {data.canUpdateSupplier && (
              <form
                id="identifier-form"
                class="admin-create-form"
                data-supplier-id={supplier_.id}
              >
                <p class="form-legend">{t("Add an identifier or reference")}</p>
                <label for="identifier-type">
                  {t("Type")}
                  <select id="identifier-type" name="type" required>
                    {IDENTIFIER_TYPES.map((type) => (
                      <option value={type}>
                        {IDENTIFIER_TYPE_LABEL[type]}
                      </option>
                    ))}
                  </select>
                </label>
                <label for="identifier-value">
                  {t("Value")}
                  <input
                    id="identifier-value"
                    name="value"
                    type="text"
                    required
                    maxlength="200"
                    autocomplete="off"
                    spellcheck="false"
                  />
                </label>
                <label for="identifier-label">
                  {t("Label")}
                  <input
                    id="identifier-label"
                    name="label"
                    type="text"
                    maxlength="100"
                  />
                </label>
                <button id="identifier-submit" type="submit">
                  {t("Add identifier")}
                </button>
              </form>
            )}
          </section>
        </section>
      )}

      {/* ------------------------------------------------------------ DOCUMENTS */}
      {view === "documents" && !document_ && !detailMissing && (
        <section
          class="fade-in-up"
          aria-labelledby="procurement-documents-heading"
        >
          <h2 id="procurement-documents-heading">{t("Documents")}</h2>

          <form class="admin-create-form" method="get" role="search">
            <input type="hidden" name="view" value="documents" />
            <p class="form-legend">{t("Filter")}</p>
            <label for="documents-mode">
              {t("Kind")}
              <select id="documents-mode" name="mode">
                <option value="">{t("All kinds")}</option>
                {DOCUMENT_MODES.map((mode) => (
                  <option value={mode} selected={mode === modeFilter}>
                    {MODE_LABEL[mode]}
                  </option>
                ))}
              </select>
            </label>
            <label for="documents-status">
              {t("Status")}
              <select id="documents-status" name="status">
                <option value="">{t("All statuses")}</option>
                {DOCUMENT_STATUSES.map((status) => (
                  <option
                    value={status}
                    selected={status === documentStatusFilter}
                  >
                    {STATUS_LABEL[status]}
                  </option>
                ))}
              </select>
            </label>
            <button type="submit" class="module-toggle">
              {t("Apply filter")}
            </button>
            <a class="btn-inline" href="/admin/procurement?view=documents">
              {t("Clear filter")}
            </a>
          </form>

          {data.canCreateDocument && (
            <section aria-labelledby="procurement-document-add-heading">
              <h3 id="procurement-document-add-heading">
                {t("New draft document")}
              </h3>
              <form id="document-form" class="admin-create-form">
                <p class="page-description">
                  {t(
                    "A draft moves no stock. Submit it to freeze its lines, then finalise it to post the movements through the stock ledger."
                  )}
                </p>
                <label for="document-mode">
                  {t("Kind")}
                  <select id="document-mode" name="mode" required>
                    {DOCUMENT_MODES.map((mode) => (
                      <option value={mode}>{MODE_LABEL[mode]}</option>
                    ))}
                  </select>
                </label>

                <div class="js-supplier-mode-field">
                  {data.pickerSuppliers.length > 0 && data.pickerComplete ? (
                    <label for="document-supplier">
                      {t("Supplier")}
                      <select id="document-supplier" name="supplierId" required>
                        {data.pickerSuppliers.map((row) => (
                          <option value={row.id}>
                            {row.name} ({row.vendorCode})
                          </option>
                        ))}
                      </select>
                    </label>
                  ) : (
                    <label for="document-supplier">
                      {t("Supplier id")}
                      <input
                        id="document-supplier"
                        name="supplierId"
                        type="text"
                        required
                        autocomplete="off"
                      />
                    </label>
                  )}
                </div>

                {locationPicker ? (
                  <label for="document-location">
                    <span class="js-location-label-default">
                      {t("Location")}
                    </span>
                    <span class="js-location-label-destination" hidden>
                      {t("Destination location")}
                    </span>
                    <select id="document-location" name="locationId" required>
                      {activeLocations.map((location) => (
                        <option value={location.id}>
                          {location.name} ({location.code})
                        </option>
                      ))}
                    </select>
                  </label>
                ) : (
                  <label for="document-location">
                    <span class="js-location-label-default">
                      {t("Location id")}
                    </span>
                    <span class="js-location-label-destination" hidden>
                      {t("Destination location id")}
                    </span>
                    <input
                      id="document-location"
                      name="locationId"
                      type="text"
                      required
                      autocomplete="off"
                    />
                  </label>
                )}

                <div class="js-location-mode-field" hidden>
                  {locationPicker ? (
                    <label for="document-source-location">
                      {t("Source location")}
                      <select
                        id="document-source-location"
                        name="sourceLocationId"
                        required
                        disabled
                      >
                        {activeLocations.map((location) => (
                          <option value={location.id}>
                            {location.name} ({location.code})
                          </option>
                        ))}
                      </select>
                    </label>
                  ) : (
                    <label for="document-source-location">
                      {t("Source location id")}
                      <input
                        id="document-source-location"
                        name="sourceLocationId"
                        type="text"
                        required
                        disabled
                        autocomplete="off"
                      />
                    </label>
                  )}
                </div>

                <label for="document-reference">
                  {t("External reference")}
                  <input
                    id="document-reference"
                    name="externalReference"
                    type="text"
                    maxlength="200"
                  />
                </label>
                <label for="document-date">
                  {t("Document date")}
                  <input
                    id="document-date"
                    name="documentDate"
                    type="date"
                    value={today}
                  />
                </label>
                <label for="document-currency">
                  {t("Currency")}
                  <input
                    id="document-currency"
                    name="currencyCode"
                    type="text"
                    value="IDR"
                    maxlength="3"
                    pattern="[A-Za-z]{3}"
                    autocomplete="off"
                  />
                </label>
                <label for="document-notes">
                  {t("Notes")}
                  <input
                    id="document-notes"
                    name="notes"
                    type="text"
                    maxlength="500"
                  />
                </label>

                <div
                  id="document-lines"
                  class="line-editor"
                  data-remove-label={t("Remove line {n}")}
                  data-line-label={t("Line {n}")}
