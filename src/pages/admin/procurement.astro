                  <p class="form-legend">{t("Lines")}</p>
                  <p class="page-description">
                    {t(
                      "Quantity and cost are exact decimals (up to 6 decimals). A receipt and a supplier return need a unit cost; an item appears once per document."
                    )}
                  </p>
                </div>
                <p>
                  <button
                    id="document-add-line"
                    type="button"
                    class="btn-inline"
                  >
                    {t("Add a line")}
                  </button>
                </p>
                <button id="document-submit" type="submit">
                  {t("Create draft")}
                </button>

                <template id="document-line-template">
                  <fieldset class="js-document-line">
                    <legend class="js-line-legend"></legend>
                    <label>
                      {t("Item type")}
                      <input
                        name="itemType"
                        type="text"
                        maxlength="64"
                        value="product"
                        autocomplete="off"
                      />
                    </label>
                    <label>
                      {t("Item reference")}
                      <input
                        name="itemRef"
                        type="text"
                        maxlength="200"
                        autocomplete="off"
                      />
                    </label>
                    <label>
                      {t("SKU")}
                      <input
                        name="sku"
                        type="text"
                        maxlength="120"
                        autocomplete="off"
                      />
                    </label>
                    <label>
                      {t("Item name")}
                      <input name="itemName" type="text" maxlength="200" />
                    </label>
                    <label>
                      {t("Unit")}
                      <input
                        name="unitCode"
                        type="text"
                        maxlength="32"
                        value="unit"
                        autocomplete="off"
                      />
                    </label>
                    <label>
                      {t("Quantity")}
                      <input
                        name="quantity"
                        type="text"
                        inputmode="decimal"
                        autocomplete="off"
                      />
                    </label>
                    <label>
                      {t("Unit cost")}
                      <input
                        name="unitCost"
                        type="text"
                        inputmode="decimal"
                        autocomplete="off"
                      />
                    </label>
                    <button
                      type="button"
                      class="btn-inline btn-inline--danger js-remove-line"
                    >
                      {t("Remove")}
                    </button>
                  </fieldset>
                </template>
              </form>
            </section>
          )}

          {data.documents.length === 0 ? (
            <div class="empty-state">
              <p id="procurement-documents-empty">
                {t("No document matches. Create a draft to start.")}
              </p>
            </div>
          ) : (
            <div
              class="data-table-scroll"
              role="region"
              tabindex="0"
              aria-labelledby="procurement-documents-heading"
            >
              <table
                class="data-table data-table--stack"
                id="procurement-documents-table"
              >
                <thead>
                  <tr>
                    <th scope="col">{t("Number")}</th>
                    <th scope="col">{t("Kind")}</th>
                    <th scope="col">{t("Status")}</th>
                    <th scope="col">{t("Supplier")}</th>
                    <th scope="col">{t("Location")}</th>
                    <th scope="col">{t("Lines")}</th>
                    <th scope="col">{t("Total cost")}</th>
                    <th scope="col">{t("Date")}</th>
                  </tr>
                </thead>
                <tbody>
                  {data.documents.map((row) => (
                    <tr
                      data-document-id={row.id}
                      data-status={row.status}
                      data-mode={row.mode}
                    >
                      <th scope="row" data-label={t("Number")}>
                        <a href={pageUrl({ document: row.id, cursor: null })}>
                          {row.documentNo}
                        </a>
                      </th>
                      <td data-label={t("Kind")}>{modeLabel(row.mode)}</td>
                      <td data-label={t("Status")}>
                        <span
                          class="admin-status-pill"
                          data-tone={statusTone(row.status)}
                        >
                          <span
                            class="admin-status-pill-dot"
                            aria-hidden="true"
                          />
                          {statusLabel(row.status)}
                        </span>
                      </td>
                      <td data-label={t("Supplier")}>
                        {row.supplier
                          ? `${row.supplier.name} (${row.supplier.code})`
                          : "—"}
                      </td>
                      <td data-label={t("Location")}>
                        {row.sourceLocationId
                          ? `${locationLabel(row.sourceLocationId)} → ${locationLabel(row.locationId)}`
                          : locationLabel(row.locationId)}
                      </td>
                      <td data-label={t("Lines")}>{row.lineCount}</td>
                      <td data-label={t("Total cost")}>
                        {row.totalCost === null
                          ? "—"
                          : `${row.totalCost} ${row.currencyCode}`}
                      </td>
                      <td data-label={t("Date")}>{row.documentDate}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {data.documentsNext && (
            <p>
              <a
                class="btn-inline"
                href={pageUrl({ cursor: data.documentsNext })}
              >
                {t("Next page")}
              </a>
            </p>
          )}
        </section>
      )}

      {view === "documents" && document_ && (
        <section
          class="fade-in-up"
          aria-labelledby="procurement-document-heading"
        >
          <p>
            <a class="btn-inline" href={pageUrl({ document: null })}>
              {t("Back to the documents")}
            </a>
          </p>
          <h2 id="procurement-document-heading">
            {document_.documentNo} — {modeLabel(document_.mode)}
          </h2>

          <dl
            class="admin-detail-list"
            id="procurement-document-detail"
            data-status={document_.status}
            data-document-id={document_.id}
          >
            <dt>{t("Status")}</dt>
            <dd>
              <span
                class="admin-status-pill"
                data-tone={statusTone(document_.status)}
              >
                <span class="admin-status-pill-dot" aria-hidden="true" />
                {statusLabel(document_.status)}
              </span>
            </dd>
            {document_.supplier && (
              <>
                <dt>{t("Supplier")}</dt>
                <dd>
                  {document_.supplier.name} ({document_.supplier.code})
                </dd>
              </>
            )}
            {document_.sourceLocationId && (
              <>
                <dt>{t("Source location")}</dt>
                <dd>{locationLabel(document_.sourceLocationId)}</dd>
              </>
            )}
            <dt>
              {document_.sourceLocationId
                ? t("Destination location")
                : t("Location")}
            </dt>
            <dd>{locationLabel(document_.locationId)}</dd>
            <dt>{t("Document date")}</dt>
            <dd>{document_.documentDate}</dd>
            <dt>{t("External reference")}</dt>
            <dd>{document_.externalReference ?? "—"}</dd>
            <dt>{t("Total cost")}</dt>
            <dd>
              {document_.totalCost === null
                ? "—"
                : `${document_.totalCost} ${document_.currencyCode}`}
            </dd>
            <dt>{t("Approval")}</dt>
            <dd data-approval={document_.approvalStatus}>
              {APPROVAL_LABEL[document_.approvalStatus as ApprovalStatus] ??
                document_.approvalStatus}
            </dd>
            <dt>{t("Notes")}</dt>
            <dd>{document_.notes ?? "—"}</dd>
            {document_.submittedAt && (
              <>
                <dt>{t("Submitted")}</dt>
                <dd>
                  <time datetime={document_.submittedAt}>
                    {formatDateTime(locale, document_.submittedAt, "UTC")}
                  </time>
                </dd>
              </>
            )}
            {document_.finalisedAt && (
              <>
                <dt>{t("Finalised")}</dt>
                <dd>
                  <time datetime={document_.finalisedAt}>
                    {formatDateTime(locale, document_.finalisedAt, "UTC")}
                  </time>
                </dd>
              </>
            )}
            {document_.cancelledAt && (
              <>
                <dt>{t("Cancelled")}</dt>
                <dd>
                  <time datetime={document_.cancelledAt}>
                    {formatDateTime(locale, document_.cancelledAt, "UTC")}
                  </time>
                  {document_.cancelReason && ` — ${document_.cancelReason}`}
                </dd>
              </>
            )}
            {document_.reversedAt && (
              <>
                <dt>{t("Reversed")}</dt>
                <dd>
                  <time datetime={document_.reversedAt}>
                    {formatDateTime(locale, document_.reversedAt, "UTC")}
                  </time>
                  {document_.reverseReason && ` — ${document_.reverseReason}`}
                </dd>
              </>
            )}
          </dl>

          <div
            class="data-table-scroll"
            role="region"
            tabindex="0"
            aria-labelledby="procurement-document-heading"
          >
            <table
              class="data-table data-table--stack"
              id="procurement-document-lines"
            >
              <thead>
                <tr>
                  <th scope="col">{t("Line")}</th>
                  <th scope="col">{t("Item")}</th>
                  <th scope="col">{t("SKU")}</th>
                  <th scope="col">{t("Quantity")}</th>
                  <th scope="col">{t("Unit cost")}</th>
                  <th scope="col">{t("Line total")}</th>
                </tr>
              </thead>
              <tbody>
                {document_.lines.map((line) => (
                  <tr data-line-no={line.lineNo}>
                    <td data-label={t("Line")}>{line.lineNo}</td>
                    <th scope="row" data-label={t("Item")}>
                      {line.itemName}
                      <span class="page-description">
                        {" "}
                        {line.itemType}: {line.itemRef}
                      </span>
                    </th>
                    <td data-label={t("SKU")}>{line.sku}</td>
                    <td data-label={t("Quantity")}>
                      {line.quantity} {line.unitCode}
                    </td>
                    <td data-label={t("Unit cost")}>{line.unitCost ?? "—"}</td>
                    <td data-label={t("Line total")}>
                      {line.lineTotal ?? "—"}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {document_.movements.length > 0 && (
            <p class="page-description" id="procurement-document-movements">
              {t("{count} ledger movements are linked to this document.", {
                count: document_.movements.length
              })}
            </p>
          )}

          <div class="row-actions" id="procurement-document-actions">
            {document_.status === "draft" && data.canSubmitDocument && (
              <button
                id="document-action-submit"
                type="button"
                class="module-toggle js-document-action"
                data-action="submit"
                data-document-id={document_.id}
                data-confirm={t(
                  "Submit this document? Its lines are frozen, and an approval may be started."
                )}
              >
                {t("Submit")}
              </button>
            )}
            {document_.status === "submitted" && data.canFinaliseDocument && (
              <button
                id="document-action-finalise"
                type="button"
                class="module-toggle js-document-action"
                data-action="finalise"
                data-document-id={document_.id}
                data-confirm={t(
                  "Finalise this document? Its stock movements are posted to the ledger, all lines or none, and the document can no longer be edited."
                )}
              >
                {t("Finalise")}
              </button>
            )}
            {(document_.status === "draft" ||
              document_.status === "submitted") &&
              data.canCancelDocument && (
                <>
                  <form
                    id="document-cancel-form"
                    class="js-document-reason-form"
                    data-action="cancel"
                    data-document-id={document_.id}
                    hidden
                  />
                  <button
                    id="document-action-cancel"
                    type="button"
                    class="btn-inline btn-inline--danger"
                    data-reason-title={t("Cancel this document")}
                    data-reason-description={t(
                      "No stock was moved, so nothing is compensated. The document is kept, marked cancelled."
                    )}
                    data-reason-form="document-cancel-form"
                    data-reason-field="reason"
                    data-reason-max-length="500"
                    data-reason-label={t("Cancel document")}
                    data-reason-danger
                  >
                    {t("Cancel document")}
                  </button>
                </>
              )}
            {document_.status === "finalised" && data.canReverseDocument && (
              <>
                <form
                  id="document-reverse-form"
                  class="js-document-reason-form"
                  data-action="reverse"
                  data-document-id={document_.id}
                  hidden
                />
                <button
                  id="document-action-reverse"
                  type="button"
                  class="btn-inline btn-inline--danger"
                  data-reason-title={t("Reverse this document")}
                  data-reason-description={t(
                    "Posts compensating stock movements. The original movements stay in the ledger, and a document can be reversed only once."
                  )}
                  data-reason-form="document-reverse-form"
                  data-reason-field="reason"
                  data-reason-max-length="500"
                  data-reason-label={t("Reverse document")}
                  data-reason-danger
                >
                  {t("Reverse")}
                </button>
              </>
            )}
          </div>
        </section>
      )}

      {/* --------------------------------------------------------------- POLICY */}
      {view === "policy" && (
        <section
          class="fade-in-up"
          aria-labelledby="procurement-policy-heading"
        >
          <h2 id="procurement-policy-heading">{t("Approval policy")}</h2>
          <p class="page-description">
            {t(
              "When a submitted document's total cost reaches the threshold, it needs approval before it can be finalised, through the workflow named {key}. With no threshold, approval is off. The threshold is cost-based, so a document without a cost, a requisition and a transfer never need it. A change applies only to documents submitted afterwards.",
              { key: APPROVAL_WORKFLOW_KEY }
            )}
          </p>
          <p
            id="procurement-policy-readout"
            data-threshold={data.threshold ?? ""}
          >
            {data.threshold === null
              ? t("Approval is off.")
              : t(
                  "Documents with a total cost of {threshold} or more need approval.",
                  {
                    threshold: data.threshold
                  }
                )}
          </p>
          {data.canConfigurePolicy && (
            <form id="policy-form" class="admin-create-form">
              <label for="policy-threshold">
                {t("Approval threshold")}
                <input
                  id="policy-threshold"
                  name="approvalThreshold"
                  type="text"
                  inputmode="decimal"
                  autocomplete="off"
                  value={data.threshold ?? ""}
                />
              </label>
              <p class="page-description">
                {t(
                  "An exact decimal with up to 6 decimals. Leave empty to turn approval off."
                )}
              </p>
              <button id="policy-submit" type="submit">
                {t("Save threshold")}
              </button>
            </form>
          )}
        </section>
      )}

      {/* -------------------------------------------------------------- REPORTS */}
      {view === "reports" && (
        <section
          class="fade-in-up"
          aria-labelledby="procurement-reports-heading"
        >
          <h2 id="procurement-reports-heading">{t("Reports")}</h2>

          <form class="admin-create-form" method="get" role="search">
            <input type="hidden" name="view" value="reports" />
            <p class="form-legend">{t("Document date range")}</p>
            <label for="reports-from">
              {t("From")}
              <input
                id="reports-from"
                name="from"
                type="date"
                value={fromDate}
              />
            </label>
            <label for="reports-to">
              {t("To")}
              <input id="reports-to" name="to" type="date" value={toDate} />
            </label>
            <button type="submit" class="module-toggle">
              {t("Run report")}
            </button>
            <a class="btn-inline" href="/admin/procurement?view=reports">
              {t("Clear filter")}
            </a>
          </form>

          {periodInvalid ? (
            <p class="state-notice" id="procurement-report-period-invalid">
              {t(
                "The date range is not valid. Use real dates, with From not after To."
              )}
            </p>
          ) : (
            <>
              <h3 id="procurement-receiving-heading">
                {t("Documents by kind and status")}
              </h3>
              {data.receiving.length === 0 ? (
                <div class="empty-state">
                  <p id="procurement-receiving-empty">
                    {t("No document falls in this range.")}
                  </p>
                </div>
              ) : (
                <div
                  class="data-table-scroll"
                  role="region"
                  tabindex="0"
                  aria-labelledby="procurement-receiving-heading"
                >
                  <table
                    class="data-table data-table--stack"
                    id="procurement-receiving-table"
                  >
                    <thead>
                      <tr>
                        <th scope="col">{t("Kind")}</th>
                        <th scope="col">{t("Status")}</th>
                        <th scope="col">{t("Documents")}</th>
                        <th scope="col">{t("Total cost")}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {data.receiving.map((row) => (
                        <tr>
                          <th scope="row" data-label={t("Kind")}>
                            {modeLabel(row.mode)}
                          </th>
                          <td data-label={t("Status")}>
                            {statusLabel(row.status)}
                          </td>
                          <td data-label={t("Documents")}>{row.documents}</td>
                          <td data-label={t("Total cost")}>{row.totalCost}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              <h3 id="procurement-supplier-report-heading">
                {t("Activity per supplier")}
              </h3>
              {data.supplierReport.length === 0 ? (
                <div class="empty-state">
                  <p id="procurement-supplier-report-empty">
                    {t("No supplier activity falls in this range.")}
                  </p>
                </div>
              ) : (
                <div
                  class="data-table-scroll"
                  role="region"
                  tabindex="0"
                  aria-labelledby="procurement-supplier-report-heading"
                >
                  <table
                    class="data-table data-table--stack"
                    id="procurement-supplier-report-table"
                  >
                    <thead>
                      <tr>
                        <th scope="col">{t("Vendor code")}</th>
                        <th scope="col">{t("Status")}</th>
                        <th scope="col">{t("Receipts finalised")}</th>
                        <th scope="col">{t("Returns finalised")}</th>
                        <th scope="col">{t("Reversed")}</th>
                        <th scope="col">{t("Open documents")}</th>
                        <th scope="col">{t("Received cost")}</th>
                        <th scope="col">{t("Returned cost")}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {data.supplierReport.map((row) => (
                        <tr data-deleted={row.deleted ? "true" : "false"}>
                          <th scope="row" data-label={t("Vendor code")}>
                            {row.vendorCode}
                          </th>
                          <td data-label={t("Status")}>
                            {row.deleted
                              ? t("Deleted")
                              : supplierStatusLabel(row.status)}
                          </td>
                          <td data-label={t("Receipts finalised")}>
                            {row.receiptsFinalised}
                          </td>
                          <td data-label={t("Returns finalised")}>
                            {row.supplierReturnsFinalised}
                          </td>
                          <td data-label={t("Reversed")}>
                            {row.documentsReversed}
                          </td>
                          <td data-label={t("Open documents")}>
                            {row.openDocuments}
                          </td>
                          <td data-label={t("Received cost")}>
                            {row.receivedCost}
                          </td>
                          <td data-label={t("Returned cost")}>
                            {row.returnedCost}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              {data.supplierReportNext && (
                <p>
                  <a
                    class="btn-inline"
                    href={pageUrl({ cursor: data.supplierReportNext })}
                  >
                    {t("Next page")}
                  </a>
                </p>
              )}
            </>
          )}
        </section>
      )}

      {/* -------------------------------------------------------- RECONCILIATION */}
      {view === "reconciliation" && (
        <section
          class="fade-in-up"
          aria-labelledby="procurement-reconciliation-heading"
        >
          <h2 id="procurement-reconciliation-heading">{t("Reconciliation")}</h2>
          <p class="page-description">
            {t(
              "Read-only proof that every finalised or reversed document agrees with the stock ledger: the right movements, of the right type, at the right location, in the right quantity. It changes nothing."
            )}
          </p>
          <p>
            <a
              class="btn-inline"
              id="procurement-reconcile-link"
              href="/admin/procurement?view=reconciliation&run=1"
            >
              {t("Run reconciliation")}
            </a>
          </p>
          {data.reconciliation && (
            <div
              id="procurement-reconcile-result"
              role="status"
              data-consistent={
                data.reconciliation.reconciled ? "true" : "false"
              }
            >
              <p>
                {data.reconciliation.reconciled
                  ? t(
                      "Reconciled: {documents} documents and {lines} lines were checked and all agree with the ledger.",
                      {
                        documents: data.reconciliation.documentsChecked,
                        lines: data.reconciliation.linesChecked
                      }
                    )
                  : t(
                      "Discrepancies found. {documents} documents and {lines} lines were checked.",
                      {
                        documents: data.reconciliation.documentsChecked,
                        lines: data.reconciliation.linesChecked
                      }
                    )}
              </p>
              {data.reconciliation.unlinkedLedgerMovements > 0 && (
                <p>
                  {t(
                    "{count} ledger movements carry a procurement identity with no document line behind them.",
                    { count: data.reconciliation.unlinkedLedgerMovements }
                  )}
                </p>
              )}
              {data.reconciliation.discrepanciesTruncated && (
                <p>
                  {t("The list is truncated; more discrepancies may exist.")}
                </p>
              )}
              {data.reconciliation.discrepancies.length > 0 && (
                <div
                  class="data-table-scroll"
                  role="region"
                  tabindex="0"
                  aria-labelledby="procurement-reconciliation-heading"
                >
                  <table class="data-table data-table--stack">
                    <thead>
                      <tr>
                        <th scope="col">{t("Document")}</th>
                        <th scope="col">{t("Line")}</th>
                        <th scope="col">{t("Operation")}</th>
                        <th scope="col">{t("Expected movements")}</th>
                        <th scope="col">{t("Linked movements")}</th>
                        <th scope="col">{t("Matching movements")}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {data.reconciliation.discrepancies.map((row) => (
                        <tr>
                          <th scope="row" data-label={t("Document")}>
                            <a
                              href={`/admin/procurement?view=documents&document=${row.documentId}`}
                            >
                              {row.documentId.slice(0, 8)}
                            </a>
                          </th>
                          <td data-label={t("Line")}>{row.lineNo}</td>
                          <td data-label={t("Operation")}>
                            {row.operation === "post"
                              ? t("Post")
                              : t("Reversal")}
                          </td>
                          <td data-label={t("Expected movements")}>
                            {row.expectedMovements}
                          </td>
                          <td data-label={t("Linked movements")}>
                            {row.linkedMovements}
                          </td>
                          <td data-label={t("Matching movements")}>
                            {row.matchingMovements}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          )}
        </section>
      )}

      <ReasonPanel
        cancelLabel={t("Close")}
        reasonLabel={t("Reason")}
        reasonHint={t("Recorded on the document and in the audit log.")}
        defaultSubmitLabel={t("Confirm")}
        defaultFailureMessage={t("Could not save that. Please try again.")}
      />
    </>
  )}
</AdminLayout>

<script>
  // Bundled unconditionally (Astro hoists every `<script>` at build time). The
  // import forces Astro to emit this EXTERNAL, where the app's
  // `default-src 'self'` CSP allows it.
  import {
    blankToNull,
    field,
    lockElement,
    messageBox,
    mutateAndReload,
    onAction,
    onSubmit,
    onSubmitAll,
    sendJson,
    sendJsonForData
  } from "../../lib/ui/admin-form-client";
  import { confirmAction } from "../../lib/ui/confirm-dialog-client";
  import { initReasonPanel } from "../../lib/ui/reason-panel-client";
  import { createIdempotencyKeySource } from "../../lib/ui/admin-idempotency-key";
  import {
    buildDocumentBody,
    isBlankLine,
    isSupplierDocumentMode,
    missingLineFields,
    parseLabelList,
    type LineFields
  } from "../../lib/ui/procurement-document-model";

  const errorBox = messageBox("procurement-action-error");
  const errorElement = document.getElementById("procurement-action-error");
  const nextKey = createIdempotencyKeySource();
  const BASE = "/api/v1/procurement";

  /** The message the server rendered (translated) for an error code. */
  function messageFor(errorCode: string | null): string {
    const data = errorElement?.dataset ?? {};
    const generic = data.msgGeneric ?? "";

    switch (errorCode) {
      case "FORBIDDEN":
      case "ACCESS_DENIED":
        return data.msgForbidden ?? generic;
      case "VALIDATION_ERROR":
      case "VALIDATION_FAILED":
        return data.msgValidation ?? generic;
      case "VENDOR_CODE_CONFLICT":
        return data.msgVendorCode ?? generic;
      case "SUPPLIER_HAS_OPEN_DOCUMENTS":
        return data.msgSupplierOpen ?? generic;
      case "SUPPLIER_DELETED":
        return data.msgSupplierDeleted ?? generic;
      case "SUPPLIER_UNAVAILABLE":
        return data.msgSupplierUnavailable ?? generic;
      case "SUPPLIER_NOT_FOUND":
        return data.msgSupplierNotFound ?? generic;
      case "LOCATION_NOT_FOUND":
        return data.msgLocationNotFound ?? generic;
      case "INVALID_STATE":
      case "MODE_IMMUTABLE":
      case "NOT_DELETED":
        return data.msgInvalidState ?? generic;
      case "INSUFFICIENT_STOCK":
        return data.msgInsufficient ?? generic;
      case "UNIT_MISMATCH":
        return data.msgUnit ?? generic;
      case "LOCATION_INACTIVE":
        return data.msgInactive ?? generic;
      case "APPROVAL_PENDING":
        return data.msgApprovalPending ?? generic;
      case "APPROVAL_REJECTED":
        return data.msgApprovalRejected ?? generic;
      case "APPROVAL_WORKFLOW_NOT_CONFIGURED":
      case "APPROVAL_WORKFLOW_MISCONFIGURED":
        return data.msgApprovalMissing ?? generic;
      case "DUPLICATE_EXTERNAL_REFERENCE":
        return data.msgDuplicateReference ?? generic;
      case "ACTOR_REQUIRED":
        return data.msgActor ?? generic;
      case "RESOURCE_NOT_FOUND":
        return data.msgNotFound ?? generic;
      case "CONFLICT":
      case "IDEMPOTENCY_CONFLICT":
      case "IDEMPOTENCY_KEY_CONFLICT":
        return data.msgConflict ?? generic;
      default:
        return generic;
    }
  }

  initReasonPanel();

  // --- Suppliers ------------------------------------------------------------

  onSubmit("supplier-form", async ({ data, submit }) => {
    const body = {
      vendorCode: field(data, "vendorCode"),
      name: field(data, "name"),
      status: field(data, "status"),
      categories: parseLabelList(field(data, "categories")),
      tags: parseLabelList(field(data, "tags"))
    };

    await mutateAndReload(
      submit,
      errorBox,
      () => sendJson("POST", `${BASE}/suppliers`, body),
      messageFor
    );
  });

  onSubmit("supplier-edit-form", async ({ form, data, submit }) => {
    const id = form.dataset.supplierId;
    if (!id) return;
    const body = {
      name: field(data, "name"),
      status: field(data, "status"),
      categories: parseLabelList(field(data, "categories")),
      tags: parseLabelList(field(data, "tags"))
    };

    await mutateAndReload(
      submit,
      errorBox,
      () =>
        sendJson("PATCH", `${BASE}/suppliers/${encodeURIComponent(id)}`, body),
      messageFor
    );
  });

  onAction(".js-supplier-delete", async (button) => {
    const id = button.dataset.supplierId;
    const message = button.dataset.confirm;
    // The server-rendered, translated `data-confirm` is always present; with no
    // text there is nothing translated to ask, so do not act.
    if (!id || !message || !(await confirmAction(message))) return;

    await mutateAndReload(
      button,
      errorBox,
      () =>
        sendJson("DELETE", `${BASE}/suppliers/${encodeURIComponent(id)}`, {}),
      messageFor
    );
  });

  onAction(".js-supplier-restore", async (button) => {
    const id = button.dataset.supplierId;
    if (!id) return;

    await mutateAndReload(
      button,
      errorBox,
      () =>
        sendJson("POST", `${BASE}/suppliers/${encodeURIComponent(id)}/restore`),
      messageFor
    );
  });

  // --- Identifiers ----------------------------------------------------------
  //
  // An add answers a minimal acknowledgement with no id (so a caller without
  // `suppliers.reveal` cannot learn whether a value already existed): the page
  // reloads to re-list rather than reading anything back from the response.

  onSubmit("identifier-form", async ({ form, data, submit }) => {
    const id = form.dataset.supplierId;
    if (!id) return;
    const body = {
      type: field(data, "type"),
      value: field(data, "value"),
      label: blankToNull(field(data, "label"))
    };

    await mutateAndReload(
      submit,
      errorBox,
      () =>
        sendJson(
          "POST",
          `${BASE}/suppliers/${encodeURIComponent(id)}/identifiers`,
          body
        ),
      messageFor
    );
  });

  onAction(".js-remove-identifier", async (button) => {
    const id = button.dataset.supplierId;
    const identifierId = button.dataset.identifierId;
    const message = button.dataset.confirm;
    if (!id || !identifierId || !message || !(await confirmAction(message))) {
      return;
    }

    await mutateAndReload(
      button,
      errorBox,
      () =>
        sendJson(
          "DELETE",
          `${BASE}/suppliers/${encodeURIComponent(id)}/identifiers/${encodeURIComponent(identifierId)}`
        ),
      messageFor
    );
  });

  // The ONE place a clear identifier value reaches the page. It goes into a
  // single live region as text (never markup, never an attribute, never
  // storage), is dropped on Hide, after a minute, and when the page is left, and
  // is never read back: every Reveal is a fresh, audited request.
  const revealPanel = document.getElementById("identifier-reveal-panel");
  const revealTitle = document.getElementById("identifier-reveal-title");
  const revealResult = document.getElementById("identifier-reveal-result");
  let revealTimer: number | undefined;
  // The Reveal button that opened the panel: Hide returns focus to it, because
  // the Hide button disappears with the panel and focus would fall to <body>.
  let revealOpener: HTMLButtonElement | null = null;

  function hideRevealed(returnFocus = false): void {
    window.clearTimeout(revealTimer);
    if (revealResult) revealResult.textContent = "";
    if (revealTitle) revealTitle.textContent = "";
    if (revealPanel) revealPanel.hidden = true;
    if (returnFocus && revealOpener?.isConnected) revealOpener.focus();
  }

  document
    .getElementById("identifier-reveal-hide")
    ?.addEventListener("click", () => hideRevealed(true));
  window.addEventListener("pagehide", () => hideRevealed());

  onAction(".js-reveal-identifier", async (button) => {
    const id = button.dataset.supplierId;
    const identifierId = button.dataset.identifierId;
    const message = button.dataset.confirm;
    if (!id || !identifierId || !message || !(await confirmAction(message))) {
      return;
    }

    hideRevealed();
    errorBox.clear();
    const unlock = lockElement(button, "Please wait…");
    const outcome = await sendJsonForData<{ value?: string }>(
      "POST",
      `${BASE}/suppliers/${encodeURIComponent(id)}/identifiers/${encodeURIComponent(identifierId)}/reveal`
    );
    unlock();

    if (!outcome.ok || typeof outcome.data?.value !== "string") {
      errorBox.show(messageFor(outcome.errorCode));
      return;
    }

    revealOpener = button;
    if (revealResult) revealResult.textContent = outcome.data.value;
    if (revealTitle) {
      revealTitle.textContent = `${revealPanel?.dataset.msgTitle ?? ""}: ${button.dataset.typeLabel ?? ""}`;
    }
    if (revealPanel) {
      revealPanel.hidden = false;
      revealTimer = window.setTimeout(hideRevealed, 60_000);
    }
  });

  // --- Document form --------------------------------------------------------

  const documentForm = document.getElementById("document-form");
  const linesHost = document.getElementById("document-lines");
  const lineTemplate = document.getElementById("document-line-template");

  function lineRows(): HTMLElement[] {
    return linesHost
      ? Array.from(linesHost.querySelectorAll<HTMLElement>(".js-document-line"))
      : [];
  }

  /** Numbers the rows, so every "Remove" has an accessible name of its own. */
  function renumberLines(): void {
    lineRows().forEach((row, index) => {
      const n = String(index + 1);
      const legend = row.querySelector(".js-line-legend");
      if (legend) {
        legend.textContent = (linesHost?.dataset.lineLabel ?? "").replace(
          "{n}",
          n
        );
      }
      row
        .querySelector(".js-remove-line")
        ?.setAttribute(
          "aria-label",
          (linesHost?.dataset.removeLabel ?? "").replace("{n}", n)
        );
    });
  }

  function addLine(focus: boolean): void {
    if (!(lineTemplate instanceof HTMLTemplateElement) || !linesHost) return;
    const row = lineTemplate.content.firstElementChild?.cloneNode(true);
    if (!(row instanceof HTMLElement)) return;
    linesHost.append(row);
    renumberLines();
    if (focus) row.querySelector<HTMLInputElement>("input")?.focus();
  }

  function readLine(row: HTMLElement): LineFields {
    const value = (name: string): string =>
      row.querySelector<HTMLInputElement>(`[name="${name}"]`)?.value ?? "";
    return {
      itemType: value("itemType"),
      itemRef: value("itemRef"),
      sku: value("sku"),
      itemName: value("itemName"),
      unitCode: value("unitCode"),
      quantity: value("quantity"),
      unitCost: value("unitCost")
    };
  }

  /** Shows the supplier or the source-location field, whichever the mode needs. */
  function applyMode(): void {
    if (!(documentForm instanceof HTMLFormElement)) return;
    const mode = (
      documentForm.elements.namedItem("mode") as HTMLSelectElement | null
    )?.value;
    const supplierMode = isSupplierDocumentMode(mode ?? "");
    const supplierGroup = documentForm.querySelector<HTMLElement>(
      ".js-supplier-mode-field"
    );
    const locationGroup = documentForm.querySelector<HTMLElement>(
      ".js-location-mode-field"
    );
    for (const [group, shown] of [
      [supplierGroup, supplierMode],
      [locationGroup, !supplierMode]
    ] as const) {
      if (!group) continue;
      group.hidden = !shown;
      // A hidden control must not block the submit (`required`) or be sent.
      for (const control of group.querySelectorAll<
        HTMLInputElement | HTMLSelectElement
      >("input, select")) {
        control.disabled = !shown;
      }
    }
    const plain = documentForm.querySelector<HTMLElement>(
      ".js-location-label-default"
    );
    const destination = documentForm.querySelector<HTMLElement>(
      ".js-location-label-destination"
    );
    if (plain) plain.hidden = !supplierMode;
    if (destination) destination.hidden = supplierMode;
  }

  if (documentForm instanceof HTMLFormElement) {
    addLine(false);
    applyMode();
    document
      .getElementById("document-mode")
      ?.addEventListener("change", applyMode);
    document
      .getElementById("document-add-line")
      ?.addEventListener("click", () => addLine(true));
    linesHost?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const remove = target.closest(".js-remove-line");
      if (!remove) return;
      // The last row stays: a document needs at least one line.
      if (lineRows().length > 1) {
        remove.closest(".js-document-line")?.remove();
        renumberLines();
        document.getElementById("document-add-line")?.focus();
      }
    });
  }

  onSubmit("document-form", async ({ data, submit }) => {
    // Spare untouched rows are ignored. A half-filled row is caught here (the
    // inputs are not `required`, or a spare row could never be left empty) and
    // its first missing field is focused.
    errorBox.clear();
    const rows = lineRows();
    for (const row of rows) {
      const missing = missingLineFields(readLine(row))[0];
      if (missing) {
        errorBox.show(messageFor("VALIDATION_ERROR"));
        row.querySelector<HTMLInputElement>(`[name="${missing}"]`)?.focus();
        return;
      }
    }
    const lines = rows.map(readLine).filter((line) => !isBlankLine(line));
    if (lines.length === 0) {
      errorBox.show(messageFor("VALIDATION_ERROR"));
      rows[0]?.querySelector<HTMLInputElement>("input")?.focus();
      return;
    }
    const body = buildDocumentBody({
      mode: field(data, "mode"),
      supplierId: field(data, "supplierId"),
      locationId: field(data, "locationId"),
      sourceLocationId: field(data, "sourceLocationId"),
      externalReference: field(data, "externalReference"),
      documentDate: field(data, "documentDate"),
      notes: field(data, "notes"),
      currencyCode: field(data, "currencyCode"),
      lines
    });

    errorBox.clear();
    const unlock = submit ? lockElement(submit, "Please wait…") : () => {};
    // The key is derived from the body, so pressing Create again after a dropped
    // response replays the first draft instead of creating a second one.
    const outcome = await sendJsonForData<{ id?: string }>(
      "POST",
      `${BASE}/documents`,
      body,
      { "Idempotency-Key": nextKey({ create: body }) }
    );

    if (outcome.ok && typeof outcome.data?.id === "string") {
      window.location.assign(
        `/admin/procurement?view=documents&document=${encodeURIComponent(outcome.data.id)}`
      );
      return;
    }

    unlock();
    errorBox.show(messageFor(outcome.errorCode));
  });

  // --- Document actions -----------------------------------------------------
  //
  // Submit and Finalise are confirmed (Finalise posts stock) and each carries an
  // `Idempotency-Key` that is the same for a retry of the same action on the same
  // document, so a dropped response replays instead of repeating it.

  onAction(".js-document-action", async (button) => {
    const id = button.dataset.documentId;
    const action = button.dataset.action;
    const message = button.dataset.confirm;
    if (!id || (action !== "submit" && action !== "finalise")) return;
    if (!message || !(await confirmAction(message))) return;

    await mutateAndReload(
      button,
      errorBox,
      () =>
        sendJson(
          "POST",
          `${BASE}/documents/${encodeURIComponent(id)}/${action}`,
          {},
          { "Idempotency-Key": nextKey({ action, id }) }
        ),
      messageFor
    );
  });

  // The reason panel writes the typed reason into this hidden form's `reason`
  // field and submits it: cancel and reverse both REQUIRE one.
  onSubmitAll(".js-document-reason-form", async ({ form, data }) => {
    const id = form.dataset.documentId;
    const action = form.dataset.action;
    if (!id || (action !== "cancel" && action !== "reverse")) return;
    const body = { reason: field(data, "reason") };
    const path = action === "reverse" ? "reversal" : "cancel";

    await mutateAndReload(
      null,
      errorBox,
      () =>
        sendJson(
          "POST",
          `${BASE}/documents/${encodeURIComponent(id)}/${path}`,
          body,
          { "Idempotency-Key": nextKey({ action, id, body }) }
        ),
      messageFor
    );
  });

  // --- Policy ---------------------------------------------------------------

  onSubmit("policy-form", async ({ data, submit }) => {
    const body = {
      approvalThreshold: blankToNull(field(data, "approvalThreshold"))
    };

    await mutateAndReload(
      submit,
      errorBox,
      () =>
        sendJson("PUT", `${BASE}/policy`, body, {
          "Idempotency-Key": nextKey({ policy: body })
        }),
      messageFor
    );
  });
</script>
