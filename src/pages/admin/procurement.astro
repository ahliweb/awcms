---
/**
 * Procurement — ADR-0128, Issue #905. TENANT-scoped, over the supplier,
 * receiving, return, requisition and transfer module (Issue #888) that shipped
 * API-first.
 *
 * ## Five views, one entry decision per view
 *
 * Suppliers, documents, the approval policy, the reports and the reconciliation
 * are independently permissioned (`suppliers.read`, `documents.read`,
 * `policy.read`, `reports.read`, `documents.reconcile`), so the page is refused
 * only when EVERY one is refused and each view answers for itself from `entry` —
 * the any-of shape `/admin/inventory` uses. A view the operator may not read is
 * not rendered and the switcher does not offer it. Every control is gated by its
 * own `can(permission)` — the permission its endpoint enforces — so a read-only
 * operator sees no write control at all, and a write control a role was not
 * granted is not a dead button.
 *
 * ## A document never moves stock until it is finalised, and finalising is the
 * ## ledger's job
 *
 * Creating a draft touches nothing. Submit freezes it, and — when the tenant set
 * an approval threshold — starts the optional approval; Finalise posts the
 * movements THROUGH THE INVENTORY LEDGER'S PORT (the endpoint does it, this page
 * never writes a balance), all lines or none. Reverse posts compensating
 * movements. Both need a confirmation / a mandatory reason, and each confirmed
 * action carries an `Idempotency-Key` so a retry replays instead of posting twice.
 *
 * ## Identifiers are masked; reveal is a deliberate, audited act
 *
 * The page lists a supplier's tax/business identifiers and payment/contact
 * references ONLY in their masked form (the read model has no value field).
 * "Reveal" calls the one endpoint that returns a clear value (`suppliers.reveal`,
 * audited, `Cache-Control: no-store`), and the value is shown in one live region
 * that the operator can dismiss and that clears itself — it is never written to
 * the page markup, to storage, or to a data attribute, and a reload drops it.
 * An identifier add answers a minimal acknowledgement with no id, so the page
 * reloads to re-list rather than trusting the response.
 *
 * ## Location and supplier pickers follow what the operator may read
 *
 * `procurement.*` does not imply `inventory.locations.read` or
 * `procurement.suppliers.read`. A picker is offered only when the operator holds
 * the read behind it (and the list was not truncated); otherwise the field takes
 * an id, as `/admin/inventory` does. The endpoint is the authority either way.
 *
 * ## Not on this screen, and why
 *
 * `procurement.documents.update` (editing a DRAFT in place) stays on the
 * shrink-only coverage ledger: a draft with a mistake is cancelled and entered
 * again. Nothing here edits a submitted or finalised document — they are
 * immutable by a database trigger.
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import ReasonPanel from "../../components/ReasonPanel.astro";
import "../../styles/admin-screens.css";
import { loadAdminScreen } from "../../lib/auth/admin-screen";
import { logAdminPageError } from "../../lib/logging/error-log";
import { formatDateTime, getTranslatorFor } from "../../lib/i18n";
import { calendarDateOrEmpty } from "../../lib/ui/procurement-document-model";
import { listLocations } from "../../modules/inventory/application/inventory-location-directory";
import type { StockLocation } from "../../modules/inventory/application/inventory-rows";
import {
  decodeKeysetCursor,
  type KeysetCursor
} from "../../modules/_shared/keyset-pagination";
import {
  getDocument,
  listDocuments,
  parseDocumentCursor,
  readApprovalThreshold
} from "../../modules/procurement/application/procurement-document-directory";
import {
  getSupplier,
  listIdentifiers,
  listSuppliers,
  parseSupplierCursor
} from "../../modules/procurement/application/procurement-supplier-directory";
import {
  parseReportCursor,
  receivingSummaryReport,
  reconcileDocuments,
  supplierActivityReport,
  type ReceivingSummaryRow,
  type ReconciliationReport,
  type SupplierActivity
} from "../../modules/procurement/application/procurement-reporting";
import type {
  DocumentDetail,
  ProcurementDocument,
  Supplier,
  SupplierIdentifier
} from "../../modules/procurement/application/procurement-rows";
import {
  APPROVAL_WORKFLOW_KEY,
  DOCUMENT_MODES,
  DOCUMENT_STATUSES,
  IDENTIFIER_TYPES,
  SUPPLIER_STATUSES,
  isDocumentMode,
  isDocumentStatus,
  isSupplierStatus,
  type ApprovalStatus,
  type DocumentMode,
  type DocumentStatus,
  type SupplierIdentifierType,
  type SupplierStatus
} from "../../modules/procurement/domain/procurement-types";

const ssr = Astro.locals.ssrContext!;
const locale = Astro.locals.locale;
const { t } = getTranslatorFor(locale);

type View = "suppliers" | "documents" | "policy" | "reports" | "reconciliation";
const VIEWS: readonly View[] = [
  "suppliers",
  "documents",
  "policy",
  "reports",
  "reconciliation"
];

const UUID_PATTERN =
  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const MAX_FILTER_TEXT = 200;

function queryText(name: string): string {
  const value = Astro.url.searchParams.get(name)?.trim() ?? "";
  return value.length > MAX_FILTER_TEXT ? "" : value;
}
function queryUuid(name: string): string {
  const value = queryText(name);
  return UUID_PATTERN.test(value) ? value.toLowerCase() : "";
}

const requestedView = Astro.url.searchParams.get("view");
const supplierId = queryUuid("supplier");
const documentId = queryUuid("document");
const supplierStatusFilter = (() => {
  const value = queryText("supplierStatus");
  return isSupplierStatus(value) ? value : "";
})();
const showDeleted = Astro.url.searchParams.get("includeDeleted") === "1";
const modeFilter = (() => {
  const value = queryText("mode");
  return isDocumentMode(value) ? value : "";
})();
const documentStatusFilter = (() => {
  const value = queryText("status");
  return isDocumentStatus(value) ? value : "";
})();
const fromDate = calendarDateOrEmpty(queryText("from"));
const toDate = calendarDateOrEmpty(queryText("to"));
const periodInvalid =
  (queryText("from") !== "" && fromDate === "") ||
  (queryText("to") !== "" && toDate === "") ||
  (fromDate !== "" && toDate !== "" && fromDate > toDate);
const cursorParam = queryText("cursor");
const wantsReconcile = Astro.url.searchParams.get("run") === "1";

const MODE_LABEL: Record<DocumentMode, string> = {
  receive: t("Receipt"),
  supplier_return: t("Supplier return"),
  requisition: t("Requisition"),
  transfer: t("Location transfer")
};
const STATUS_LABEL: Record<DocumentStatus, string> = {
  draft: t("Draft"),
  submitted: t("Submitted"),
  finalised: t("Finalised"),
  cancelled: t("Cancelled"),
  reversed: t("Reversed")
};
const STATUS_TONE: Record<DocumentStatus, string> = {
  draft: "neutral",
  submitted: "warning",
  finalised: "success",
  cancelled: "neutral",
  reversed: "danger"
};
const APPROVAL_LABEL: Record<ApprovalStatus, string> = {
  not_required: t("Not required"),
  pending: t("Waiting for approval"),
  approved: t("Approved"),
  rejected: t("Rejected")
};
const SUPPLIER_STATUS_LABEL: Record<SupplierStatus, string> = {
  active: t("Active"),
  inactive: t("Inactive"),
  blocked: t("Blocked")
};
const SUPPLIER_STATUS_TONE: Record<SupplierStatus, string> = {
  active: "success",
  inactive: "neutral",
  blocked: "danger"
};
const IDENTIFIER_TYPE_LABEL: Record<SupplierIdentifierType, string> = {
  tax_id: t("Tax ID"),
  business_id: t("Business ID"),
  payment_ref: t("Payment reference"),
  contact_ref: t("Contact reference"),
  other: t("Other")
};

function modeLabel(value: string): string {
  return isDocumentMode(value) ? MODE_LABEL[value] : value;
}
function statusLabel(value: string): string {
  return isDocumentStatus(value) ? STATUS_LABEL[value] : value;
}
function statusTone(value: string): string {
  return isDocumentStatus(value) ? STATUS_TONE[value] : "neutral";
}
function supplierStatusLabel(value: string): string {
  return isSupplierStatus(value) ? SUPPLIER_STATUS_LABEL[value] : value;
}
function supplierStatusTone(value: string): string {
  return isSupplierStatus(value) ? SUPPLIER_STATUS_TONE[value] : "neutral";
}
function identifierTypeLabel(value: string): string {
  return (IDENTIFIER_TYPES as readonly string[]).includes(value)
    ? IDENTIFIER_TYPE_LABEL[value as SupplierIdentifierType]
    : value;
}

// A picker follows the supplier cursor, bounded: a tenant with more than this
// many pages of active suppliers gets the id text input instead of a silently
// truncated list (an older supplier could not be chosen from it).
const SUPPLIER_PICKER_MAX_PAGES = 5;
const LOCATION_PICKER_MAX_PAGES = 5;

const screen = await loadAdminScreen({
  ssr,
  workClass: "interactive",
  authorize: [
    { moduleKey: "procurement", activityCode: "suppliers", action: "read" },
    { moduleKey: "procurement", activityCode: "documents", action: "read" },
    { moduleKey: "procurement", activityCode: "policy", action: "read" },
    { moduleKey: "procurement", activityCode: "reports", action: "read" },
    { moduleKey: "procurement", activityCode: "documents", action: "reconcile" }
  ],
  load: async ({ tx, can, entry }) => {
    const [maySuppliers, mayDocuments, mayPolicy, mayReports, mayReconcile] =
      entry;
    const view: View = (() => {
      const allowed: Record<View, boolean> = {
        suppliers: Boolean(maySuppliers),
        documents: Boolean(mayDocuments),
        policy: Boolean(mayPolicy),
        reports: Boolean(mayReports),
        reconciliation: Boolean(mayReconcile)
      };
      const wanted = VIEWS.find((candidate) => candidate === requestedView);
      if (wanted && allowed[wanted]) return wanted;
      return VIEWS.find((candidate) => allowed[candidate]) ?? "suppliers";
    })();

    // Sequential on purpose: `tx` is one reserved connection.
    const canCreateSupplier = await can({
      moduleKey: "procurement",
      activityCode: "suppliers",
      action: "create"
    });
    const canUpdateSupplier = await can({
      moduleKey: "procurement",
      activityCode: "suppliers",
      action: "update"
    });
    const canDeleteSupplier = await can({
      moduleKey: "procurement",
      activityCode: "suppliers",
      action: "delete"
    });
    const canRestoreSupplier = await can({
      moduleKey: "procurement",
      activityCode: "suppliers",
      action: "restore"
    });
    const canRevealIdentifier = await can({
      moduleKey: "procurement",
      activityCode: "suppliers",
      action: "reveal"
    });
    const canCreateDocument = await can({
      moduleKey: "procurement",
      activityCode: "documents",
      action: "create"
    });
    const canSubmitDocument = await can({
      moduleKey: "procurement",
      activityCode: "documents",
      action: "submit"
    });
    const canFinaliseDocument = await can({
      moduleKey: "procurement",
      activityCode: "documents",
      action: "finalise"
    });
    const canCancelDocument = await can({
      moduleKey: "procurement",
      activityCode: "documents",
      action: "cancel"
    });
    const canReverseDocument = await can({
      moduleKey: "procurement",
      activityCode: "documents",
      action: "reverse"
    });
    const canConfigurePolicy = await can({
      moduleKey: "procurement",
      activityCode: "policy",
      action: "configure"
    });
    const mayLocations = await can({
      moduleKey: "inventory",
      activityCode: "locations",
      action: "read"
    });

    // Bounded like the supplier picker: a tenant with more than
    // LOCATION_PICKER_MAX_PAGES pages of locations gets the id input rather than
    // a silently truncated select (a later location could not be chosen).
    const locations: StockLocation[] = [];
    let locationsComplete = true;
    if (mayLocations) {
      let after: string | undefined;
      for (let n = 0; n < LOCATION_PICKER_MAX_PAGES; n += 1) {
        const batch = await listLocations(tx, ssr.tenantId, {
          limit: 200,
          ...(after ? { after } : {})
        });
        locations.push(...batch.items);
        if (!batch.nextCursor) {
          locationsComplete = true;
          break;
        }
        locationsComplete = false;
        after = batch.nextCursor;
      }
    }

    let suppliers: Supplier[] = [];
    let suppliersNext: string | null = null;
    let supplier: Supplier | null = null;
    let identifiers: SupplierIdentifier[] = [];
    let documents: ProcurementDocument[] = [];
    let documentsNext: string | null = null;
    let document: DocumentDetail | null = null;
    let pickerSuppliers: Supplier[] = [];
    let pickerComplete = true;
    let threshold: string | null = null;
    let receiving: ReceivingSummaryRow[] = [];
    let supplierReport: SupplierActivity[] = [];
    let supplierReportNext: string | null = null;
    let reconciliation: ReconciliationReport | null = null;

    // `includeDeleted` is the power of whoever may restore, exactly as the list
    // endpoint decides it, so `suppliers.read` alone cannot enumerate them.
    const includeDeleted = showDeleted && canRestoreSupplier;

    if (view === "suppliers") {
      if (supplierId) {
        supplier = await getSupplier(tx, ssr.tenantId, supplierId);
        if (supplier) {
          identifiers =
            (await listIdentifiers(tx, ssr.tenantId, supplierId)) ?? [];
        }
      } else {
        const cursor: KeysetCursor | null = cursorParam
          ? parseSupplierCursor(cursorParam)
          : null;
        const page = await listSuppliers(
          tx,
          ssr.tenantId,
          {
            ...(supplierStatusFilter ? { status: supplierStatusFilter } : {}),
            includeDeleted
          },
          cursor ?? undefined
        );
        suppliers = page.suppliers;
        suppliersNext = page.nextCursor;
      }
    }

    if (view === "documents") {
      if (documentId) {
        document = await getDocument(tx, ssr.tenantId, documentId);
      } else {
        const cursor: KeysetCursor | null = cursorParam
          ? parseDocumentCursor(cursorParam)
          : null;
        const page = await listDocuments(
          tx,
          ssr.tenantId,
          {
            ...(modeFilter ? { mode: modeFilter } : {}),
            ...(documentStatusFilter ? { status: documentStatusFilter } : {})
          },
          cursor ?? undefined
        );
        documents = page.documents;
        documentsNext = page.nextCursor;

        if (canCreateDocument && maySuppliers) {
          let next: KeysetCursor | undefined;
          for (let n = 0; n < SUPPLIER_PICKER_MAX_PAGES; n += 1) {
            const batch = await listSuppliers(
              tx,
              ssr.tenantId,
              { status: "active" },
              next
            );
            pickerSuppliers.push(...batch.suppliers);
            if (!batch.nextCursor) {
              pickerComplete = true;
              break;
            }
            pickerComplete = false;
            next = decodeKeysetCursor(batch.nextCursor) ?? undefined;
            if (!next) break;
          }
        }
      }
    }

    if (view === "policy") {
      threshold = await readApprovalThreshold(tx, ssr.tenantId);
    }

    if (view === "reports" && !periodInvalid) {
      const range = {
        from: fromDate === "" ? null : fromDate,
        to: toDate === "" ? null : toDate
      };
      receiving = await receivingSummaryReport(tx, ssr.tenantId, range);
      const cursor: KeysetCursor | null = cursorParam
        ? parseReportCursor(cursorParam)
        : null;
      const page = await supplierActivityReport(
        tx,
        ssr.tenantId,
        range,
        cursor ?? undefined
      );
      supplierReport = page.suppliers;
      supplierReportNext = page.nextCursor;
    }

    if (view === "reconciliation" && wantsReconcile) {
      reconciliation = await reconcileDocuments(
        tx,
        ssr.tenantId,
        documentId || null
      );
    }

    return {
      view,
      maySuppliers: Boolean(maySuppliers),
      mayDocuments: Boolean(mayDocuments),
      mayPolicy: Boolean(mayPolicy),
      mayReports: Boolean(mayReports),
      mayReconcile: Boolean(mayReconcile),
      mayLocations,
      locations,
      locationsComplete,
      includeDeleted,
      suppliers,
      suppliersNext,
      supplier,
      identifiers,
      documents,
      documentsNext,
      document,
      pickerSuppliers,
      pickerComplete,
      threshold,
      receiving,
      supplierReport,
      supplierReportNext,
      reconciliation,
      canCreateSupplier,
      canUpdateSupplier,
      canDeleteSupplier,
      canRestoreSupplier,
      canRevealIdentifier,
      canCreateDocument,
      canSubmitDocument,
      canFinaliseDocument,
      canCancelDocument,
      canReverseDocument,
      canConfigurePolicy
    };
  },
  onError: (error) => {
    logAdminPageError(
      "admin/procurement.astro: failed to load the procurement screen",
      error,
      { correlationId: Astro.locals.correlationId }
    );
  }
});

const canRead = screen.state !== "denied";
const loadError = screen.state === "error";
const data = screen.state === "allowed" ? screen.data : null;

const view: View = data?.view ?? "suppliers";
const locations: StockLocation[] = data?.locations ?? [];
const locationById = new Map(
  locations.map((location) => [location.id, location])
);
const mayLocations = data?.mayLocations ?? false;

function locationLabel(id: string): string {
  const location = locationById.get(id);
  return location ? `${location.name} (${location.code})` : id.slice(0, 8);
}

const VIEW_LABEL: Record<View, string> = {
  suppliers: t("Suppliers"),
  documents: t("Documents"),
  policy: t("Approval policy"),
  reports: t("Reports"),
  reconciliation: t("Reconciliation")
};
const viewAllowed: Record<View, boolean> = {
  suppliers: data?.maySuppliers ?? false,
  documents: data?.mayDocuments ?? false,
  policy: data?.mayPolicy ?? false,
  reports: data?.mayReports ?? false,
  reconciliation: data?.mayReconcile ?? false
};

/** A same-page link that keeps the active filters, so paging does not drop them. */
function pageUrl(overrides: Record<string, string | null>): string {
  const params = new URLSearchParams();
  const base: Record<string, string> = {
    view,
    ...(supplierStatusFilter ? { supplierStatus: supplierStatusFilter } : {}),
    ...(data?.includeDeleted ? { includeDeleted: "1" } : {}),
    ...(modeFilter ? { mode: modeFilter } : {}),
    ...(documentStatusFilter ? { status: documentStatusFilter } : {}),
    ...(fromDate ? { from: fromDate } : {}),
    ...(toDate ? { to: toDate } : {})
  };
  for (const [key, value] of Object.entries({ ...base, ...overrides })) {
    if (value !== null && value !== "") params.set(key, value);
  }
  return `/admin/procurement?${params.toString()}`;
}

const activeLocations = locations.filter(
  (location) => location.status === "active"
);
// A select only when it is complete AND offers something: an empty `required`
// select could never be submitted, so zero active locations falls back to the id
// input, as does a truncated list.
const locationPicker =
  mayLocations &&
  (data?.locationsComplete ?? false) &&
  activeLocations.length > 0;
const document_ = data?.document ?? null;
const supplier_ = data?.supplier ?? null;
const detailMissing =
  (view === "documents" && documentId !== "" && document_ === null) ||
  (view === "suppliers" && supplierId !== "" && supplier_ === null);
const today = new Date().toISOString().slice(0, 10);
---

<AdminLayout
  title={t("Procurement")}
  description={t(
    "Suppliers, receiving, supplier returns, requisitions and location transfers over the stock ledger. A document moves no stock until it is finalised, and finalising posts its movements through the ledger: nothing here edits a balance, and a mistake is corrected by reversing the document."
  )}
>
  {!canRead && (
    <p class="state-notice fade-in-up" id="procurement-denied">
      {t("You do not have permission to view procurement.")}
    </p>
  )}

  {canRead && loadError && (
    <p class="state-notice fade-in-up" id="procurement-load-error">
      {t("Could not load procurement. Please try again.")}
    </p>
  )}

  {canRead && !loadError && data && (
    <>
      <p
        id="procurement-action-error"
        class="state-notice"
        role="alert"
        hidden
        data-msg-forbidden={t("You do not have permission to do that.")}
        data-msg-validation={t("Check the values you entered and try again.")}
        data-msg-conflict={t(
          "That conflicts with the current state. Reload the page and try again."
        )}
        data-msg-vendor-code={t(
          "A supplier with that vendor code already exists."
        )}
        data-msg-supplier-open={t(
          "That supplier still has draft or submitted documents. Finalise or cancel them first."
        )}
        data-msg-supplier-deleted={t(
          "That supplier is deleted. Restore it before editing."
        )}
        data-msg-supplier-unavailable={t(
          "That supplier is inactive, blocked or deleted and cannot take part in a document."
        )}
        data-msg-supplier-not-found={t("That supplier does not exist.")}
        data-msg-location-not-found={t(
          "That stock location does not exist in this organisation."
        )}
        data-msg-invalid-state={t(
          "The document is no longer in a state that allows that. Reload the page."
        )}
        data-msg-insufficient={t(
          "Not enough stock, and the negative-stock policy forbids going below zero. Nothing was posted."
        )}
        data-msg-unit={t(
          "An item is stocked in a different unit at that location. Nothing was posted."
        )}
        data-msg-inactive={t(
          "A stock location is inactive. Reactivate it before posting."
        )}
        data-msg-approval-pending={t(
          "The document is waiting for approval and cannot be finalised yet."
        )}
        data-msg-approval-rejected={t(
          "The approval workflow rejected this document. Cancel it instead."
        )}
        data-msg-approval-missing={t(
          "This document needs approval, but no workflow named procurement.document_approval is published. Nothing was submitted."
        )}
        data-msg-duplicate-reference={t(
          "A live document already uses that external reference for this supplier."
        )}
        data-msg-actor={t("This action must be performed by a tenant user.")}
        data-msg-not-found={t("Not found. Reload the page.")}
        data-msg-generic={t("Could not save that. Please try again.")}
      />

      <nav class="admin-segmented" aria-label={t("Procurement sections")}>
        {VIEWS.filter((candidate) => viewAllowed[candidate]).map(
          (candidate) => (
            <a
              class="admin-segmented-option"
              aria-current={candidate === view ? "page" : undefined}
              href={`/admin/procurement?view=${candidate}`}
            >
              {VIEW_LABEL[candidate]}
            </a>
          )
        )}
      </nav>

      {detailMissing && (
        <p class="state-notice" id="procurement-detail-missing" role="status">
          {view === "documents"
            ? t("That document does not exist, or you cannot read it.")
            : t("That supplier does not exist or has been deleted.")}{" "}
          <a href={`/admin/procurement?view=${view}`}>
            {t("Back to the list")}
          </a>
        </p>
      )}

      {/* ------------------------------------------------------------ SUPPLIERS */}
      {view === "suppliers" && !supplier_ && !detailMissing && (
        <section
          class="fade-in-up"
          aria-labelledby="procurement-suppliers-heading"
        >
          <h2 id="procurement-suppliers-heading">{t("Suppliers")}</h2>

          <form class="admin-create-form" method="get" role="search">
            <input type="hidden" name="view" value="suppliers" />
            <p class="form-legend">{t("Filter")}</p>
            <label for="suppliers-status">
              {t("Status")}
              <select id="suppliers-status" name="supplierStatus">
                <option value="">{t("All statuses")}</option>
                {SUPPLIER_STATUSES.map((status) => (
                  <option
                    value={status}
                    selected={status === supplierStatusFilter}
                  >
                    {SUPPLIER_STATUS_LABEL[status]}
                  </option>
                ))}
              </select>
            </label>
            {data.canRestoreSupplier && (
              <label for="suppliers-deleted" class="checkbox-label">
                <input
                  id="suppliers-deleted"
                  name="includeDeleted"
                  type="checkbox"
                  value="1"
                  checked={data.includeDeleted}
                />
                {t("Show deleted suppliers")}
              </label>
            )}
            <button type="submit" class="module-toggle">
              {t("Apply filter")}
            </button>
            <a class="btn-inline" href="/admin/procurement?view=suppliers">
              {t("Clear filter")}
            </a>
          </form>

          {data.canCreateSupplier && (
            <section aria-labelledby="procurement-supplier-add-heading">
              <h3 id="procurement-supplier-add-heading">
                {t("Register a supplier")}
              </h3>
              <form id="supplier-form" class="admin-create-form">
                <label for="supplier-code">
                  {t("Vendor code")}
                  <input
                    id="supplier-code"
                    name="vendorCode"
                    type="text"
                    required
                    maxlength="64"
                    pattern="[A-Za-z0-9][A-Za-z0-9_.\-]*"
                    autocomplete="off"
                  />
                </label>
                <p class="page-description">
                  {t(
                    "Letters, digits, dots, underscores and hyphens. Unique per organisation, ignoring case."
                  )}
                </p>
                <label for="supplier-name">
                  {t("Name")}
                  <input
                    id="supplier-name"
                    name="name"
                    type="text"
                    required
                    maxlength="200"
                  />
                </label>
                <label for="supplier-status">
                  {t("Status")}
                  <select id="supplier-status" name="status">
                    {SUPPLIER_STATUSES.map((status) => (
                      <option value={status}>
                        {SUPPLIER_STATUS_LABEL[status]}
                      </option>
                    ))}
                  </select>
                </label>
                <label for="supplier-categories">
                  {t("Categories")}
                  <input
                    id="supplier-categories"
                    name="categories"
                    type="text"
                    autocomplete="off"
                  />
                </label>
                <label for="supplier-tags">
                  {t("Tags")}
                  <input
                    id="supplier-tags"
                    name="tags"
                    type="text"
                    autocomplete="off"
                  />
                </label>
                <p class="page-description">
                  {t(
                    "Separate categories and tags with commas. Lower-case letters, digits, dots, underscores and hyphens."
                  )}
                </p>
                <button id="supplier-submit" type="submit">
                  {t("Register supplier")}
                </button>
              </form>
            </section>
