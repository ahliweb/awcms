    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
  }

  .card p {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  .site-footer {
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--sp-5);
    border-top: 1px solid var(--color-border);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  .site-footer a,
  .hero__note a {
    color: var(--color-primary);
  }

  @media (prefers-reduced-motion: reduce) {
